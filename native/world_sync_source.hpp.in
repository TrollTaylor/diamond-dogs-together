#pragma once
// World sync (lua/coop/world_*.lua, docs/world-sync-protocol.md): spliced in
// this order right after partner_sync_source. Each file is one do ... end
// block of at most 32000 bytes; CMakeLists.txt emits a file over 16000 bytes
// as two adjacent raw literals (the MSVC limit applies to each literal).
