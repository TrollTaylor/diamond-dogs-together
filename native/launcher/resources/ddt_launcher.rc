// Resources of DiamondDogsTogether.exe: the app icon, the emblem shown in the
// window, and the version block. The .ico and .png are generated from
// docs/readme/logo.png by tools/launcher/make_launcher_assets.py.
#include <windows.h>
#include "ddt_launcher_resource.h"
#include "ddt_launcher_version.h"

IDI_DDT_APP ICON "ddt_launcher.ico"
IDR_DDT_LOGO RCDATA "ddt_logo.png"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION DDT_VERSION_MAJOR,DDT_VERSION_MINOR,DDT_VERSION_PATCH,0
 PRODUCTVERSION DDT_VERSION_MAJOR,DDT_VERSION_MINOR,DDT_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Diamond Dogs Together"
            VALUE "FileDescription", "Diamond Dogs Together"
            VALUE "FileVersion", DDT_VERSION_STRING
            VALUE "InternalName", "DiamondDogsTogether"
            VALUE "LegalCopyright", "A fan-made co-op mod; not affiliated with Konami."
            VALUE "OriginalFilename", "DiamondDogsTogether.exe"
            VALUE "ProductName", "Diamond Dogs Together"
            VALUE "ProductVersion", DDT_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
