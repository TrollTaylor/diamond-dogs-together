# Local two-window activation journal. Windows PowerShell 5.1 compatible.
Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'
Import-Module (Join-Path $PSScriptRoot 'FriendCommon.psm1') -DisableNameChecking
$script:LocalActivationNames = @('lab.ini', 'coop.ini', 'link-secret.txt', 'script-observe.enabled')
$script:LocalUtf8 = New-Object Text.UTF8Encoding $false

function Get-LocalCoopBytesHash {
    param([Parameter(Mandatory)][AllowEmptyCollection()][byte[]]$Bytes)
    $sha = [Security.Cryptography.SHA256]::Create()
    try { return ([BitConverter]::ToString($sha.ComputeHash($Bytes))).Replace('-', '') } finally { $sha.Dispose() }
}

function New-LocalCoopLabIniText {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][ValidateSet('host', 'guest')][string]$Role,
        [Parameter(Mandatory)][string]$SaveDir,
        [ValidateRange(1024, 65535)][int]$HostPort = 47820,
        [ValidateRange(1024, 65535)][int]$GuestPort = 47821,
        [ValidateSet('native', 'clips')][string]$Partner = 'native',
        [ValidateRange(0, 3)][int]$World = 3,
        [string]$HostSteamId = 'learn'
    )
    $problem = Get-FriendSaveDirProblem -Path $SaveDir
    if ($problem) { throw $problem }
    if ($HostPort -eq $GuestPort -or $HostPort -in @(47810, 47811, 47899) -or $GuestPort -in @(47810, 47811, 47899)) {
        throw 'Local partner ports must differ and must not reuse the local lab or closed master ports.'
    }
    if ($HostSteamId -cne 'learn' -and !(Test-FriendIndividualSteamId64 $HostSteamId)) { throw 'Invalid host Steam identity for the local guest.' }
    if ($HostSteamId -ceq '76561202255233008') { throw 'The real host and local guest must have different identities.' }
    $guest = $Role -eq 'guest'
    $lines = New-Object Collections.Generic.List[string]
    foreach ($line in @('# Generated by the MGS Co-op local two-window test', 'enabled=1', 'mode=lab', ('role=' + $Role), 'loopback=1',
        ('self_steamid=' + $(if ($guest) { '76561202255233008' } else { 'real' })), ('peer_steamid=' + $(if ($guest) { $HostSteamId } else { '76561202255233008' })),
        ('listen_port=' + $(if ($guest) { 47811 } else { 47810 })), ('peer_port=' + $(if ($guest) { 47810 } else { 47811 })),
        ('save_dir=' + $SaveDir), ('xinput=' + $(if ($guest) { '0' } else { 'none' })), 'join_trigger=0', 'net=1', 'net_bind=loopback',
        ('net_listen_port=' + $(if ($guest) { $GuestPort } else { $HostPort })),
        ('net_peer_port=' + $(if ($guest) { $HostPort } else { $GuestPort })), 'partner_interp=auto')) { $lines.Add($line) }
    if ($guest) { $lines.Add('self_name=Guest'); $lines.Add('mutex_suffix=-guest') }
    $defaults = Get-PlayPartnerDefaults
    foreach ($key in $defaults.Keys) { $lines.Add($key + '=' + $defaults[$key]) }
    $lines.Add('partner_input_send=1')
    # The native profile expands identically in lab and play, including POINT/HIDE.
    if ($Partner -eq 'native') { $lines.Add('partner_native_profile=gun') }
    if ($World -gt 0) { $lines.Add('world=' + $World) }
    return ($lines.ToArray() -join "`n") + "`n"
}

function Get-LocalCoopRoot {
    param([Parameter(Mandatory)][string]$Path)
    if (![IO.Path]::IsPathRooted($Path)) { throw 'A local game root must be an absolute path.' }
    $root = [IO.Path]::GetFullPath($Path).TrimEnd('\', '/')
    if ($root -match '^[A-Za-z]:$' -or !(Test-Path -LiteralPath $root -PathType Container)) { throw "Not an existing game folder: $root" }
    Assert-NoReparsePoint -Path $root
    if (!(Test-Path -LiteralPath (Join-Path $root 'mgsvtpp.exe') -PathType Leaf)) { throw "No mgsvtpp.exe in $root" }
    Assert-NoReparsePoint -Path (Join-Path $root 'mgs-coop') -StopAt $root
    if (!(Test-Path -LiteralPath (Join-Path $root 'mgs-coop') -PathType Container)) { throw "No owned mod folder in $root" }
    return $root
}

function Assert-LocalCoopSession {
    param([Parameter(Mandatory)]$Session)
    if ([int](Get-FriendProperty $Session 'v' 0) -ne 1 -or [string](Get-FriendProperty $Session 'product' '') -cne 'mgs-coop-local-session') { throw 'Invalid local test session.' }
    $id = [string](Get-FriendProperty $Session 'id' '')
    if ($id -cnotmatch '^[a-f0-9]{32}$') { throw 'Invalid local test session identity.' }
    $hostRoot = Get-LocalCoopRoot -Path ([string](Get-FriendProperty $Session 'host_root' ''))
    $guestRoot = Get-LocalCoopRoot -Path ([string](Get-FriendProperty $Session 'guest_root' ''))
    if ($hostRoot.Equals($guestRoot, [StringComparison]::OrdinalIgnoreCase) -or (Test-PathInside -Child $hostRoot -Parent $guestRoot) -or (Test-PathInside -Child $guestRoot -Parent $hostRoot)) { throw 'Local game folders must be distinct and must not contain each other.' }
    $run = [IO.Path]::GetFullPath([string](Get-FriendProperty $Session 'run_directory' '')).TrimEnd('\', '/')
    $expected = Join-Path (Join-Path (Join-Path $hostRoot 'mgs-coop') 'local-test-runs') $id
    if (!$run.Equals($expected, [StringComparison]::OrdinalIgnoreCase)) { throw 'Local test run directory escaped its owned location.' }
    Assert-NoReparsePoint -Path $run -StopAt $hostRoot
    $marker = Join-Path $run '.local-test-owner'
    if (!(Test-Path -LiteralPath $marker -PathType Leaf) -or [IO.File]::ReadAllText($marker) -cne $id) { throw 'Local test run ownership marker is missing or changed.' }
    Assert-NoReparsePoint -Path $marker -StopAt $hostRoot
    $pointerRoles = @{}
    foreach ($pointer in @(Get-FriendProperty $Session 'pointers' @())) {
        $role = [string](Get-FriendProperty $pointer 'role' '')
        if ($role -cnotin @('host', 'guest') -or $pointerRoles.ContainsKey($role) -or [string](Get-FriendProperty $pointer 'sha256' '') -cnotmatch '^[A-F0-9]{64}$') { throw 'Invalid local ownership pointer record.' }
        $pointerRoles[$role] = $true
    }
    $names = @{}
    foreach ($entry in @(Get-FriendProperty $Session 'files' @())) {
        $role = [string](Get-FriendProperty $entry 'role' '')
        $name = [string](Get-FriendProperty $entry 'name' '')
        if ($role -cnotin @('host', 'guest') -or $name -cnotin $script:LocalActivationNames -or $names.ContainsKey($role + '/' + $name)) { throw 'Invalid or repeated local activation record.' }
        $names[$role + '/' + $name] = $true
        if ([string](Get-FriendProperty $entry 'written_sha256' '') -cnotmatch '^[A-F0-9]{64}$') { throw 'Invalid local activation hash.' }
        if ([bool](Get-FriendProperty $entry 'original_exists' $false)) {
            $original = [Convert]::FromBase64String([string](Get-FriendProperty $entry 'original_base64' ''))
            if ($original.Length -gt 262144 -or (Get-LocalCoopBytesHash -Bytes $original) -cne [string](Get-FriendProperty $entry 'original_sha256' '')) { throw 'Local activation backup hash does not match.' }
        }
    }
}

function Write-LocalCoopAtomicBytes {
    param([Parameter(Mandatory)][string]$Path, [Parameter(Mandatory)][AllowEmptyCollection()][byte[]]$Bytes, [Parameter(Mandatory)][string]$StopAt, [switch]$RequireAbsent)
    Assert-NoReparsePoint -Path $Path -StopAt $StopAt
    if (Test-Path -LiteralPath $Path -PathType Container) { throw "A directory occupies the target file: $Path" }
    $temporary = $Path + '.local-' + [Guid]::NewGuid().ToString('N') + '.tmp'
    Assert-NoReparsePoint -Path $temporary -StopAt $StopAt
    try {
        $stream = New-Object IO.FileStream($temporary, [IO.FileMode]::CreateNew, [IO.FileAccess]::Write, [IO.FileShare]::None)
        try { $stream.Write($Bytes, 0, $Bytes.Length); $stream.Flush($true) } finally { $stream.Dispose() }
        Assert-NoReparsePoint -Path $Path -StopAt $StopAt
        if (!$RequireAbsent -and (Test-Path -LiteralPath $Path -PathType Leaf)) { [IO.File]::Replace($temporary, $Path, [System.Management.Automation.Language.NullString]::Value) }
        else { [IO.File]::Move($temporary, $Path) }
    } finally {
        if (Test-Path -LiteralPath $temporary -PathType Leaf) { Remove-Item -LiteralPath $temporary -Force }
    }
}

function Save-LocalCoopSession {
    [CmdletBinding()]
    param([Parameter(Mandatory)]$Session)
    Assert-LocalCoopSession -Session $Session
    $bytes = $script:LocalUtf8.GetBytes(($Session | ConvertTo-Json -Depth 8) + "`n")
    if ($bytes.Length -gt 2097152) { throw 'Local session journal is too large.' }
    Write-LocalCoopAtomicBytes -Path (Join-Path $Session.run_directory 'session.json') -Bytes $bytes -StopAt $Session.host_root
}

function New-LocalCoopSessionCore {
    [CmdletBinding()]
    param([Parameter(Mandatory)][string]$HostRoot, [Parameter(Mandatory)][string]$GuestRoot, [Parameter(Mandatory)][string]$RunDirectory)
    $hostRoot = Get-LocalCoopRoot -Path $HostRoot
    $guestRoot = Get-LocalCoopRoot -Path $GuestRoot
    if ($hostRoot.Equals($guestRoot, [StringComparison]::OrdinalIgnoreCase) -or (Test-PathInside -Child $hostRoot -Parent $guestRoot) -or (Test-PathInside -Child $guestRoot -Parent $hostRoot)) { throw 'Local game folders must be distinct and must not contain each other.' }
    $run = [IO.Path]::GetFullPath($RunDirectory).TrimEnd('\', '/')
    $id = Split-Path -Leaf $run
    $expected = Join-Path (Join-Path (Join-Path $hostRoot 'mgs-coop') 'local-test-runs') $id
    if ($id -cnotmatch '^[a-f0-9]{32}$' -or !$run.Equals($expected, [StringComparison]::OrdinalIgnoreCase)) { throw 'Use an owned GUID directory under host mgs-coop\local-test-runs.' }
    Assert-NoReparsePoint -Path $run -StopAt $hostRoot
    if (Test-Path -LiteralPath $run) { throw 'The local run directory already exists.' }
    foreach ($root in @($hostRoot, $guestRoot)) {
        if (@(Get-GameProcessInDirectory -Directory $root).Count) { throw 'Quit both game copies before changing their local test settings.' }
    }
    $started = Get-CoopProcessStartUtc -Id $PID
    if (!$started) { throw 'Cannot record the local launcher process identity.' }
    foreach ($root in @($hostRoot, $guestRoot)) {
        $pointer = Join-Path (Join-Path $root 'mgs-coop') 'local-test-session.json'
        Assert-NoReparsePoint -Path $pointer -StopAt $root
        if (Test-Path -LiteralPath $pointer) { throw 'A local-test ownership pointer already exists. Recover that session before starting another.' }
    }
    $null = New-Item -ItemType Directory -Path $run
    [IO.File]::WriteAllText((Join-Path $run '.local-test-owner'), $id, [Text.Encoding]::ASCII)
    $session = [pscustomobject][ordered]@{ v = 1; product = 'mgs-coop-local-session'; id = $id; state = 'prepared'; host_root = $hostRoot; guest_root = $guestRoot
        run_directory = $run; launcher_pid = $PID; launcher_start_utc = $started; created_utc = [DateTime]::UtcNow.ToString('o'); watchdog_pid = 0; watchdog_start_utc = ''; files = @(); pointers = @() }
    Save-LocalCoopSession -Session $session
    foreach ($role in @('host', 'guest')) {
        $root = if ($role -eq 'host') { $hostRoot } else { $guestRoot }
        $pointer = Join-Path (Join-Path $root 'mgs-coop') 'local-test-session.json'
        $pointerText = ([pscustomobject][ordered]@{ v = 1; product = 'mgs-coop-local-pointer'; id = $id; host_root = $hostRoot; guest_root = $guestRoot; run_directory = $run } | ConvertTo-Json) + [char]10
        $pointerBytes = $script:LocalUtf8.GetBytes($pointerText)
        $session.pointers = @($session.pointers) + @([pscustomobject]@{ role = $role; sha256 = (Get-LocalCoopBytesHash -Bytes $pointerBytes) })
        Save-LocalCoopSession -Session $session
        if (Test-Path -LiteralPath $pointer) { throw 'A local-test ownership pointer appeared during preparation; it was left alone.' }
        Write-LocalCoopAtomicBytes -Path $pointer -Bytes $pointerBytes -StopAt $root -RequireAbsent
    }
    return $session
}

function Read-LocalCoopSession {
    [CmdletBinding()]
    param([Parameter(Mandatory)][string]$RunDirectory)
    $run = [IO.Path]::GetFullPath($RunDirectory).TrimEnd('\', '/')
    Assert-NoReparsePoint -Path $run
    $path = Join-Path $run 'session.json'
    Assert-NoReparsePoint -Path $path
    if (!(Test-Path -LiteralPath $path -PathType Leaf)) { return $null }
    if ((Get-Item -LiteralPath $path).Length -gt 2097152) { throw 'Local session journal is too large.' }
    $session = [IO.File]::ReadAllText($path, $script:LocalUtf8) | ConvertFrom-Json
    # PowerShell 7 converts ISO JSON timestamps to DateTime by default.
    # Keep process identity timestamps as UTC strings for both host versions.
    foreach ($name in @('launcher_start_utc', 'watchdog_start_utc', 'created_utc')) {
        $value = Get-FriendProperty $session $name ''
        if ($value -is [DateTime]) { $session.$name = $value.ToUniversalTime().ToString('o') }
    }
    Assert-LocalCoopSession -Session $session
    if (!$run.Equals([string]$session.run_directory, [StringComparison]::OrdinalIgnoreCase)) { throw 'Local journal names another run.' }
    return $session
}

function Test-LocalCoopSessionOwnerLive {
    [CmdletBinding()]
    param([Parameter(Mandatory)]$Session)
    Assert-LocalCoopSession -Session $Session
    $id = [int](Get-FriendProperty $Session 'launcher_pid' 0)
    $started = [string](Get-FriendProperty $Session 'launcher_start_utc' '')
    if ($id -le 0 -or !$started) { return $true }
    if (Test-CoopProcessAlive -Id $id -StartUtc $started) { return $true }
    return Test-CoopProcessAlive -Id ([int](Get-FriendProperty $Session 'watchdog_pid' 0)) -StartUtc ([string](Get-FriendProperty $Session 'watchdog_start_utc' ''))
}

function Get-LocalCoopActivationPath {
    param($Session, [string]$Role, [string]$Name)
    $root = if ($Role -eq 'host') { [string]$Session.host_root } else { [string]$Session.guest_root }
    $path = Join-Path (Join-Path $root 'mgs-coop') $Name
    Assert-NoReparsePoint -Path $path -StopAt $root
    if (Test-Path -LiteralPath $path -PathType Container) { throw "A directory occupies the target file: $path" }
    return $path
}

function Set-LocalCoopSessionFileCore {
    [CmdletBinding()]
    param([Parameter(Mandatory)]$Session, [Parameter(Mandatory)][ValidateSet('host', 'guest')][string]$Role,
        [Parameter(Mandatory)][ValidateSet('lab.ini', 'coop.ini', 'link-secret.txt', 'script-observe.enabled')][string]$Name,
        [Parameter(Mandatory)][AllowEmptyCollection()][byte[]]$Bytes)
    Assert-LocalCoopSession -Session $Session
    if ([string]$Session.state -cnotin @('prepared', 'active')) { throw 'The local session is not open for activation.' }
    if ($Bytes.Length -gt 262144) { throw 'Local activation file is too large.' }
    foreach ($root in @($Session.host_root, $Session.guest_root)) {
        if (@(Get-GameProcessInDirectory -Directory $root).Count) { throw 'Quit both game copies before changing their local test settings.' }
    }
    if (@($Session.files | Where-Object { $_.role -ceq $Role -and $_.name -ceq $Name }).Count) { throw 'This local activation file is already journaled.' }
    $path = Get-LocalCoopActivationPath -Session $Session -Role $Role -Name $Name
    $exists = Test-Path -LiteralPath $path -PathType Leaf
    $original = [byte[]]@()
    if ($exists) {
        if ((Get-Item -LiteralPath $path).Length -gt 262144) { throw 'Existing activation file is too large to back up.' }
        $original = [IO.File]::ReadAllBytes($path)
    }
    $entry = [pscustomobject][ordered]@{ role = $Role; name = $Name; original_exists = [bool]$exists
        original_base64 = [Convert]::ToBase64String($original); original_sha256 = (Get-LocalCoopBytesHash -Bytes $original)
        written_sha256 = (Get-LocalCoopBytesHash -Bytes $Bytes); phase = 'planned' }
    $Session.files = @($Session.files) + @($entry)
    $Session.state = 'active'
    # This durable journal precedes every activation mutation, including the marker.
    Save-LocalCoopSession -Session $Session
    $stillExists = Test-Path -LiteralPath $path -PathType Leaf
    if ($stillExists -ne $exists -or ($stillExists -and (Get-Sha256 -Path $path) -cne $entry.original_sha256)) { throw 'An activation file changed before it could be replaced; it was left alone.' }
    Write-LocalCoopAtomicBytes -Path $path -Bytes $Bytes -StopAt $(if ($Role -eq 'host') { $Session.host_root } else { $Session.guest_root })
    if ((Get-Sha256 -Path $path) -cne $entry.written_sha256) { throw 'Local activation file did not match its recorded hash.' }
    $entry.phase = 'written'
    Save-LocalCoopSession -Session $Session
}

function Restore-LocalCoopSessionCore {
    [CmdletBinding()]
    param([Parameter(Mandatory)]$Session)
    Assert-LocalCoopSession -Session $Session
    foreach ($root in @($Session.host_root, $Session.guest_root)) {
        if (@(Get-GameProcessInDirectory -Directory $root).Count) { throw 'Local settings stay active until both game copies have exited.' }
    }
    # Validate every restoration target before the first file mutation.
    foreach ($entry in @($Session.files)) { $null = Get-LocalCoopActivationPath -Session $Session -Role $entry.role -Name $entry.name }
    foreach ($pointer in @(Get-FriendProperty $Session 'pointers' @())) {
        $root = if ($pointer.role -ceq 'host') { $Session.host_root } else { $Session.guest_root }
        Assert-NoReparsePoint -Path (Join-Path (Join-Path $root 'mgs-coop') 'local-test-session.json') -StopAt $root
    }
    $result = [pscustomobject]@{ Restored = @(); Removed = @(); Kept = @(); State = 'off' }
    # Disable the role markers first, then restore the remaining settings.
    $ordered = @($Session.files | Sort-Object @{ Expression = { if ($_.name -ceq 'script-observe.enabled') { 0 } else { 1 } } })
    foreach ($entry in $ordered) {
        $path = Get-LocalCoopActivationPath -Session $Session -Role $entry.role -Name $entry.name
        $key = $entry.role + '/' + $entry.name
        $exists = Test-Path -LiteralPath $path -PathType Leaf
        $current = if ($exists) { Get-Sha256 -Path $path } else { '' }
        $alreadyOriginal = ($entry.original_exists -and $exists -and $current -ceq $entry.original_sha256) -or (!$entry.original_exists -and !$exists)
        if ($alreadyOriginal) { $entry.phase = 'restored'; continue }
        if (!$exists -or $current -cne $entry.written_sha256) { $result.Kept += @($key); $entry.phase = 'kept'; continue }
        if ($entry.original_exists) {
            $bytes = [Convert]::FromBase64String([string]$entry.original_base64)
            Write-LocalCoopAtomicBytes -Path $path -Bytes $bytes -StopAt $(if ($entry.role -eq 'host') { $Session.host_root } else { $Session.guest_root })
            if ((Get-Sha256 -Path $path) -cne $entry.original_sha256) { throw 'Restored local activation backup did not match its hash.' }
            $result.Restored += @($key)
        } else {
            Remove-Item -LiteralPath $path -Force
            $result.Removed += @($key)
        }
        $entry.phase = 'restored'
        Save-LocalCoopSession -Session $Session
    }
    if (!$result.Kept.Count) {
        foreach ($pointerEntry in @(Get-FriendProperty $Session 'pointers' @())) {
            $root = if ($pointerEntry.role -ceq 'host') { $Session.host_root } else { $Session.guest_root }
            $path = Join-Path (Join-Path $root 'mgs-coop') 'local-test-session.json'
            Assert-NoReparsePoint -Path $path -StopAt $root
            if (!(Test-Path -LiteralPath $path)) { continue }
            if (!(Test-Path -LiteralPath $path -PathType Leaf) -or (Get-Sha256 -Path $path) -cne $pointerEntry.sha256) {
                $result.Kept += @($pointerEntry.role + '/local-test-session.json'); continue
            }
            Remove-Item -LiteralPath $path -Force
            $result.Removed += @($pointerEntry.role + '/local-test-session.json')
        }
    }
    $Session.state = if ($result.Kept.Count) { 'partial' } else { 'off' }
    $result.State = $Session.state
    Save-LocalCoopSession -Session $Session
    return $result
}

function Invoke-LocalCoopRecovery {
    [CmdletBinding()]
    param([Parameter(Mandatory)][string]$HostRoot)
    $root = Get-LocalCoopRoot -Path $HostRoot
    $sessions = @{}
    $pointerPath = Join-Path (Join-Path $root 'mgs-coop') 'local-test-session.json'
    Assert-NoReparsePoint -Path $pointerPath -StopAt $root
    if (Test-Path -LiteralPath $pointerPath) {
        if (!(Test-Path -LiteralPath $pointerPath -PathType Leaf) -or (Get-Item -LiteralPath $pointerPath).Length -gt 16384) { throw 'Unknown local-test ownership pointer; it was left alone.' }
        $pointer = [IO.File]::ReadAllText($pointerPath, $script:LocalUtf8) | ConvertFrom-Json
        if ([int](Get-FriendProperty $pointer 'v' 0) -ne 1 -or [string](Get-FriendProperty $pointer 'product' '') -cne 'mgs-coop-local-pointer') { throw 'Unknown local-test ownership pointer; it was left alone.' }
        $session = Read-LocalCoopSession -RunDirectory ([string](Get-FriendProperty $pointer 'run_directory' ''))
        if (!$session -or [string]$pointer.id -cne [string]$session.id -or [string]$pointer.host_root -cne [string]$session.host_root -or [string]$pointer.guest_root -cne [string]$session.guest_root) { throw 'Local ownership pointer does not match its journal.' }
        $role = if ($root.Equals([string]$session.host_root, [StringComparison]::OrdinalIgnoreCase)) { 'host' } elseif ($root.Equals([string]$session.guest_root, [StringComparison]::OrdinalIgnoreCase)) { 'guest' } else { throw 'Local pointer names unrelated game folders.' }
        $entry = @($session.pointers | Where-Object { $_.role -ceq $role })
        if ($entry.Count -ne 1 -or (Get-Sha256 -Path $pointerPath) -cne [string]$entry[0].sha256) { throw 'Local ownership pointer changed; it was left alone.' }
        $sessions[$session.id] = $session
    }
    $runsRoot = Join-Path (Join-Path $root 'mgs-coop') 'local-test-runs'
    Assert-NoReparsePoint -Path $runsRoot -StopAt $root
    if (Test-Path -LiteralPath $runsRoot -PathType Container) {
        foreach ($directory in @(Get-ChildItem -LiteralPath $runsRoot -Directory -Force)) {
            if ($directory.Name -cnotmatch '^[a-f0-9]{32}$') { continue }
            Assert-NoReparsePoint -Path $directory.FullName -StopAt $root
            $session = Read-LocalCoopSession -RunDirectory $directory.FullName
            if (!$session) { continue }
            if (!$root.Equals([string]$session.host_root, [StringComparison]::OrdinalIgnoreCase)) { throw 'Local run journal names another host.' }
            if ([string]$session.state -cne 'off') { $sessions[$session.id] = $session }
        }
    }
    foreach ($session in @($sessions.Values)) {
        if ([string]$session.state -ceq 'off') { continue }
        if (Test-LocalCoopSessionOwnerLive -Session $session) { throw 'Another local two-window launcher or cleanup helper is still active. Close it before starting co-op.' }
        foreach ($gameRoot in @($session.host_root, $session.guest_root)) {
            if (@(Get-GameProcessInDirectory -Directory $gameRoot).Count) { throw 'A local two-window game is still running. Quit both game copies before starting co-op.' }
        }
    }
    $recovered = @()
    foreach ($session in @($sessions.Values)) {
        $result = Restore-LocalCoopSession -Session $session
        if ($result.Kept.Count) { throw ('Local test settings changed after activation and were left alone: ' + ($result.Kept -join ', ') + '. Restore those files before starting another session.') }
        $recovered += @($session.id)
    }
    return [pscustomobject]@{ Recovered = $recovered }
}

function Get-LocalCoopLaunchEvidence {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][ValidateSet('host', 'guest')][string]$Role,
        [AllowNull()][AllowEmptyString()][string]$EarlyLog = '',
        [AllowNull()][AllowEmptyString()][string]$SteamLog = '',
        [AllowNull()][AllowEmptyString()][string]$ObserverLog = '',
        [Parameter(Mandatory)][string]$SaveDir,
        [switch]$Final
    )
    $base = Get-CoopLaunchEvidence -EarlyLog $EarlyLog -SteamLog $SteamLog -ObserverLog $ObserverLog -SaveDir $SaveDir
    $missing = New-Object Collections.Generic.List[string]
    $problems = New-Object Collections.Generic.List[string]
    $reason = ''
    if ($base.Saves -cne 'ok') {
        if ($base.Saves -ceq 'missing') { $missing.Add('saves=redirected to the local save copy') }
        else { $reason = 'saves_' + $base.Saves }
    }
    if ($base.Master -cne 'ok') {
        if ($base.Master -ceq 'missing') { $missing.Add('master_server=redirected to the closed local port') }
        else { $reason = 'master_redirect_failed' }
    }
    $starts = [regex]::Matches([string]$EarlyLog, '(?m)^early=start;[^\r\n]*')
    if (!$starts.Count) { $missing.Add('early=start; lab=1; role=' + $Role) }
    foreach ($line in $starts) {
        if ($line.Value -cnotmatch '(?:^|; )lab=1(?:;|$)' -or $line.Value -cnotmatch ('(?:^|; )role=' + $Role + '(?:;|$)')) { $reason = 'lab_role_mismatch' }
    }
    if ($Role -ceq 'guest') {
        $mutexes = [regex]::Matches([string]$EarlyLog, '(?m)^mutex=(renamed|unchanged);?[^\r\n]*')
        if (!$mutexes.Count) { $missing.Add('mutex=renamed; suffix=-guest') }
        foreach ($line in $mutexes) { if ($line.Value -cnotmatch '^mutex=renamed; suffix=-guest(?:;|$)') { $reason = 'guest_mutex_mismatch' } }
        $identities = [regex]::Matches([string]$EarlyLog, '(?m)^identity=(fake|real);?[^\r\n]*')
        if (!$identities.Count) { $missing.Add('identity=fake; steamid=76561202255233008') }
        foreach ($line in $identities) { if ($line.Value -cnotmatch '^identity=fake; steamid=76561202255233008(?:;|$)') { $reason = 'guest_identity_mismatch' } }
    }
    # Safety is established at startup, before user-controlled title and Continue.
    # Partner/mission observer lines are deliberately not required here.
    if ($Final -and $missing.Count -and !$reason) { $reason = 'startup_evidence_missing' }
    if ($reason) { $problems.Add($reason) }
    $state = if ($reason) { 'unsafe' } elseif ($missing.Count) { 'pending' } else { 'ok' }
    return [pscustomobject]@{ State = $state; Reason = $reason; Missing = $missing.ToArray(); Problems = $problems.ToArray(); Saves = $base.Saves; Master = $base.Master }
}

function Use-LocalCoopRoots {
    param([string[]]$Roots, [scriptblock]$Operation)
    $sorted = @($Roots | Sort-Object)
    $first = $sorted[0]
    $second = $sorted[1]
    Use-CoopPlayMutex -GameRoot $first -Script {
        Use-CoopPlayMutex -GameRoot $second -Script $Operation
    }
}

function New-LocalCoopSession {
    [CmdletBinding()]
    param([Parameter(Mandatory)][string]$HostRoot, [Parameter(Mandatory)][string]$GuestRoot, [Parameter(Mandatory)][string]$RunDirectory)
    $hostChecked = Get-LocalCoopRoot $HostRoot
    $guestChecked = Get-LocalCoopRoot $GuestRoot
    if ($hostChecked.Equals($guestChecked, [StringComparison]::OrdinalIgnoreCase)) { throw 'Local game folders must be distinct.' }
    Use-LocalCoopRoots -Roots @($hostChecked, $guestChecked) -Operation {
        New-LocalCoopSessionCore -HostRoot $hostChecked -GuestRoot $guestChecked -RunDirectory $RunDirectory
    }
}

function Set-LocalCoopSessionFile {
    [CmdletBinding()]
    param([Parameter(Mandatory)]$Session, [Parameter(Mandatory)][ValidateSet('host', 'guest')][string]$Role,
        [Parameter(Mandatory)][ValidateSet('lab.ini', 'coop.ini', 'link-secret.txt', 'script-observe.enabled')][string]$Name,
        [Parameter(Mandatory)][AllowEmptyCollection()][byte[]]$Bytes)
    Assert-LocalCoopSession -Session $Session
    Use-LocalCoopRoots -Roots @($Session.host_root, $Session.guest_root) -Operation {
        Set-LocalCoopSessionFileCore -Session $Session -Role $Role -Name $Name -Bytes $Bytes
    }
}

function Restore-LocalCoopSession {
    [CmdletBinding()]
    param([Parameter(Mandatory)]$Session)
    Assert-LocalCoopSession -Session $Session
    Use-LocalCoopRoots -Roots @($Session.host_root, $Session.guest_root) -Operation {
        Restore-LocalCoopSessionCore -Session $Session
    }
}

