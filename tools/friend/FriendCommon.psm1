# Helpers for the two-PC friend package (tools/friend/*.ps1): install,
# Play-Coop (Host/Join over our own Steam or UDP link, docs/two-pc-play.md), uninstall
# and log collection.
#
# Runs under Windows PowerShell 5.1 (the friend's PC; the .bat files start
# powershell.exe) and PowerShell 7 (CTest). Keep this file ASCII-only and
# 5.1-compatible: no ternary/null-coalescing operators, no
# [IO.Path]::GetRelativePath, no three-argument Join-Path.
#
# Imports tools/CoopPlay.psm1 (packaged next to this file in scripts\) and
# re-exports it, so the friend scripts import only this module.
# Pure helpers are unit tested by tests/friend_package_tests.ps1. Nothing here
# launches the game or Steam, and no helper writes below Steam\userdata.
# Firewall and router changes happen only in the opt-in steps of Play-Coop.ps1
# and Uninstall-Coop.ps1, never here.
Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'
$coopPlayModule = Join-Path $PSScriptRoot 'CoopPlay.psm1'
if (!(Test-Path -LiteralPath $coopPlayModule -PathType Leaf)) { $coopPlayModule = Join-Path (Split-Path -Parent $PSScriptRoot) 'CoopPlay.psm1' }
Import-Module $coopPlayModule -Force -DisableNameChecking

$script:FriendHeader = '# Generated by the MGS Co-op friend-test installer (Install-Coop.ps1)'
$script:Characters = @('default', 'quiet', 'dd_male', 'dd_female', 'snake', 'avatar', 'ocelot')
$script:Utf8NoBom = New-Object Text.UTF8Encoding $false
# native/include/mgscoop/save_redirect.hpp kMaxSaveDirChars (UTF-8 bytes).
$script:MaxSaveDirBytes = 213
# The files a Play-Coop session writes, in activation order (spec 9.2 step 4).
$script:PlayFiles = @('lab.ini', 'link-secret.txt', 'coop.ini', 'script-observe.enabled')

# ---------------------------------------------------------------------------
# Identity (redaction only: the play route never asks for a SteamID)
# ---------------------------------------------------------------------------

function Test-FriendIndividualSteamId64 {
    # Individual, public-universe desktop account (same rule as set-session-mode.ps1).
    param([AllowNull()][AllowEmptyString()][string]$Value)
    if ($null -eq $Value -or $Value -cnotmatch '^[0-9]{17}$') { return $false }
    [UInt64]$id = 0
    if (![UInt64]::TryParse($Value, [ref]$id)) { return $false }
    return (($id -shr 32) -eq 0x01100001) -and (($id % [UInt64]4294967296) -ne 0)
}

# ---------------------------------------------------------------------------
# Roles, characters and configuration text (pure)
# ---------------------------------------------------------------------------

function Get-FriendCharacters { return $script:Characters }

function Get-FriendDefaultCharacter {
    # docs/characters.md: Player 1 (host) keeps the game default, Player 2 is Quiet.
    param([Parameter(Mandatory)][ValidateSet('Host', 'Join')][string]$Role)
    if ($Role -eq 'Host') { return 'default' }
    return 'quiet'
}

function Test-FriendCharacter {
    param([AllowNull()][AllowEmptyString()][string]$Value)
    return [bool]$Value -and ($script:Characters -ccontains $Value)
}

function Get-FriendSaveDirProblem {
    # Pure: $null when $Path is acceptable as lab.ini save_dir (native rules).
    param([AllowNull()][AllowEmptyString()][string]$Path)
    if (!$Path) { return 'save_dir is empty.' }
    if ($Path -cnotmatch '^[A-Za-z]:\\' -and !$Path.StartsWith('\\')) { return 'save_dir must be an absolute path.' }
    if ($Path -match '[\x00-\x1f\x7f]') { return 'save_dir contains control characters.' }
    if ($Path -ne $Path.Trim()) { return 'save_dir has leading or trailing blanks.' }
    $bytes = $script:Utf8NoBom.GetByteCount($Path.TrimEnd('\', '/'))
    if ($bytes -gt $script:MaxSaveDirBytes) { return ('The game folder path is too long for the save copy (' + $bytes + ' bytes; the limit is ' + $script:MaxSaveDirBytes + ').') }
    return $null
}

# Longest paths the friend scripts and the owned installer create below
# <game> (besides the save backup files, which depend on Steam's file names).
# Windows PowerShell 5.1 (.NET Framework) fails on paths of 260 characters or
# more unless long paths are enabled in Windows, which is off by default.
$script:MaxFilePathChars = 259
$script:MaxDirectoryPathChars = 247
$script:FixedPathSuffixes = @(
    # tools/package-install.ps1 ReplaceFile temp file of the runtime archive.
    ('\mgs-coop\mgs-coop-player-runtime.dat.mgs-coop-' + ('0' * 32) + '.tmp'),
    # tools/package-install.ps1 prepared ownership record.
    ('\mgs-coop\install-backups\' + ('0' * 32) + '\new-manifest.json'),
    # Write-FriendTextFile temp file of friend-install.json.
    ('\mgs-coop\friend-install.json.' + ('0' * 32) + '.tmp'),
    # Rename-FriendFile / before-friend copies.
    '\mgs-coop\script-observe.enabled.disabled-00000000-000000-99',
    '\mgs-coop\friend-install.json.uninstalled-00000000-000000-99',
    '\mgs-coop\script-observe.enabled.before-friend-00000000-000000'
)

function Get-FriendPathLengthProblem {
    # Pure: $null when every path the installer creates below $GameRoot stays
    # within the classic Windows limits, otherwise a sentence for the player.
    # $SaveFiles: the real save files' paths relative to userdata\<account>
    # ('287700/local/TPP_GAME_DATA0'), copied to real-save-backups\<time>\files.
    param([Parameter(Mandatory)][string]$GameRoot, [string[]]$SaveFiles = @())
    $root = $GameRoot.TrimEnd('\', '/')
    $longestFile = 0
    $longestDir = 0
    $candidates = New-Object Collections.Generic.List[string]
    foreach ($s in $script:FixedPathSuffixes) { $candidates.Add($root + $s) }
    foreach ($f in @($SaveFiles | Where-Object { $_ })) {
        $relative = $f.Replace('/', '\').TrimStart('\')
        # real-save-backups\<stamp>-<n>\files\<relative>, and the save copy.
        $candidates.Add($root + '\mgs-coop\real-save-backups\00000000-000000-99\files\' + $relative)
        $candidates.Add($root + '\mgs-coop\coop-saves-replaced\00000000-000000\remote-00000000\' + (Split-Path -Leaf $relative))
    }
    foreach ($c in $candidates) {
        if ($c.Length -gt $longestFile) { $longestFile = $c.Length }
        $parent = $c.Substring(0, $c.LastIndexOf('\'))
        if ($parent.Length -gt $longestDir) { $longestDir = $parent.Length }
    }
    if ($longestFile -gt $script:MaxFilePathChars -or $longestDir -gt $script:MaxDirectoryPathChars) {
        return ('The game folder path is too long (' + $root.Length + ' characters): the installer''s backup files would need paths of ' +
            $longestFile + ' characters, and Windows limits paths to ' + $script:MaxFilePathChars + '.')
    }
    return $null
}

function Test-FriendGeneratedText {
    # True for a lab.ini/coop.ini written by the earlier online friend-test installer.
    param([AllowNull()][AllowEmptyString()][string]$Text)
    return [bool]$Text -and $Text.TrimStart([char]0xFEFF).StartsWith($script:FriendHeader, [StringComparison]::Ordinal)
}

function Test-IniHasKey {
    # Pure: true when a non-comment key=value line sets $Key (any value).
    param([AllowNull()][AllowEmptyString()][string]$Text, [Parameter(Mandatory)][string]$Key)
    if (!$Text) { return $false }
    foreach ($line in ($Text.TrimStart([char]0xFEFF) -split "`n")) {
        $t = $line.Trim()
        if (!$t -or $t.StartsWith('#') -or $t.StartsWith(';')) { continue }
        $i = $t.IndexOf('=')
        if ($i -gt 0 -and $t.Substring(0, $i).Trim() -ceq $Key) { return $true }
    }
    return $false
}

function ConvertTo-FriendRoleName {
    # Pure: script-observe.enabled marker text -> host / join / diagnostic / play / other / none.
    param([AllowNull()][AllowEmptyString()][string]$Marker)
    if ($null -eq $Marker -or !$Marker.Trim()) { return 'none' }
    switch -CaseSensitive ($Marker.Trim()) {
        'host-v3' { return 'host' }
        'client-v1' { return 'join' }
        'client-check-v1' { return 'diagnostic' }
        'offline-v1' { return 'play' }
        default { return 'other' }
    }
}

function Get-FriendOnlineArchiveReason {
    # Pure: why a managed file left by the abandoned online route is archived
    # as *.online-old-<time> on install (never restored), or $null to keep it.
    # $Name: lab.ini, coop.ini, client-host.txt, script-observe.enabled or
    # link-secret.txt (never online: always set aside).
    param([Parameter(Mandatory)][string]$Name, [AllowNull()][AllowEmptyString()][string]$Text)
    if ($null -eq $Text) { return $null }
    switch ($Name) {
        'client-host.txt' { return 'online join target' }
        'link-secret.txt' { return $null }
        'script-observe.enabled' {
            if ($Text.Trim() -cin @('host-v3', 'client-v1')) { return 'online role marker' }
            return $null
        }
        default {
            if (Test-FriendGeneratedText $Text) { return 'online friend-test configuration' }
            return $null
        }
    }
}

# ---------------------------------------------------------------------------
# Redaction and log excerpts (pure)
# ---------------------------------------------------------------------------

function Hide-FriendSensitiveText {
    # Masks every SteamID64 except its last 4 digits (7656119XXXXXX1234), Steam
    # userdata account folder numbers and the Windows user name in profile paths.
    param([AllowNull()][AllowEmptyString()][string]$Text)
    if (!$Text) { return $Text }
    $out = [regex]::Replace($Text, '(?<![0-9])[0-9]{17}(?![0-9])', {
            param($m)
            $v = $m.Value
            if ($v.StartsWith('7656119', [StringComparison]::Ordinal) -or (Test-FriendIndividualSteamId64 $v)) { return $v.Substring(0, 7) + 'XXXXXX' + $v.Substring(13) }
            return $v
        })
    $out = [regex]::Replace($out, '(?i)(userdata[\\/]+)[0-9]+', '${1}<account>')
    $out = [regex]::Replace($out, '(?i)\b([A-Z]:[\\/]+Users[\\/]+)[^\\/\r\n"'';]+', '${1}<user>')
    return $out
}

function Hide-CoopNetworkText {
    # Masks join codes (MGS1 LAN/VPN and MGS2 Steam online; any case, with
    # blanks or dashes, with the @host / @SteamID part), invite connect strings
    # (+mgscoop_join <code>) and public IPv4 addresses in address contexts only
    # (peer=, net_peer_addr=, "peer":", host=), so version numbers such as
    # 1.0.15.4 stay readable. Masked SteamIDs (steam:...1234) stay as they are.
    param([AllowNull()][AllowEmptyString()][string]$Text)
    if (!$Text) { return $Text }
    $out = [regex]::Replace($Text, '(?i)MGS([12])[\s-]*(?:[0-9A-Z][\s-]*){22}(?:@\S+)?', { param($m) 'MGS' + $m.Groups[1].Value + '-<redacted>' })
    $out = [regex]::Replace($out, '\+mgscoop_join\s+\S+', '+mgscoop_join <redacted>')
    $out = [regex]::Replace($out, '(?<pre>\bpeer=|\bnet_peer_addr=|"peer"\s*:\s*"|\bhost=)(?<ip>[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3})(?![0-9.])', {
            param($m)
            return $m.Groups['pre'].Value + (Get-CoopMaskedAddress $m.Groups['ip'].Value)
        })
    return $out
}

function Get-TextFromLastMarker {
    # Pure: $Text from the start of the last line that contains $Marker
    # (the whole text when the marker is absent).
    param([AllowNull()][AllowEmptyString()][string]$Text, [Parameter(Mandatory)][string]$Marker)
    if (!$Text) { return '' }
    $at = $Text.LastIndexOf($Marker, [StringComparison]::Ordinal)
    if ($at -lt 0) { return $Text }
    $lineStart = $Text.LastIndexOf("`n", $at, [StringComparison]::Ordinal)
    if ($lineStart -lt 0) { return $Text }
    return $Text.Substring($lineStart + 1)
}

function Limit-TextTail {
    # Pure: at most $MaxChars characters from the end of $Text, starting on a
    # line boundary, with a note when something was dropped.
    param([AllowNull()][AllowEmptyString()][string]$Text, [Parameter(Mandatory)][int]$MaxChars)
    if (!$Text) { return '' }
    if ($Text.Length -le $MaxChars) { return $Text }
    $start = $Text.Length - $MaxChars
    $newline = $Text.IndexOf("`n", $start, [StringComparison]::Ordinal)
    if ($newline -ge 0 -and $newline + 1 -lt $Text.Length) { $start = $newline + 1 }
    return ('[... ' + $start + ' earlier characters omitted ...]' + "`n" + $Text.Substring($start))
}

function Read-FriendFileTail {
    # Up to the last $MaxBytes of a file, opened with FileShare.ReadWrite|Delete
    # (the game may still be writing). '' when absent or unreadable.
    param([Parameter(Mandatory)][string]$Path, [int]$MaxBytes = 262144)
    if (!(Test-Path -LiteralPath $Path -PathType Leaf)) { return '' }
    try {
        $stream = New-Object IO.FileStream($Path, [IO.FileMode]::Open, [IO.FileAccess]::Read, ([IO.FileShare]::ReadWrite -bor [IO.FileShare]::Delete))
        try {
            $length = $stream.Length
            $count = [int][Math]::Min([Int64]$MaxBytes, $length)
            $offset = $length - $count
            if ($count -le 0) { return '' }
            $null = $stream.Seek($offset, [IO.SeekOrigin]::Begin)
            $buffer = New-Object byte[] $count
            $read = 0
            while ($read -lt $count) {
                $n = $stream.Read($buffer, $read, $count - $read)
                if ($n -le 0) { break }
                $read += $n
            }
            $text = [Text.Encoding]::UTF8.GetString($buffer, 0, $read)
            if ($offset -gt 0) {
                $newline = $text.IndexOf("`n")
                if ($newline -ge 0) { $text = $text.Substring($newline + 1) }
                $text = '[... ' + $offset + ' earlier bytes omitted ...]' + "`n" + $text
            }
            return $text
        } finally { $stream.Dispose() }
    } catch { return '' }
}

# ---------------------------------------------------------------------------
# Game folder discovery
# ---------------------------------------------------------------------------

function Get-SteamLibraryPathsFromVdf {
    # Pure: library roots listed in steamapps/libraryfolders.vdf (current
    # "path" entries and the older numbered entries), unescaped.
    param([AllowNull()][AllowEmptyString()][string]$Text)
    $result = New-Object Collections.Generic.List[string]
    if (!$Text) { return @() }
    foreach ($m in [regex]::Matches($Text, '(?m)^\s*"(path|[0-9]+)"\s+"((?:[^"\\]|\\.)*)"')) {
        $value = $m.Groups[2].Value.Replace('\\', '\')
        if ($value -cnotmatch '^[A-Za-z]:\\' -and !$value.StartsWith('\\')) { continue }
        $value = $value.TrimEnd('\', '/')
        if (!($result | Where-Object { $_.Equals($value, [StringComparison]::OrdinalIgnoreCase) })) { $result.Add($value) }
    }
    return $result.ToArray()
}

function Get-MgsvInstallDir {
    # Pure: "installdir" of appmanifest_287700.acf text, else MGS_TPP.
    param([AllowNull()][AllowEmptyString()][string]$ManifestText)
    if ($ManifestText) {
        $m = [regex]::Match($ManifestText, '(?m)^\s*"installdir"\s+"([^"\\/:*?<>|]+)"')
        if ($m.Success) { return $m.Groups[1].Value }
    }
    return 'MGS_TPP'
}

function Find-MgsvGameFolders {
    # Folders that contain mgsvtpp.exe: explicit candidates first, then
    # <library>\steamapps\common\<installdir> for every Steam library of every
    # Steam root. Read-only.
    param([string[]]$SteamRoots = @(), [string[]]$Candidates = @())
    $found = New-Object Collections.Generic.List[string]
    $add = {
        param($folder)
        if (!$folder) { return }
        try { $full = [IO.Path]::GetFullPath($folder).TrimEnd('\', '/') } catch { return }
        if (!(Test-Path -LiteralPath (Join-Path $full 'mgsvtpp.exe') -PathType Leaf)) { return }
        foreach ($existing in $found) { if ($existing.Equals($full, [StringComparison]::OrdinalIgnoreCase)) { return } }
        $found.Add($full)
    }
    foreach ($c in @($Candidates)) { & $add $c }
    foreach ($root in @($SteamRoots | Where-Object { $_ })) {
        $libraries = New-Object Collections.Generic.List[string]
        $libraries.Add([IO.Path]::GetFullPath($root).TrimEnd('\', '/'))
        foreach ($vdf in @((Join-Path $root 'steamapps\libraryfolders.vdf'), (Join-Path $root 'config\libraryfolders.vdf'))) {
            if (Test-Path -LiteralPath $vdf -PathType Leaf) {
                foreach ($lib in (Get-SteamLibraryPathsFromVdf ([IO.File]::ReadAllText($vdf)))) { $libraries.Add($lib) }
            }
        }
        foreach ($lib in $libraries) {
            $manifest = Join-Path $lib 'steamapps\appmanifest_287700.acf'
            $dir = 'MGS_TPP'
            if (Test-Path -LiteralPath $manifest -PathType Leaf) { $dir = Get-MgsvInstallDir ([IO.File]::ReadAllText($manifest)) }
            & $add (Join-Path (Join-Path $lib 'steamapps\common') $dir)
        }
    }
    return $found.ToArray()
}

function Get-RegistryMgsvCandidates {
    # Install locations Steam registered for app 287700, plus the Steam roots
    # (registry, read-only). Returns @{ SteamRoots; Candidates }.
    $roots = New-Object Collections.Generic.List[string]
    $candidates = New-Object Collections.Generic.List[string]
    foreach ($key in @('HKCU:\Software\Valve\Steam', 'HKLM:\SOFTWARE\WOW6432Node\Valve\Steam', 'HKLM:\SOFTWARE\Valve\Steam')) {
        $item = Get-ItemProperty -LiteralPath $key -ErrorAction SilentlyContinue
        if (!$item) { continue }
        foreach ($name in @('SteamPath', 'InstallPath')) {
            if ($item.PSObject.Properties.Name -contains $name -and $item.$name) { $roots.Add(([string]$item.$name).Replace('/', '\')) }
        }
    }
    foreach ($key in @('HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Steam App 287700',
            'HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\Steam App 287700')) {
        $item = Get-ItemProperty -LiteralPath $key -ErrorAction SilentlyContinue
        if ($item -and $item.PSObject.Properties.Name -contains 'InstallLocation' -and $item.InstallLocation) { $candidates.Add([string]$item.InstallLocation) }
    }
    return [pscustomobject]@{ SteamRoots = $roots.ToArray(); Candidates = $candidates.ToArray() }
}

# ---------------------------------------------------------------------------
# Console interaction and small file helpers
# ---------------------------------------------------------------------------

function Test-FriendInteractive {
    # True for a console a person can type into (a double-clicked .bat), never
    # with -NonInteractive or redirected input (scripts and tests).
    param([switch]$NonInteractive)
    if ($NonInteractive) { return $false }
    if (@([Environment]::GetCommandLineArgs() | Where-Object { $_ -match '^-NonI' }).Count) { return $false }
    # tests/friend_package_tests.ps1 only: answer the prompts through redirected input.
    if ($env:MGS_COOP_TEST_INTERACTIVE -eq '1') { return $true }
    try { return [Environment]::UserInteractive -and ![Console]::IsInputRedirected } catch { return $false }
}

function Write-FriendTextFile {
    # Atomic UTF-8 (no BOM) / LF text write next to the target.
    param([Parameter(Mandatory)][string]$Path, [Parameter(Mandatory)][AllowEmptyString()][string]$Text)
    $temp = $Path + '.' + [Guid]::NewGuid().ToString('N') + '.tmp'
    [IO.File]::WriteAllText($temp, $Text, $script:Utf8NoBom)
    try {
        if (Test-Path -LiteralPath $Path) { [IO.File]::Replace($temp, $Path, [NullString]::Value) }
        else { [IO.File]::Move($temp, $Path) }
    } finally { if (Test-Path -LiteralPath $temp) { Remove-Item -LiteralPath $temp -Force } }
}

function Get-FriendStamp { return [DateTime]::Now.ToString('yyyyMMdd-HHmmss') }

function New-FriendZip {
    # ZIP of the files directly in $SourceDirectory under "<FolderName>/" with
    # forward-slash entry names (Windows PowerShell 5.1 Compress-Archive writes
    # backslashes, which non-Windows unzip tools keep in the file names).
    param([Parameter(Mandatory)][string]$SourceDirectory, [Parameter(Mandatory)][string]$Destination, [Parameter(Mandatory)][string]$FolderName)
    if (Test-Path -LiteralPath $Destination) { throw "Already exists: $Destination" }
    Add-Type -AssemblyName System.IO.Compression
    Add-Type -AssemblyName System.IO.Compression.FileSystem
    $stream = New-Object IO.FileStream($Destination, [IO.FileMode]::CreateNew, [IO.FileAccess]::ReadWrite, [IO.FileShare]::None)
    try {
        $zip = New-Object IO.Compression.ZipArchive($stream, [IO.Compression.ZipArchiveMode]::Create, $false)
        try {
            foreach ($file in @(Get-ChildItem -LiteralPath $SourceDirectory -File | Sort-Object Name)) {
                $null = [IO.Compression.ZipFileExtensions]::CreateEntryFromFile($zip, $file.FullName, ($FolderName + '/' + $file.Name), [IO.Compression.CompressionLevel]::Optimal)
            }
        } finally { $zip.Dispose() }
    } finally { $stream.Dispose() }
}

function Get-FriendFileSha256 {
    param([Parameter(Mandatory)][string]$Path)
    if (!(Test-Path -LiteralPath $Path -PathType Leaf)) { return '' }
    return (Get-FileHash -LiteralPath $Path -Algorithm SHA256).Hash
}

function Rename-FriendFile {
    # Renames $Path to "<name>.<Suffix>-<stamp>" (a unique name); returns the new
    # path, or $null when $Path does not exist. Never deletes anything.
    param([Parameter(Mandatory)][string]$Path, [Parameter(Mandatory)][string]$Suffix, [Parameter(Mandatory)][string]$Stamp)
    if (!(Test-Path -LiteralPath $Path -PathType Leaf)) { return $null }
    $target = $Path + '.' + $Suffix + '-' + $Stamp
    $n = 1
    while (Test-Path -LiteralPath $target) { $target = $Path + '.' + $Suffix + '-' + $Stamp + '-' + $n; $n++ }
    Move-Item -LiteralPath $Path -Destination $target
    return $target
}

function Read-FriendJson {
    # Parsed JSON file, or $null when absent or invalid. Always read as UTF-8:
    # Windows PowerShell 5.1's Get-Content decodes BOM-less files with the ANSI
    # code page, which garbles non-ASCII folder names (C:\Jeux Video with an
    # accent, C:\Users\<name with umlaut>).
    param([Parameter(Mandatory)][string]$Path)
    if (!(Test-Path -LiteralPath $Path -PathType Leaf)) { return $null }
    try { return ([IO.File]::ReadAllText($Path, [Text.Encoding]::UTF8) | ConvertFrom-Json) } catch { return $null }
}

function Get-FriendSaveBaselines {
    # The save backups to compare the real saves with: the FIRST backup of each
    # Steam save folder (manifest source_root) among $Backups, in install order.
    # A reinstall takes a new backup, but the state before the friend test stays
    # the reference. Returns @{ Baselines = @(@{Backup; SourceRoot}); Missing = @(dirs) }.
    param([object[]]$Backups = @())
    $seen = @{}
    $baselines = New-Object Collections.Generic.List[object]
    $missing = New-Object Collections.Generic.List[string]
    foreach ($b in @($Backups)) {
        $dir = [string]$b
        if (!$dir) { continue }
        $manifest = Read-FriendJson (Join-Path $dir 'manifest.json')
        $root = [string](Get-FriendProperty $manifest 'source_root' '')
        if (!$root) { $missing.Add($dir); continue }
        $key = $root.TrimEnd('\', '/').ToUpperInvariant()
        if ($seen.ContainsKey($key)) { continue }
        $seen[$key] = $true
        $baselines.Add([pscustomobject]@{ Backup = $dir; SourceRoot = $root })
    }
    return [pscustomobject]@{ Baselines = $baselines.ToArray(); Missing = $missing.ToArray() }
}

function Get-FriendProperty {
    # StrictMode-safe optional property read.
    param($Object, [Parameter(Mandatory)][string]$Name, $Default = $null)
    if ($null -eq $Object) { return $Default }
    $p = $Object.PSObject.Properties[$Name]
    if ($p -and $null -ne $p.Value) { return $p.Value }
    return $Default
}

# ---------------------------------------------------------------------------
# Play sessions: ownership record, cleanup, watchdog (docs/two-pc-play.md)
# ---------------------------------------------------------------------------

function Get-CoopPlayFileNames { return $script:PlayFiles }

function Get-CoopPlayMutexName {
    # Pure: Local\mgs-coop-play-<first 16 hex of SHA-256(upper-case game root)>.
    param([Parameter(Mandatory)][string]$GameRoot)
    $root = [IO.Path]::GetFullPath($GameRoot).TrimEnd('\', '/').ToUpperInvariant()
    $hash = Get-CoopTextSha256 -Bytes ($script:Utf8NoBom.GetBytes($root))
    return 'Local\mgs-coop-play-' + $hash.Substring(0, 16)
}

function Read-CoopPlaySession {
    # play-session.json (no secrets) or $null.
    param([Parameter(Mandatory)][string]$GameRoot)
    $s = Read-FriendJson (Get-InstancePaths -GameDirectory $GameRoot).PlaySession
    if (!$s -or [int](Get-FriendProperty $s 'v' 0) -ne 2) { return $null }
    return $s
}

function Save-CoopPlaySession {
    param([Parameter(Mandatory)][string]$GameRoot, [Parameter(Mandatory)]$Session)
    $paths = Get-InstancePaths -GameDirectory $GameRoot
    Assert-NoReparsePoint -Path $paths.PlaySession -StopAt $paths.Game
    Write-FriendTextFile -Path $paths.PlaySession -Text (($Session | ConvertTo-Json -Depth 6) + "`n")
}

function ConvertTo-CoopSessionTable {
    # A session object read from JSON -> ordered hashtable (to update and save).
    param([Parameter(Mandatory)]$Session)
    $t = [ordered]@{}
    foreach ($p in $Session.PSObject.Properties) { $t[$p.Name] = $p.Value }
    return $t
}

function Use-CoopPlayMutex {
    # Runs $Script while holding the per-folder play mutex (30 s wait).
    param([Parameter(Mandatory)][string]$GameRoot, [Parameter(Mandatory)][scriptblock]$Script)
    $mutex = New-Object Threading.Mutex($false, (Get-CoopPlayMutexName -GameRoot $GameRoot))
    $locked = $false
    try {
        try { $locked = $mutex.WaitOne(30000) } catch [Threading.AbandonedMutexException] { $locked = $true }
        if (!$locked) { throw 'Another Play-Coop window is changing this game folder right now; try again in a moment.' }
        & $Script
    } finally {
        if ($locked) { $mutex.ReleaseMutex() }
        $mutex.Dispose()
    }
}

function Test-CoopProcessAlive {
    # True when process $Id runs and (with $StartUtc) started at that time (1 s).
    param([int]$Id, [string]$StartUtc = '')
    if ($Id -le 0) { return $false }
    $p = Get-Process -Id $Id -ErrorAction SilentlyContinue
    if (!$p) { return $false }
    if (!$StartUtc) { return $true }
    $want = [DateTime]::MinValue
    if (![DateTime]::TryParse($StartUtc, [Globalization.CultureInfo]::InvariantCulture, [Globalization.DateTimeStyles]::RoundtripKind, [ref]$want)) { return $true }
    try { return [Math]::Abs(($p.StartTime.ToUniversalTime() - $want.ToUniversalTime()).TotalSeconds) -lt 1 } catch { return $true }
}

function Test-CoopPlaySessionLive {
    # True when play-session.json is active and its launcher window (pid and
    # start time) or its helper still runs: that session is in use, not a
    # leftover of a crash. The calling process itself never counts.
    param([Parameter(Mandatory)][string]$GameRoot)
    $s = Read-CoopPlaySession -GameRoot $GameRoot
    if (!$s -or [string](Get-FriendProperty $s 'state' '') -ne 'active') { return $false }
    $launcher = [int](Get-FriendProperty $s 'launcher_pid' 0)
    if ($launcher -ne $PID -and (Test-CoopProcessAlive -Id $launcher -StartUtc ([string](Get-FriendProperty $s 'launcher_start_utc' '')))) { return $true }
    $watchdog = [int](Get-FriendProperty $s 'watchdog_pid' 0)
    return ($watchdog -ne $PID -and (Test-CoopProcessAlive -Id $watchdog -StartUtc ([string](Get-FriendProperty $s 'watchdog_start_utc' ''))))
}

function Get-CoopProcessStartUtc {
    # The start time of process $Id as round-trip UTC text, or '' (gone or denied).
    param([int]$Id)
    if ($Id -le 0) { return '' }
    try { return (Get-Process -Id $Id -ErrorAction Stop).StartTime.ToUniversalTime().ToString('o') } catch { return '' }
}

function Invoke-CoopUpnp {
    # Opt-in UPnP port mapping through Windows' HNetCfg.NATUPnP, in a background
    # job with a timeout (discovery can block for many seconds). Returns
    # @{ Ok; Message; ExternalAddress }. -Remove deletes the mapping.
    param([Parameter(Mandatory)][int]$Port, [string]$LanAddress = '', [switch]$Remove, [int]$TimeoutSec = 15)
    $job = Start-Job -ScriptBlock {
        param($port, $lan, $remove)
        try {
            $nat = New-Object -ComObject HNetCfg.NATUPnP
            $maps = $nat.StaticPortMappingCollection
            if ($null -eq $maps) { return 'unavailable|' }
            if ($remove) { $maps.Remove($port, 'UDP'); return 'removed|' }
            $m = $maps.Add($port, 'UDP', $port, $lan, $true, 'mgs-coop')
            $ext = ''
            if ($m) { try { $ext = [string]$m.ExternalIPAddress } catch { $ext = '' } }
            return ('added|' + $ext)
        } catch { return ('error|' + $_.Exception.Message) }
    } -ArgumentList $Port, $LanAddress, ([bool]$Remove)
    try {
        if (!(Wait-Job -Job $job -Timeout $TimeoutSec)) { return [pscustomobject]@{ Ok = $false; Message = "no answer from the router within $TimeoutSec s"; ExternalAddress = '' } }
        $out = [string](@(Receive-Job -Job $job) | Select-Object -Last 1)
    } finally { Remove-Job -Job $job -Force -ErrorAction SilentlyContinue }
    $parts = $out.Split([char]'|', 2)
    $detail = ''
    if ($parts.Count -gt 1) { $detail = $parts[1] }
    switch ($parts[0]) {
        'added' { return [pscustomobject]@{ Ok = $true; Message = 'mapping added'; ExternalAddress = $detail } }
        'removed' { return [pscustomobject]@{ Ok = $true; Message = 'mapping removed'; ExternalAddress = '' } }
        'unavailable' { return [pscustomobject]@{ Ok = $false; Message = 'UPnP unavailable (the router does not offer it, or Windows network discovery is off)'; ExternalAddress = '' } }
        default { return [pscustomobject]@{ Ok = $false; Message = ('UPnP failed: ' + $detail); ExternalAddress = '' } }
    }
}

function Clear-CoopClipboardIfCode {
    # Clears the clipboard when it still holds the text whose SHA-256 is $Sha256.
    param([string]$Sha256 = '')
    if (!$Sha256) { return $false }
    try {
        $current = [string](Get-Clipboard -Raw -ErrorAction Stop)
        if (!$current) { return $false }
        if ((Get-CoopTextSha256 -Bytes ([Text.Encoding]::UTF8.GetBytes($current.TrimEnd("`r", "`n")))) -cne $Sha256) { return $false }
        Add-Type -AssemblyName System.Windows.Forms
        [Windows.Forms.Clipboard]::Clear()
        return $true
    } catch { return $false }
}

function Invoke-CoopPlayCleanup {
    # Deactivates a Play-Coop session in $GameRoot (spec 9.2 step 6). Idempotent
    # and serialized by the per-folder mutex. Deletes, in this order, the
    # marker, coop.ini, lab.ini and link-secret.txt, each only when its SHA-256
    # matches play-session.json (the marker only when it is exactly offline-v1),
    # then removes a recorded UPnP mapping, clears the clipboard if it still
    # holds the code, and sets the session state to off. A changed file is kept
    # and reported. Returns @{ Ran; Removed; Kept; Messages }.
    param([Parameter(Mandatory)][string]$GameRoot, [switch]$SkipUpnp)
    $result = [pscustomobject]@{ Ran = $false; Removed = @(); Kept = @(); Messages = @() }
    $paths = Get-InstancePaths -GameDirectory $GameRoot
    if (!(Test-Path -LiteralPath $paths.PlaySession -PathType Leaf)) { return $result }
    Use-CoopPlayMutex -GameRoot $GameRoot -Script {
        $session = Read-CoopPlaySession -GameRoot $GameRoot
        if (!$session -or [string](Get-FriendProperty $session 'state' '') -ne 'active') { return }
        $result.Ran = $true
        Assert-NoReparsePoint -Path $paths.Mod -StopAt $paths.Game
        $records = @{}
        foreach ($f in @(Get-FriendProperty $session 'files' @())) { $records[[string](Get-FriendProperty $f 'name' '')] = ([string](Get-FriendProperty $f 'sha256' '')).ToUpperInvariant() }
        foreach ($name in @('script-observe.enabled', 'coop.ini', 'lab.ini', 'link-secret.txt')) {
            if (!$records.ContainsKey($name)) { continue }
            $path = Join-Path $paths.Mod $name
            if (!(Test-Path -LiteralPath $path)) { continue }
            Assert-NoReparsePoint -Path $path -StopAt $paths.Game
            $bytes = [IO.File]::ReadAllBytes($path)
            $ours = (Get-CoopTextSha256 -Bytes $bytes) -ceq $records[$name]
            if ($name -eq 'script-observe.enabled' -and [Text.Encoding]::ASCII.GetString($bytes) -cne "offline-v1`n") { $ours = $false }
            if ($ours) {
                Remove-Item -LiteralPath $path -Force
                $result.Removed += @($name)
            } else {
                $result.Kept += @($name)
                $result.Messages += @("$name was changed after Play-Coop wrote it; it was left in place (delete it yourself if you do not need it).")
            }
        }
        $table = ConvertTo-CoopSessionTable -Session $session
        $upnp = Get-FriendProperty $session 'upnp' $null
        if ($upnp -and [bool](Get-FriendProperty $upnp 'added' $false) -and !$SkipUpnp) {
            $port = [int](Get-FriendProperty $upnp 'port' 0)
            $r = Invoke-CoopUpnp -Port $port -Remove
            $result.Messages += @("Router port mapping UDP ${port}: $($r.Message).")
            $table['upnp'] = [ordered]@{ added = $false; port = 0 }
        }
        if (Clear-CoopClipboardIfCode -Sha256 ([string](Get-FriendProperty $session 'clip_sha256' ''))) { $result.Messages += @('The join code was cleared from the clipboard.') }
        $table['state'] = 'off'
        $table['ended_utc'] = [DateTime]::UtcNow.ToString('o')
        Save-CoopPlaySession -GameRoot $GameRoot -Session $table
    }
    return $result
}

function Start-CoopWatchdog {
    # Starts "powershell.exe -WindowStyle Hidden -File Play-Coop.ps1 -Watch <session>"
    # detached from this console (Win32_Process.Create: no inherited handles,
    # survives closing the console window). Returns the process id (0 = failed).
    param([Parameter(Mandatory)][string]$ScriptPath, [Parameter(Mandatory)][string]$GameRoot, [Parameter(Mandatory)][string]$SessionId)
    $exe = Join-Path $env:SystemRoot 'System32\WindowsPowerShell\v1.0\powershell.exe'
    if (!(Test-Path -LiteralPath $exe -PathType Leaf)) { $exe = (Get-Process -Id $PID).Path }
    $command = '"' + $exe + '" -NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -File "' + $ScriptPath + '" -GameDirectory "' + $GameRoot + '" -Watch ' + $SessionId
    try {
        $startup = New-CimInstance -ClassName Win32_ProcessStartup -ClientOnly -Property @{ ShowWindow = [UInt16]0 }
        $r = Invoke-CimMethod -ClassName Win32_Process -MethodName Create -Arguments @{ CommandLine = $command; CurrentDirectory = $GameRoot; ProcessStartupInformation = $startup } -ErrorAction Stop
        if ([int]$r.ReturnValue -eq 0) { return [int]$r.ProcessId }
    } catch { }
    try {
        $p = Start-Process -FilePath $exe -ArgumentList @('-NoProfile', '-NonInteractive', '-ExecutionPolicy', 'Bypass', '-WindowStyle', 'Hidden', '-File', ('"' + $ScriptPath + '"'), '-GameDirectory', ('"' + $GameRoot + '"'), '-Watch', $SessionId) -WindowStyle Hidden -PassThru
        return [int]$p.Id
    } catch { return 0 }
}

# ---------------------------------------------------------------------------
# Firewall and network profile (read-only reports; changes only through the
# opt-in elevated command below)
# ---------------------------------------------------------------------------

function Get-CoopFirewallRows {
    # Read-only: inbound/outbound Windows Firewall rules that name $ExePath.
    param([Parameter(Mandatory)][string]$ExePath)
    $rows = New-Object Collections.Generic.List[object]
    try {
        foreach ($filter in @(Get-NetFirewallApplicationFilter -Program $ExePath -ErrorAction Stop)) {
            foreach ($rule in @($filter | Get-NetFirewallRule -ErrorAction SilentlyContinue)) {
                $rows.Add([pscustomobject]@{ Name = [string]$rule.Name; DisplayName = [string]$rule.DisplayName; Direction = [string]$rule.Direction
                        Action = [string]$rule.Action; Enabled = [string]$rule.Enabled; Profile = [string]$rule.Profile })
            }
        }
    } catch { }
    return $rows.ToArray()
}

function Get-CoopNetworkProfiles {
    # Read-only: the active network connection profiles (Public / Private / DomainAuthenticated).
    $rows = New-Object Collections.Generic.List[object]
    try {
        foreach ($p in @(Get-NetConnectionProfile -ErrorAction Stop)) {
            $rows.Add([pscustomobject]@{ Name = [string]$p.Name; Alias = [string]$p.InterfaceAlias; Category = [string]$p.NetworkCategory })
        }
    } catch { }
    return $rows.ToArray()
}

function Format-CoopFirewallReport {
    # Pure: report lines for Get-CoopFirewallRows / Get-CoopNetworkProfiles output.
    param([object[]]$Rules = @(), [object[]]$Profiles = @(), [int]$Port = 47830)
    $lines = New-Object Collections.Generic.List[string]
    $block = @($Rules | Where-Object { $_ -and $_.Direction -eq 'Inbound' -and $_.Action -eq 'Block' -and $_.Enabled -eq 'True' })
    $allow = @($Rules | Where-Object { $_ -and $_.Direction -eq 'Inbound' -and $_.Action -eq 'Allow' -and $_.Enabled -eq 'True' })
    foreach ($p in @($Profiles | Where-Object { $_ })) { $lines.Add("Network '$($p.Name)' ($($p.Alias)): $($p.Category)") }
    if (@($Profiles | Where-Object { $_ -and $_.Category -eq 'Public' }).Count) {
        $lines.Add('A Public network: the "Allow" button of the Windows Firewall prompt covers Private networks only.')
    }
    if (!$Rules -or @($Rules).Count -eq 0) { $lines.Add("No Windows Firewall rule names mgsvtpp.exe yet: Windows asks the first time the game opens UDP $Port.") }
    foreach ($r in $block) { $lines.Add("BLOCK rule for mgsvtpp.exe: '$($r.DisplayName)' (profiles $($r.Profile)). Block rules win over Allow rules.") }
    foreach ($r in $allow) { $lines.Add("Allow rule for mgsvtpp.exe: '$($r.DisplayName)' (profiles $($r.Profile)).") }
    return $lines.ToArray()
}

function ConvertTo-CoopPsLiteral {
    # Pure: a single-quoted PowerShell string literal.
    param([AllowEmptyString()][string]$Text)
    return "'" + $Text.Replace("'", "''") + "'"
}

function New-CoopFirewallScript {
    # Pure: the script the opt-in [F] step runs elevated (passed with
    # -EncodedCommand, so a quote in the game path cannot break or inject):
    # remove the listed Block rules (when the player agreed), then add an Allow
    # rule for UDP $Port and mgsvtpp.exe on every profile.
    param([Parameter(Mandatory)][int]$Port, [Parameter(Mandatory)][string]$ExePath, [string[]]$RemoveRuleNames = @(), [Parameter(Mandatory)][string]$DisplayName)
    $lines = New-Object Collections.Generic.List[string]
    $lines.Add('$ErrorActionPreference = ''Stop''')
    foreach ($n in @($RemoveRuleNames | Where-Object { $_ })) { $lines.Add('Remove-NetFirewallRule -Name ' + (ConvertTo-CoopPsLiteral $n)) }
    $lines.Add('Get-NetFirewallRule -DisplayName ' + (ConvertTo-CoopPsLiteral $DisplayName) + ' -ErrorAction SilentlyContinue | Remove-NetFirewallRule')
    $lines.Add('New-NetFirewallRule -DisplayName ' + (ConvertTo-CoopPsLiteral $DisplayName) + ' -Direction Inbound -Protocol UDP -LocalPort ' + $Port +
        ' -Program ' + (ConvertTo-CoopPsLiteral $ExePath) + ' -Action Allow -Profile Any | Out-Null')
    return ($lines.ToArray() -join "`r`n")
}

function New-CoopRemoveFirewallScript {
    param([Parameter(Mandatory)][string]$DisplayName)
    return ('$ErrorActionPreference = ''Stop''' + "`r`n" + 'Get-NetFirewallRule -DisplayName ' + (ConvertTo-CoopPsLiteral $DisplayName) + ' -ErrorAction SilentlyContinue | Remove-NetFirewallRule')
}

function ConvertTo-CoopEncodedCommand {
    # Pure: base64 of the UTF-16LE script (powershell.exe -EncodedCommand).
    param([Parameter(Mandatory)][string]$Script)
    return [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($Script))
}

function Invoke-CoopElevated {
    # Runs $Script in an elevated Windows PowerShell (one UAC prompt) and waits.
    # Returns $true when it ran and exited with 0.
    param([Parameter(Mandatory)][string]$Script)
    $exe = Join-Path $env:SystemRoot 'System32\WindowsPowerShell\v1.0\powershell.exe'
    try {
        $p = Start-Process -FilePath $exe -Verb RunAs -ArgumentList @('-NoProfile', '-ExecutionPolicy', 'Bypass', '-EncodedCommand', (ConvertTo-CoopEncodedCommand -Script $Script)) -Wait -PassThru
        return $p.ExitCode -eq 0
    } catch { return $false }
}

Export-ModuleMember -Function *-*
