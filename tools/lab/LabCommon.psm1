# Processes, ports and fuse
# ---------------------------------------------------------------------------

function Select-ProcessInDirectory {
    # Pure: rows (Id, Path) whose executable lives directly in $Directory. Rows
    # with an unknown path are returned with Unknown=$true (callers must treat
    # them as possibly matching).
    param([object[]]$Processes = @(), [Parameter(Mandatory)][string]$Directory)
    $root = [IO.Path]::GetFullPath($Directory).TrimEnd('\', '/')
    $rows = foreach ($p in @($Processes)) {
        if (!$p) { continue }
        if (!$p.Path) { [pscustomobject]@{ Id = $p.Id; Path = $null; Unknown = $true }; continue }
        $folder = Split-Path -Parent ([IO.Path]::GetFullPath($p.Path))
        if ($folder.TrimEnd('\', '/').Equals($root, [StringComparison]::OrdinalIgnoreCase)) {
            [pscustomobject]@{ Id = $p.Id; Path = $p.Path; Unknown = $false }
        }
    }
    return @($rows)
}

function Get-ProcessPathSafe {
    param([Parameter(Mandatory)]$Process)
    $path = $null
    try { $path = $Process.Path } catch { $path = $null }
    if (!$path) {
        try { $path = (Get-CimInstance Win32_Process -Filter "ProcessId=$($Process.Id)" -ErrorAction Stop).ExecutablePath } catch { $path = $null }
    }
    return $path
}

function Get-GameProcessInDirectory {
    # mgsvtpp/mgsvmgo processes started from $Directory (by executable path).
    param([Parameter(Mandatory)][string]$Directory)
    $rows = foreach ($p in @(Get-Process -Name mgsvtpp, mgsvmgo -ErrorAction SilentlyContinue)) {
        [pscustomobject]@{ Id = $p.Id; Path = (Get-ProcessPathSafe $p) }
    }
    return Select-ProcessInDirectory -Processes @($rows) -Directory $Directory
}

function Get-ProcessStartUtc {
    # Process creation time in UTC, or $null when it cannot be read.
    param([Parameter(Mandatory)]$Process)
    try { return $Process.StartTime.ToUniversalTime() } catch { return $null }
}

function Test-RunProcessIdentity {
    # Pure: is a live process that started at $ActualStartUtc the one this run
    # started? With a recorded start time it must match within 1 s; otherwise
    # (older run.json) it must have started inside the run's launch window.
    param([AllowNull()]$ActualStartUtc, [AllowNull()]$RecordedStartUtc, [AllowNull()]$NotBeforeUtc, [AllowNull()]$NotAfterUtc)
    $actual = ConvertTo-LabUtc $ActualStartUtc
    if (!$actual) { return $false }
    $recorded = ConvertTo-LabUtc $RecordedStartUtc
    if ($recorded) { return [Math]::Abs(($actual - $recorded).TotalSeconds) -lt 1 }
    $from = ConvertTo-LabUtc $NotBeforeUtc
    $to = ConvertTo-LabUtc $NotAfterUtc
    if (!$from -or !$to) { return $false }
    return $actual -ge $from.AddSeconds(-2) -and $actual -le $to.AddSeconds(2)
}

function Select-LabStopTargets {
    # Pure: what Stop-Lab may do with each process.
    #  Recorded rows (this run's instances): Role, Id, Alive, PathMatches, IdentityVerified.
    #  Found rows (mgsvtpp/mgsvmgo running from a lab folder): Role, Id.
    # Actions: close_then_terminate - this run's own process (pid, executable path
    # and start time verified): WM_CLOSE, terminated after the timeout;
    # close_only - any other process, only with -IncludeUnrecorded: WM_CLOSE, never
    # terminated; leave - any other process (for example a normal session that
    # was started from Steam later).
    param([object[]]$Recorded = @(), [object[]]$Found = @(), [switch]$IncludeUnrecorded)
    $rows = [Collections.Generic.List[object]]::new()
    $handled = @{}
    foreach ($r in @($Recorded)) {
        if (!$r -or !$r.Alive -or !$r.PathMatches -or !$r.IdentityVerified) { continue }
        $rows.Add([pscustomobject]@{ Role = [string]$r.Role; Id = [int]$r.Id; Action = 'close_then_terminate'; Reason = 'this_run' })
        $handled[[int]$r.Id] = $true
    }
    foreach ($f in @($Found)) {
        if (!$f -or $handled.ContainsKey([int]$f.Id)) { continue }
        $handled[[int]$f.Id] = $true
        $action = if ($IncludeUnrecorded) { 'close_only' } else { 'leave' }
        $rows.Add([pscustomobject]@{ Role = [string]$f.Role; Id = [int]$f.Id; Action = $action; Reason = 'not_this_run' })
    }
    return $rows.ToArray()  # callers wrap in @()
}

function Test-LocalPortFree {
    param([Parameter(Mandatory)][int]$Port, [ValidateSet('Tcp', 'Udp')][string]$Protocol = 'Tcp')
    # Any listener on the port (all addresses), then an exclusive loopback bind.
    $properties = [Net.NetworkInformation.IPGlobalProperties]::GetIPGlobalProperties()
    $listeners = if ($Protocol -eq 'Tcp') { $properties.GetActiveTcpListeners() } else { $properties.GetActiveUdpListeners() }
    if (@($listeners | Where-Object { $_.Port -eq $Port }).Count) { return $false }
    $type = if ($Protocol -eq 'Tcp') { [Net.Sockets.SocketType]::Stream } else { [Net.Sockets.SocketType]::Dgram }
    $proto = if ($Protocol -eq 'Tcp') { [Net.Sockets.ProtocolType]::Tcp } else { [Net.Sockets.ProtocolType]::Udp }
    $socket = [Net.Sockets.Socket]::new([Net.Sockets.AddressFamily]::InterNetwork, $type, $proto)
    try {
        $socket.ExclusiveAddressUse = $true
        $socket.Bind([Net.IPEndPoint]::new([Net.IPAddress]::Loopback, $Port))
        return $true
    } catch { return $false }
    finally { $socket.Dispose() }
}

function Test-TcpListening {
    # True when something accepts TCP connections on 127.0.0.1:$Port (local only).
    param([Parameter(Mandatory)][int]$Port, [int]$TimeoutMs = 500)
    $client = [Net.Sockets.TcpClient]::new()
    try {
        $task = $client.ConnectAsync([Net.IPAddress]::Loopback, $Port)
        return $task.Wait($TimeoutMs) -and $client.Connected
    } catch { return $false }
    finally { $client.Dispose() }
}

function New-FuseArguments {
    # fuse must ALWAYS run with -standalone: without it fuse backs up and
    # patches mgsvtpp.exe on disk (for the wrong executable version).
    param([int]$Port = 6667, [bool]$WriteLog = $true)
    if ($Port -lt 1024 -or $Port -gt 65535) { throw "Invalid fuse port: $Port" }
    $arguments = @('-standalone', '-listenAddr', "127.0.0.1:$Port", '-baseURL', "http://127.0.0.1:$Port/")
    if ($WriteLog) { $arguments += '-writeLog' }
    Assert-FuseArgumentsSafe -Arguments $arguments
    return , $arguments
}

function Assert-FuseArgumentsSafe {
    param([Parameter(Mandatory)][string[]]$Arguments)
    if (@($Arguments | Where-Object { $_ -ceq '-standalone' }).Count -ne 1) { throw 'Refusing to start fuse without -standalone (it would patch the executable on disk).' }
    if (@($Arguments | Where-Object { $_ -match '^-+(clientURL|passThrough|standalone=)' }).Count) { throw 'Refusing fuse -clientURL/-passThrough/-standalone=... in the lab.' }
    $listen = [Array]::IndexOf($Arguments, '-listenAddr')
    if ($listen -lt 0 -or $listen + 1 -ge $Arguments.Count -or $Arguments[$listen + 1] -cnotmatch '^127\.0\.0\.1:[0-9]+$') {
        throw 'fuse must listen on 127.0.0.1 only.'
    }
}

function Get-FuseMessageSummary {
    # fuse -writeLog stores each decoded request as log/<startUnix>/<unixMs>_<MSGID>_request
    # in its working directory. Returns counts per message id (names only; the
    # files themselves can contain a Steam auth ticket and are not copied).
    param([Parameter(Mandatory)][string]$FuseDirectory, [Int64]$SinceUnix = 0)
    $root = Join-Path $FuseDirectory 'log'
    $counts = [ordered]@{}
    if (!(Test-Path -LiteralPath $root -PathType Container)) { return [pscustomobject]$counts }
    foreach ($dir in Get-ChildItem -LiteralPath $root -Directory) {
        [Int64]$start = 0
        if (![Int64]::TryParse($dir.Name, [ref]$start) -or $start -lt $SinceUnix) { continue }
        foreach ($file in Get-ChildItem -LiteralPath $dir.FullName -File) {
            if ($file.Name -cmatch '^[0-9]+_(CMD_[A-Z0-9_]+)_(request|response)$') {
                $key = $Matches[1]
                if ($counts.Contains($key)) { $counts[$key]++ } else { $counts[$key] = 1 }
            }
        }
    }
    return [pscustomobject]$counts
}

# ---------------------------------------------------------------------------
# Runs
# ---------------------------------------------------------------------------

function New-RunStamp { return [DateTime]::Now.ToString('yyyyMMdd-HHmmss') }

function Get-CurrentRun {
    # Loads run.json from -RunDir or from <runDir>/current-run.json.
    param($Config, [string]$RunDir)
    if (!$RunDir) {
        $pointer = Join-Path $Config.Paths.runDir 'current-run.json'
        if (!(Test-Path -LiteralPath $pointer -PathType Leaf)) { throw "No current lab run ($pointer). Run Start-Lab.ps1 or pass -RunDir." }
        $RunDir = (Get-Content -LiteralPath $pointer -Raw -Encoding UTF8 | ConvertFrom-Json).run_dir
    }
    $runJson = Join-Path $RunDir 'run.json'
    if (!(Test-Path -LiteralPath $runJson -PathType Leaf)) { throw "run.json not found in $RunDir" }
    $run = Get-Content -LiteralPath $runJson -Raw -Encoding UTF8 | ConvertFrom-Json
    return [pscustomobject]@{ Dir = (Resolve-Path -LiteralPath $RunDir).Path; Run = $run }
}

function Get-InstanceExpectation {
    # Values the safety evidence must show for one run instance: run.json
    # instances.<role>.expected (recorded by Start-Lab.ps1) or, for runs recorded
    # before that existed, the instance's lab folder, coop.ini and lab.ini.
    param([Parameter(Mandatory)][ValidateSet('host', 'guest')][string]$Role, [Parameter(Mandatory)]$Instance)
    $recorded = Get-ConfigValue $Instance 'expected' $null
    if ($recorded) {
        return [pscustomobject]@{
            SaveDir = [string]$recorded.save_dir; Url = [string]$recorded.master_url
            SteamId = [string](Get-ConfigValue $recorded 'steamid' ''); MutexSuffix = [string](Get-ConfigValue $recorded 'mutex_suffix' '')
        }
    }
    $paths = Get-InstancePaths -GameDirectory ([string]$Instance.dir)
    $lab = ConvertFrom-IniText (Read-SharedText -Path $paths.LabIni)
    $coop = ConvertFrom-IniText (Read-SharedText -Path $paths.CoopIni)
    [pscustomobject]@{
        SaveDir = $paths.SaveDir; Url = [string](Get-ConfigValue $coop 'master_url' '')
        SteamId = $(if ($Role -eq 'guest') { [string](Get-ConfigValue $lab 'self_steamid' '') } else { '' })
        MutexSuffix = $(if ($Role -eq 'guest') { [string](Get-ConfigValue $lab 'mutex_suffix' '') } else { '' })
    }
}

function Get-InstanceSafety {
    # Get-LabSafetyVerdict for one instance with its expectation (see above).
    param(
        [Parameter(Mandatory)][ValidateSet('host', 'guest')][string]$Role,
        [Parameter(Mandatory)]$Expectation,
        [AllowNull()][AllowEmptyString()][string]$EarlyLog,
        [AllowNull()][AllowEmptyString()][string]$SteamLog
    )
    if (!$Expectation.SaveDir -or !$Expectation.Url -or ($Role -eq 'guest' -and (!$Expectation.SteamId -or !$Expectation.MutexSuffix))) {
        return [pscustomobject]@{ State = 'unsafe'; Reason = 'no_expectation'; Missing = @() }
    }
    return Get-LabSafetyVerdict -Role $Role -EarlyLog $EarlyLog -SteamLog $SteamLog -ExpectedSaveDir $Expectation.SaveDir `
        -ExpectedUrl $Expectation.Url -ExpectedSteamId $Expectation.SteamId -ExpectedMutexSuffix $Expectation.MutexSuffix
}

function Write-RedactedText {
    # Writes $Text through Hide-SteamIds (UTF-8, no BOM). Used for everything
    # copied into a run folder, which is meant to be shareable.
    param([Parameter(Mandatory)][string]$Path, [AllowNull()][AllowEmptyString()][string]$Text, [string[]]$Keep = @())
    $parent = Split-Path -Parent $Path
    if (!(Test-Path -LiteralPath $parent)) { $null = New-Item -ItemType Directory -Path $parent -Force }
    [IO.File]::WriteAllText($Path, [string](Hide-SteamIds -Text $Text -Keep $Keep), $script:Utf8NoBom)
}

function Write-JsonFile {
    param([Parameter(Mandatory)][string]$Path, [Parameter(Mandatory)]$Value)
    $parent = Split-Path -Parent $Path
    if (!(Test-Path -LiteralPath $parent)) { $null = New-Item -ItemType Directory -Path $parent -Force }
    $temp = $Path + '.' + [Guid]::NewGuid().ToString('N') + '.tmp'
    [IO.File]::WriteAllText($temp, ($Value | ConvertTo-Json -Depth 10) + "`n", $script:Utf8NoBom)
    Move-Item -LiteralPath $temp -Destination $Path -Force
}

function Get-LabLogNames {
    # Per-instance logs under <exeDir>/mgs-coop/ (docs/lab-protocol.md plus the existing logs).
    return @('script-observer.log', 'early.log', 'loopback.log', 'steam-observer.log', 'probe.log')
}

function Get-LiveProcess {
    # The process with $Id if it is still running from $ExpectedPath; else $null.
    param([int]$Id, [string]$ExpectedPath)
    if (!$Id) { return $null }
    $p = Get-Process -Id $Id -ErrorAction SilentlyContinue
    if (!$p) { return $null }
    if ($ExpectedPath) {
        $path = Get-ProcessPathSafe $p
        if ($path -and ![IO.Path]::GetFullPath($path).Equals([IO.Path]::GetFullPath($ExpectedPath), [StringComparison]::OrdinalIgnoreCase)) { return $null }
    }
    return $p
}

function New-TriggerFile {
    # Creates a trigger (join.trigger / reset.trigger / partner.trigger) atomically:
    # a temporary file in the same folder renamed over the target. Native code
    # deletes it. Content: -Text plus a newline (partner.trigger), else a timestamp.
    param([Parameter(Mandatory)][string]$Path, [string]$Text = '')
    $temp = $Path + '.' + [Guid]::NewGuid().ToString('N') + '.tmp'
    $content = if ($Text) { $Text + "`n" } else { [DateTime]::UtcNow.ToString('o') + "`n" }
    [IO.File]::WriteAllText($temp, $content, [Text.Encoding]::ASCII)
    try { Move-Item -LiteralPath $temp -Destination $Path -Force }
    finally { if (Test-Path -LiteralPath $temp) { Remove-Item -LiteralPath $temp -Force } }
}

function Get-LabScanCodeTable {
    # Key names Send-LabInput.ps1 understands -> @(scan code (set 1), extended).
    [ordered]@{
        enter = @(0x1C, $false); esc = @(0x01, $false); space = @(0x39, $false); tab = @(0x0F, $false)
        up = @(0x48, $true); down = @(0x50, $true); left = @(0x4B, $true); right = @(0x4D, $true)
        e = @(0x12, $false); f = @(0x21, $false); q = @(0x10, $false); r = @(0x13, $false); c = @(0x2E, $false)
        x = @(0x2D, $false); z = @(0x2C, $false); v = @(0x2F, $false); w = @(0x11, $false); a = @(0x1E, $false)
        s = @(0x1F, $false); d = @(0x20, $false); f8 = @(0x42, $false); f9 = @(0x43, $false); ctrl = @(0x1D, $false)
        shift = @(0x2A, $false); f10 = @(0x44, $false); f11 = @(0x57, $false)
    }
}

function ConvertFrom-LabKeySpec {
    # Pure: one Send-LabInput key spec -> the keys pressed together (in order;
    # released in reverse) and how long they are held:
    #   enter | ctrl+f8 | w:4000 (hold W 4 s) | w+a:6000 (W and A together for 6 s)
    # Hold time ':<ms>' 1..60000; without ':' it is -DefaultHoldMs (Send-LabInput
    # -HoldMs, 0..60000: 0 taps the key, as Send-LabInput always allowed).
    param([Parameter(Mandatory)][string]$Spec, [int]$DefaultHoldMs = 150)
    if ($DefaultHoldMs -lt 0 -or $DefaultHoldMs -gt 60000) { throw 'HoldMs must be 0..60000.' }
    $text = $Spec.Trim().ToLowerInvariant()
    $hold = $DefaultHoldMs
    $colon = $text.IndexOf(':')
    if ($colon -ge 0) {
        $ms = $text.Substring($colon + 1)
        $text = $text.Substring(0, $colon)
        if ($ms -cnotmatch '^[0-9]{1,5}$' -or [int]$ms -lt 1 -or [int]$ms -gt 60000) { throw "Invalid hold time in key spec '$Spec' (1..60000 ms)." }
        $hold = [int]$ms
    }
    if (!$text) { throw "Empty key spec '$Spec'." }
    $table = Get-LabScanCodeTable
    $names = @($text.Split('+'))
    $keys = [Collections.Generic.List[object]]::new()
    foreach ($name in $names) {
        if (!$name -or !$table.Contains($name)) { throw "Unknown key name: $name" }
        if (@($keys | Where-Object { $_.Name -ceq $name }).Count) { throw "Key $name repeated in '$Spec'." }
        $keys.Add([pscustomobject]@{ Name = $name; Scan = [uint16]$table[$name][0]; Extended = [bool]$table[$name][1] })
    }
    [pscustomobject]@{ Spec = $Spec.Trim(); Keys = $keys.ToArray(); HoldMs = $hold }
}

# ---------------------------------------------------------------------------
# Win32 windows, input and capture (loaded on demand)
# ---------------------------------------------------------------------------

function Initialize-LabWin32 {
    if ('MgsCoopLab.User32' -as [type]) { return }
    Add-Type -TypeDefinition @'
using System;
using System.Runtime.InteropServices;
namespace MgsCoopLab {
public static class User32 {
    [StructLayout(LayoutKind.Sequential)] public struct RECT { public int Left, Top, Right, Bottom; }
    [StructLayout(LayoutKind.Sequential)] public struct MOUSEINPUT { public int dx, dy; public uint mouseData, dwFlags, time; public IntPtr dwExtraInfo; }
    [StructLayout(LayoutKind.Sequential)] public struct KEYBDINPUT { public ushort wVk, wScan; public uint dwFlags, time; public IntPtr dwExtraInfo; }
    [StructLayout(LayoutKind.Explicit)] public struct InputUnion { [FieldOffset(0)] public MOUSEINPUT mi; [FieldOffset(0)] public KEYBDINPUT ki; }
    [StructLayout(LayoutKind.Sequential)] public struct INPUT { public uint type; public InputUnion u; }
    [DllImport("user32.dll", SetLastError = true)] public static extern bool SetWindowPos(IntPtr hWnd, IntPtr after, int x, int y, int cx, int cy, uint flags);
    [DllImport("user32.dll", SetLastError = true)] public static extern bool GetWindowRect(IntPtr hWnd, out RECT rect);
    [DllImport("user32.dll", SetLastError = true)] public static extern bool PrintWindow(IntPtr hWnd, IntPtr hdc, uint flags);
    [DllImport("user32.dll")] public static extern bool SetForegroundWindow(IntPtr hWnd);
    [DllImport("user32.dll")] public static extern IntPtr GetForegroundWindow();
    [DllImport("user32.dll")] public static extern bool ShowWindow(IntPtr hWnd, int cmd);
    [DllImport("user32.dll")] public static extern bool IsIconic(IntPtr hWnd);
    [DllImport("user32.dll")] public static extern bool IsWindow(IntPtr hWnd);
    [DllImport("user32.dll", SetLastError = true)] public static extern bool PostMessage(IntPtr hWnd, uint msg, IntPtr w, IntPtr l);
    [DllImport("user32.dll", SetLastError = true)] public static extern uint SendInput(uint count, INPUT[] inputs, int size);
    public static uint Key(ushort scan, bool extended, bool up) {
        INPUT[] input = new INPUT[1];
        input[0].type = 1; // INPUT_KEYBOARD
        input[0].u.ki.wScan = scan;
        input[0].u.ki.dwFlags = 0x0008u | (extended ? 0x0001u : 0u) | (up ? 0x0002u : 0u); // SCANCODE | EXTENDED | KEYUP
        return SendInput(1, input, Marshal.SizeOf(typeof(INPUT)));
    }
}
public static class Kernel32 {
    [DllImport("kernel32.dll", SetLastError = true)] public static extern IntPtr GetStdHandle(int which);
    [DllImport("kernel32.dll", SetLastError = true)] public static extern bool GetHandleInformation(IntPtr handle, out uint flags);
    [DllImport("kernel32.dll", SetLastError = true)] public static extern bool SetHandleInformation(IntPtr handle, uint mask, uint flags);
}
}
'@
}

function Invoke-WithoutStdHandleInheritance {
    # Runs $Script with this process's stdout/stderr handles marked non-inheritable,
    # so processes it starts (fuse with redirected output) do not keep a caller's
    # output pipe open. Otherwise `pwsh -File Start-Lab.ps1 | ...` would not finish
    # until fuse and the games exit.
    param([Parameter(Mandatory)][scriptblock]$Script)
    Initialize-LabWin32
    $saved = @()
    foreach ($which in -11, -12) {  # STD_OUTPUT_HANDLE, STD_ERROR_HANDLE
        $handle = [MgsCoopLab.Kernel32]::GetStdHandle($which)
        [uint32]$flags = 0
        if ($handle -ne [IntPtr]::Zero -and $handle -ne [IntPtr]::new(-1) -and [MgsCoopLab.Kernel32]::GetHandleInformation($handle, [ref]$flags) -and ($flags -band 1)) {
            if ([MgsCoopLab.Kernel32]::SetHandleInformation($handle, 1, 0)) { $saved += $handle }
        }
    }
    try { & $Script }
    finally { foreach ($handle in $saved) { $null = [MgsCoopLab.Kernel32]::SetHandleInformation($handle, 1, 1) } }
}

function Get-WindowRectangle {
    param([Parameter(Mandatory)][IntPtr]$Handle)
    Initialize-LabWin32
    $rect = [MgsCoopLab.User32+RECT]::new()
    if (![MgsCoopLab.User32]::GetWindowRect($Handle, [ref]$rect)) { return $null }
    return [pscustomobject]@{ X = $rect.Left; Y = $rect.Top; Width = $rect.Right - $rect.Left; Height = $rect.Bottom - $rect.Top }
}

function Get-ProcessMainWindow {
    # Main window handle of a live process (IntPtr.Zero when none yet).
    param([Parameter(Mandatory)][int]$Id)
    $p = Get-Process -Id $Id -ErrorAction SilentlyContinue
    if (!$p) { return [IntPtr]::Zero }
    $p.Refresh()
    return $p.MainWindowHandle
}

function Move-GameWindow {
    # Moves (and optionally resizes) a top-level window without activating it.
    param([Parameter(Mandatory)][IntPtr]$Handle, [int]$X, [int]$Y, [int]$Width = 0, [int]$Height = 0)
    Initialize-LabWin32
    $flags = 0x0004 -bor 0x0010  # SWP_NOZORDER | SWP_NOACTIVATE
    if ($Width -le 0 -or $Height -le 0) { $flags = $flags -bor 0x0001 }  # SWP_NOSIZE
    return [MgsCoopLab.User32]::SetWindowPos($Handle, [IntPtr]::Zero, $X, $Y, $Width, $Height, [uint32]$flags)
}

function Close-GameWindow {
    # Posts WM_CLOSE (the same message as the window's close button).
    param([Parameter(Mandatory)][IntPtr]$Handle)
    Initialize-LabWin32
    if ($Handle -eq [IntPtr]::Zero -or ![MgsCoopLab.User32]::IsWindow($Handle)) { return $false }
    return [MgsCoopLab.User32]::PostMessage($Handle, 0x0010, [IntPtr]::Zero, [IntPtr]::Zero)
}

function Send-ScanCodeKey {
    # Best effort: focuses the window, then holds one scan-code key ~150 ms.
    # Returns $false when the window could not be brought to the foreground.
    param([Parameter(Mandatory)][IntPtr]$Handle, [Parameter(Mandatory)][uint16]$ScanCode, [switch]$Extended, [int]$HoldMs = 150)
    Initialize-LabWin32
    if ([MgsCoopLab.User32]::IsIconic($Handle)) { $null = [MgsCoopLab.User32]::ShowWindow($Handle, 9) }  # SW_RESTORE
    $null = [MgsCoopLab.User32]::SetForegroundWindow($Handle)
    Start-Sleep -Milliseconds 250
    if ([MgsCoopLab.User32]::GetForegroundWindow() -ne $Handle) { return $false }
    $down = [MgsCoopLab.User32]::Key($ScanCode, $Extended.IsPresent, $false)
    Start-Sleep -Milliseconds $HoldMs
    $up = [MgsCoopLab.User32]::Key($ScanCode, $Extended.IsPresent, $true)
    return ($down -eq 1 -and $up -eq 1)
}

function Test-BitmapMostlyBlack {
    # Samples a grid; true when every sample is (near) black - PrintWindow on a
    # D3D swap chain can return an empty image.
    param([Parameter(Mandatory)]$Bitmap)
    $steps = 12
    for ($i = 1; $i -lt $steps; $i++) {
        for ($j = 1; $j -lt $steps; $j++) {
            $c = $Bitmap.GetPixel([int]($Bitmap.Width * $i / $steps), [int]($Bitmap.Height * $j / $steps))
            if (($c.R + $c.G + $c.B) -gt 24) { return $false }
        }
    }
    return $true
}

function Save-WindowCapture {
    # PrintWindow(PW_RENDERFULLCONTENT) into a PNG; falls back to a screen copy of
    # the window rectangle when PrintWindow fails or yields a black image.
    param([Parameter(Mandatory)][IntPtr]$Handle, [Parameter(Mandatory)][string]$Path)
    Initialize-LabWin32
    Add-Type -AssemblyName System.Drawing
    $rect = Get-WindowRectangle -Handle $Handle
    if (!$rect -or $rect.Width -le 0 -or $rect.Height -le 0) { return [pscustomobject]@{ Path = $null; Method = 'none'; Reason = 'no_window_rect' } }
    $method = 'printwindow'
    $bitmap = [Drawing.Bitmap]::new($rect.Width, $rect.Height)
    try {
        $graphics = [Drawing.Graphics]::FromImage($bitmap)
        $hdc = $graphics.GetHdc()
        $ok = $false
        try { $ok = [MgsCoopLab.User32]::PrintWindow($Handle, $hdc, 2) } finally { $graphics.ReleaseHdc($hdc); $graphics.Dispose() }
        if (!$ok -or (Test-BitmapMostlyBlack $bitmap)) {
            $method = 'copyfromscreen'
            $graphics = [Drawing.Graphics]::FromImage($bitmap)
            try { $graphics.CopyFromScreen($rect.X, $rect.Y, 0, 0, [Drawing.Size]::new($rect.Width, $rect.Height)) } finally { $graphics.Dispose() }
        }
        $parent = Split-Path -Parent $Path
        if (!(Test-Path -LiteralPath $parent)) { $null = New-Item -ItemType Directory -Path $parent -Force }
        $bitmap.Save($Path, [Drawing.Imaging.ImageFormat]::Png)
    } finally { $bitmap.Dispose() }
    return [pscustomobject]@{ Path = $Path; Method = $method; Reason = '' }
}

Export-ModuleMember -Function *-*
