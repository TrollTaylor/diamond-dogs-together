function Test-LabUrl {
    # Mirrors mgscoop::master_server::ValidateUrl and the coop.ini parser.
    param([AllowNull()][AllowEmptyString()][string]$Url)
    if (!$Url -or $Url.Length -gt 69) { return $false }
    if ($Url -cnotmatch '^https?://[\x21-\x7e]+$' -or $Url -match '["\\]') { return $false }
    if (!$Url.EndsWith('/tppstm/gate', [StringComparison]::Ordinal)) { return $false }
    $scheme = if ($Url.StartsWith('https://', [StringComparison]::Ordinal)) { 8 } else { 7 }
    return ($Url.Length - 12) -gt $scheme -and $Url[$scheme] -ne '/'
}

function Test-AbsoluteWindowsPath {
    param([string]$Path)
    return $Path -cmatch '^[A-Za-z]:[\\/]' -or $Path.StartsWith('\\')
}

