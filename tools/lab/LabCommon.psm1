function Test-LabBootSpec {
    # Pure: a lab_boot value as the native ParseLabBoot accepts it (docs/test-boot.md): off, or a mission (30010,
    # 30020, 30050 or an ACC 40010, 40020, 40050), for free roam optionally x y z (|v| <= 100000) and yaw (|v| <= 360),
    # each with at most 3 decimals, then time=HH:MM and weather=sunny|cloudy|rainy|sandstorm|foggy (no fog in 30020).
    param([AllowEmptyString()][string]$Text)
    if ($Text -ceq 'off') { return $true }
    $n = '-?[0-9]{1,6}(?:\.[0-9]{1,3})?'
    $tail = '(?: time=(?:[01][0-9]|2[0-3]):[0-5][0-9])?(?: weather=(sunny|cloudy|rainy|sandstorm|foggy))?'
    $pos = '^(30010|30020|30050) (' + $n + ') (' + $n + ') (' + $n + ') (' + $n + ')' + $tail + '$'
    $plain = '^(30010|30020|30050|40010|40020|40050)' + $tail + '$'
    $m = [regex]::Match($Text, $pos)
    if ($m.Success) {
        foreach ($i in 2, 3, 4) { if ([Math]::Abs([double]::Parse($m.Groups[$i].Value, [Globalization.CultureInfo]::InvariantCulture)) -gt 100000) { return $false } }
        if ([Math]::Abs([double]::Parse($m.Groups[5].Value, [Globalization.CultureInfo]::InvariantCulture)) -gt 360) { return $false }
        return !($m.Groups[1].Value -ceq '30020' -and $m.Groups[6].Value -ceq 'foggy')
    }
    $m = [regex]::Match($Text, $plain)
    return $m.Success -and !($m.Groups[1].Value -ceq '30020' -and $m.Groups[2].Value -ceq 'foggy')
}

function Get-LabPartnerKeySpec {
    param([Parameter(Mandatory)][string]$Key)
    foreach ($spec in $script:LabPartnerKeys) { if ($spec.Key -ceq $Key) { return $spec } }
    return $null
}

function ConvertTo-LabPartnerValue {
    # Pure: validates one partner/net lab.ini value (docs/offline-partner-spike-plan.md 2.1)
    # and returns its canonical text (booleans as 0/1, integers without leading zeros).
    param([Parameter(Mandatory)][string]$Key, [AllowNull()]$Value)
    $spec = Get-LabPartnerKeySpec -Key $Key
    if (!$spec) { throw "Unknown partner lab.ini key: $Key" }
    if ($null -eq $Value) { throw "Missing value for lab.ini $Key" }
    $text = if ($Value -is [bool]) { if ($Value) { '1' } else { '0' } } else { ([string]$Value).Trim() }
    $allowed = ''
    if ($spec.Kind -eq 'bool') {
        if ($text -cin @('1', 'true', 'yes', 'on')) { return '1' }
        if ($text -cin @('0', 'false', 'no', 'off')) { return '0' }
        $allowed = '0 or 1'
    } elseif ($spec.Kind -eq 'fire') {
        if ($text -cin @('0', 'off', 'false', 'no')) { return '0' }
        if ($text -cin @('1', 'visual', 'true', 'yes', 'on')) { return 'visual' }
        $allowed = '0|visual'
    } elseif ($spec.Kind -eq 'port') {
        if ($text -cmatch '^[0-9]{1,5}$' -and [int]$text -ge 1024 -and [int]$text -le 65535) { return [string][int]$text }
        $allowed = '1024..65535'
    } elseif ($spec.Kind -eq 'int') {
        if ($text -cmatch '^[0-9]{1,5}$' -and [int]$text -ge $spec.Min -and [int]$text -le $spec.Max) { return [string][int]$text }
        $allowed = [string]$spec.Min + '..' + [string]$spec.Max
    } elseif ($spec.Kind -eq 'u32') {
        if ($text -cmatch '^[0-9]{1,10}$' -and [uint64]$text -ge $spec.Min -and [uint64]$text -le 4294967295) { return [string][uint64]$text }
        $allowed = [string]$spec.Min + '..4294967295'
    } elseif ($spec.Kind -eq 'bind') {
        # Spec 1.1: loopback, any or a dotted IPv4 (the native side never resolves names).
        if ($text -cin @('loopback', 'any') -or (Test-CoopIPv4Text $text)) { return $text }
        $allowed = 'loopback|any|<dotted IPv4>'
    } elseif ($spec.Kind -eq 'ipv4') {
        # Spec 1.1 net_peer_addr: canonical dotted IPv4, not 0.0.0.0, 255.255.255.255 or
        # 224.0.0.0/4 (127/8 is lab-only, which this lab helper allows).
        if ((Test-CoopIPv4Text $text) -and ((Test-CoopPlayPeerAddress $text) -or $text.StartsWith('127.', [StringComparison]::Ordinal))) { return $text }
        $allowed = 'a dotted IPv4 (no names, no 0.0.0.0/broadcast/multicast)'
    } elseif ($spec.Kind -eq 'sint') {
        if ($text -cmatch '^(0|-?[1-9][0-9]{0,4})$' -and [int]$text -ge $spec.Min -and [int]$text -le $spec.Max) { return [string][int]$text }
        $allowed = [string]$spec.Min + '..' + [string]$spec.Max
    } elseif ($spec.Kind -eq 'nametag') {
        # As the native lab.ini parser: 1..24 of [A-Za-z0-9 _.-], no blank at either end.
        if ($text -cmatch '^[A-Za-z0-9_.-]([A-Za-z0-9 _.-]{0,22}[A-Za-z0-9_.-])?$') { return $text }
        $allowed = '1..24 of [A-Za-z0-9 _.-]'
    } elseif ($spec.Kind -eq 'labboot') {
        # As the native ParseLabBoot (docs/test-boot.md); single blanks between the tokens.
        $canonical = (@($text -split '\s+' | Where-Object { $_ })) -join ' '
        if (Test-LabBootSpec $canonical) { return $canonical }
        $allowed = 'off, <30010|30020|30050> <x> <y> <z> <yaw> [time=HH:MM] [weather=<name>], or <30010|30020|30050|40010|40020|40050> [time=HH:MM] [weather=<name>]'
    } elseif ($spec.Kind -eq 'words') {
        if ($text -cmatch '^[0prhn]{3}$') { return $text }
        $allowed = '3 of 0prhn'
    } elseif ($spec.Kind -eq 'mask') {
        if ($text -cmatch '^0x[0-9a-fA-F]{1,8}$') { return $text.ToLower() }
        if ($text -cmatch '^[0-9]{1,10}$' -and [uint64]$text -le 4294967295) { return [string][uint64]$text }
        $allowed = 'decimal or 0x hex u32'
    } elseif ($spec.Kind -eq 'stick') {
        if ($text -cmatch '^(0|[1-9][0-9]{0,2}):(0|[1-9][0-9]?|100)$') {
            $parts = $text.Split(':')
            if ([int]$parts[0] -le 359 -and [int]$parts[1] -le 100) { return $text }
        }
        $allowed = '<0..359>:<0..100>'
    } elseif ($spec.Kind -eq 'dmmap') {
        if ($text -cmatch '^((0|[1-9]|1[0-9]|2[0-9]|30),){11}(0|[1-9]|1[0-9]|2[0-9]|30)$') { return $text }
        $allowed = '12 comma-separated gani indices 0..30'
    } elseif ($spec.Kind -eq 'dmspeed') {
        # As the native ParsePartnerDmSpeeds: idle 200..2000, run idle+300..10000, dash run+300..20000.
        if ($text -cmatch '^([1-9][0-9]{2,4}):([1-9][0-9]{2,4}):([1-9][0-9]{2,4})$') {
            $v = @($text.Split(':') | ForEach-Object { [int]$_ })
            if ($v[0] -ge 200 -and $v[0] -le 2000 -and $v[1] -ge $v[0] + 300 -and $v[1] -le 10000 -and $v[2] -ge $v[1] + 300 -and $v[2] -le 20000) { return $text }
        }
        $allowed = '<idle 200..2000>:<run idle+300..10000>:<dash run+300..20000>'
    } else {
        if ($text -cin $spec.Values) { return $text }
        $allowed = $spec.Values -join '|'
    }
    throw "Invalid lab.ini $Key=$text (allowed: $allowed)."
}

function ConvertTo-LabPartnerIni {
    # Pure: validated partner/net lab.ini settings as an ordered dictionary in the
    # order they are written. Unknown keys and colliding ports are refused: the two
    # net ports must differ from each other and from listen_port/peer_port (the
    # native parser turns net off otherwise), and net=1 needs both of them.
    param([AllowNull()][Collections.IDictionary]$Values, [int]$ListenPort = 0, [int]$PeerPort = 0)
    $out = [ordered]@{}
    if ($null -eq $Values -or $Values.Count -eq 0) { return $out }
    foreach ($key in @($Values.Keys)) { if (!(Get-LabPartnerKeySpec -Key ([string]$key))) { throw "Unknown partner lab.ini key: $key" } }
    foreach ($spec in $script:LabPartnerKeys) {
        if ($Values.Contains($spec.Key)) { $out[$spec.Key] = ConvertTo-LabPartnerValue -Key $spec.Key -Value $Values[$spec.Key] }
    }
    $netListen = if ($out.Contains('net_listen_port')) { [int]$out['net_listen_port'] } else { 0 }
    $netPeer = if ($out.Contains('net_peer_port')) { [int]$out['net_peer_port'] } else { 0 }
    if ($out.Contains('net') -and $out['net'] -eq '1' -and (!$netListen -or !$netPeer)) { throw 'lab.ini net=1 needs net_listen_port and net_peer_port.' }
    if ($netListen -and $netListen -eq $netPeer) { throw 'net_listen_port and net_peer_port must differ.' }
    if ($out.Contains('partner_interp_max_ms')) {
        $min = 60
        if ($out.Contains('partner_interp_min_ms')) { $min = [int]$out['partner_interp_min_ms'] }
        if ([int]$out['partner_interp_max_ms'] -lt $min) { throw "partner_interp_max_ms must be at least partner_interp_min_ms ($min)." }
    }
    foreach ($port in @($netListen, $netPeer)) {
        if ($port -and ($port -eq $ListenPort -or $port -eq $PeerPort)) { throw "Partner net port $port collides with listen_port/peer_port." }
    }
    return $out
}

function ConvertFrom-LabPartnerJson {
    # Pure: lab.json "partner" (short names such as stage, or the lab.ini key names)
    # -> lab.ini key dictionary. The ports come from lab.json ports, not from here;
    # a "comment" member is documentation and ignored.
    param([AllowNull()]$Partner)
    $out = [ordered]@{}
    if ($null -eq $Partner) { return $out }
    $names = if ($Partner -is [Collections.IDictionary]) { @($Partner.Keys) } else { @($Partner.PSObject.Properties.Name) }
    foreach ($name in $names) {
        if ($name -ceq 'comment') { continue }
        $spec = $null
        foreach ($candidate in $script:LabPartnerKeys) { if ($candidate.Key -ceq $name -or ($candidate.Json -and $candidate.Json -ceq $name)) { $spec = $candidate; break } }
        if (!$spec) { throw "Unknown lab.json partner setting: $name" }
        if ($spec.Kind -eq 'port') { throw "lab.json partner.${name}: set ports.netHost / ports.netGuest instead." }
        if ($spec.Kind -in @('bind', 'ipv4')) { throw "lab.json partner.${name}: set by Prepare-LabInstance -Lan, not lab.json." }
        $value = if ($Partner -is [Collections.IDictionary]) { $Partner[$name] } else { $Partner.PSObject.Properties[$name].Value }
        $out[$spec.Key] = $value
    }
    return $out
}

function ConvertFrom-LabCharacterArgs {
    # Pure: Prepare-LabInstance -Character items for one role (offline lab only).
    # 'name' applies to both roles, 'host:name' / 'guest:name' to one; name is one
    # of the lab characters. Later items win. $null when no item applies, so
    # lab.json offline.characters stays in force (for example -Character default
    # for a regression rerun of the proven E-series without the Quiet guest).
    param([string[]]$Items = @(), [Parameter(Mandatory)][ValidateSet('host', 'guest')][string]$Role)
    $out = $null
    foreach ($item in @($Items | Where-Object { $_ } | ForEach-Object { $_ -split ',' } | Where-Object { $_.Trim() })) {
        $text = $item.Trim()
        if ($text -cnotmatch '^(?:(host|guest):)?([a-z_]+)$') { throw "Invalid -Character '$text' (name, host:name or guest:name)." }
        $target = $Matches[1]
        $name = $Matches[2]
        if ($name -cnotin $script:LabCharacters) { throw "Invalid -Character '$text': one of $($script:LabCharacters -join ', ')." }
        if (!$target -or $target -ceq $Role) { $out = $name }
    }
    return $out
}

function ConvertFrom-LabPartnerSettingArgs {
    # Pure: Prepare-LabInstance -PartnerSetting items for one role. 'key=value'
    # applies to both roles, 'host:key=value' / 'guest:key=value' to one; key is a
    # lab.ini partner/net key (the ports stay in lab.json). Later items win. A
    # comma separates items only where a new key= follows, so a value may
    # contain commas (partner_dm_map=0,10,11,...).
    param([string[]]$Items = @(), [Parameter(Mandatory)][ValidateSet('host', 'guest')][string]$Role)
    $out = [ordered]@{}
    foreach ($item in @($Items | Where-Object { $_ } | ForEach-Object { $_ -split ',(?=\s*(?:(?:host|guest):)?[a-z_]+=)' } | Where-Object { $_.Trim() })) {
        $text = $item.Trim()
        if ($text -cnotmatch '^(?:(host|guest):)?([a-z_]+)=(.+)$') { throw "Invalid -PartnerSetting '$text' (key=value, host:key=value or guest:key=value)." }
        $target = $Matches[1]
        $key = $Matches[2]
        $value = $Matches[3]
        $spec = Get-LabPartnerKeySpec -Key $key
        if (!$spec) { throw "Unknown partner lab.ini key in -PartnerSetting: $key" }
        if ($spec.Kind -eq 'port') { throw "-PartnerSetting cannot change $key; set ports.netHost / ports.netGuest in lab.json." }
        if ($spec.Kind -in @('bind', 'ipv4')) { throw "-PartnerSetting cannot change $key; use Prepare-LabInstance -Lan." }
        $canonical = ConvertTo-LabPartnerValue -Key $key -Value $value
        if (!$target -or $target -ceq $Role) { $out[$key] = $canonical }
    }
    return $out
}

function New-LabIniText {
    param(
        [Parameter(Mandatory)][ValidateSet('host', 'guest')][string]$Role,
        [Parameter(Mandatory)][string]$SelfSteamId,          # 'real' or SteamID64
        [string]$SelfName = '',
        [string]$PeerSteamId = 'learn',                      # 'learn' or SteamID64
        [Parameter(Mandatory)][int]$ListenPort,
        [Parameter(Mandatory)][int]$PeerPort,
        [string]$MutexSuffix = '',
        [Parameter(Mandatory)][string]$SaveDir,
        [string]$XInput = 'passthrough',
        [bool]$Loopback = $true,
        [bool]$JoinTrigger = $true,
        [int]$AutoJoinDelaySec = 0,
        # Offline lab mode (docs/offline-partner-spike-plan.md 4): header wording only.
        [switch]$Offline,
        # Partner/net keys (exact lab.ini names, see $script:LabPartnerKeys); none = no extra lines.
        [Collections.IDictionary]$Partner = $null
    )
    if ($SelfSteamId -ne 'real' -and !(Test-IndividualSteamId64 $SelfSteamId)) { throw "Invalid self_steamid: $SelfSteamId" }
    if ($PeerSteamId -ne 'learn' -and !(Test-IndividualSteamId64 $PeerSteamId)) { throw "Invalid peer_steamid: $PeerSteamId" }
    foreach ($port in $ListenPort, $PeerPort) { if ($port -lt 1024 -or $port -gt 65535) { throw "Invalid lab port: $port" } }
    if ($ListenPort -eq $PeerPort) { throw 'listen_port and peer_port must differ.' }
    if ($MutexSuffix -cnotmatch '^[A-Za-z0-9_-]{0,31}$') { throw "Invalid mutex_suffix: $MutexSuffix" }
    if ($SelfName.Length -ge 64 -or $SelfName -match '[\x00-\x1f\x7f]' -or $SelfName -ne $SelfName.Trim()) { throw 'Invalid self_name.' }
    if (!(Test-AbsoluteWindowsPath $SaveDir) -or [Text.Encoding]::UTF8.GetByteCount($SaveDir) -ge 260 -or $SaveDir -match '[\x00-\x1f]' -or $SaveDir -ne $SaveDir.Trim()) {
        throw "save_dir must be an absolute path shorter than 260 bytes: $SaveDir"
    }
    if ($XInput -cnotmatch '^(passthrough|none|[0-3])$') { throw "Invalid xinput: $XInput" }
    if ($AutoJoinDelaySec -lt 0 -or $AutoJoinDelaySec -gt 3600) { throw 'auto_join_delay_s must be 0..3600.' }
    $partnerValues = ConvertTo-LabPartnerIni -Values $Partner -ListenPort $ListenPort -PeerPort $PeerPort
    $lines = [Collections.Generic.List[string]]::new()
    $lines.Add($script:LabIniHeader + ' - single-PC lab harness only (docs/lab-protocol.md).')
    if ($Offline) {
        $lines.Add('# Offline lab mode: lab mode stays on while this file exists. The lab coop.ini next to it')
        $lines.Add('# ALSO points the master server at a closed local port (no server), even without this file.')
        $lines.Add('# Switch both off (and restore your previous files) with: pwsh -File tools/lab/Prepare-LabInstance.ps1 -Disable')
    } else {
        $lines.Add('# Lab mode stays on while this file exists. The lab coop.ini next to it ALSO points the')
        $lines.Add('# master server at the local fuse, even without this file. Switch both off (and restore')
        $lines.Add('# your previous files) with: pwsh -File tools/lab/Prepare-LabInstance.ps1 -Disable')
    }
    $lines.Add('enabled=1')
    $lines.Add("role=$Role")
    $lines.Add('loopback=' + ([int]$Loopback))
    $lines.Add("self_steamid=$SelfSteamId")
    if ($SelfName) { $lines.Add("self_name=$SelfName") }
    $lines.Add("peer_steamid=$PeerSteamId")
    $lines.Add("listen_port=$ListenPort")
    $lines.Add("peer_port=$PeerPort")
    if ($MutexSuffix) { $lines.Add("mutex_suffix=$MutexSuffix") }
    $lines.Add("save_dir=$SaveDir")
    $lines.Add("xinput=$XInput")
    $lines.Add('join_trigger=' + ([int]$JoinTrigger))
    if ($AutoJoinDelaySec) { $lines.Add("auto_join_delay_s=$AutoJoinDelaySec") }
    if ($partnerValues.Count) {
        $lines.Add('# Offline partner spike (docs/offline-partner-spike-plan.md 2.1); inert unless the marker is offline-v1.')
        foreach ($key in $partnerValues.Keys) { $lines.Add($key + '=' + $partnerValues[$key]) }
    }
    return ($lines -join "`n") + "`n"
}

function New-CoopIniText {
    param(
        [Parameter(Mandatory)][string]$MasterUrl,
        [string]$Character = 'default',
        [string]$CharacterFallback = 'dd_male',
        # Offline lab mode: master_url must be a closed 127.0.0.1 port (comment wording differs).
        [switch]$Offline
    )
    if (!(Test-LabUrl $MasterUrl)) { throw "Invalid master_url (http(s)://host/tppstm/gate, <= 69 chars): $MasterUrl" }
    if ($Offline -and $MasterUrl -cnotmatch '^http://127\.0\.0\.1:[0-9]{4,5}/tppstm/gate$') { throw "Offline master_url must be http://127.0.0.1:<closed port>/tppstm/gate: $MasterUrl" }
    if ($Character -cnotin $script:LabCharacters) { throw "Invalid character: $Character" }
    if ($CharacterFallback -cnotin @('dd_male', 'dd_female', 'snake', 'avatar')) { throw "Invalid character_fallback: $CharacterFallback" }
    $purpose = if ($Offline) { '# master_url points this game at a closed local port (offline lab mode: no server is reached) and applies even without lab.ini.' }
    else { '# master_url sends this game to the lab''s local fuse and applies even without lab.ini.' }
    return (@(
            ($script:LabIniHeader + '. Player options (docs/lab-protocol.md).'),
            $purpose,
            '# Before normal online play run: pwsh -File tools/lab/Prepare-LabInstance.ps1 -Disable',
            '# (it renames this file and restores your previous coop.ini, if there was one).',
            "master_url=$MasterUrl",
            "character=$Character",
            "character_fallback=$CharacterFallback"
        ) -join "`n") + "`n"
}

function Test-LabGeneratedText {
    # True when an ini file was written by these scripts (safe to disable/replace).
    param([AllowEmptyString()][string]$Text)
    return [bool]$Text -and $Text.StartsWith($script:LabIniHeader, [StringComparison]::Ordinal)
}

function Select-NewestUserBackup {
    # Pure: the newest "<FileName>.user-<yyyyMMdd-HHmmss>" name among $Candidates
    # (Prepare-LabInstance keeps a user's own lab.ini/coop.ini under that name), or $null.
    param([Parameter(Mandatory)][string]$FileName, [string[]]$Candidates = @())
    $pattern = '^' + [regex]::Escape($FileName) + '\.user-([0-9]{8}-[0-9]{6})$'
    $best = $null
    $bestStamp = ''
    foreach ($candidate in @($Candidates)) {
        if ($candidate -cmatch $pattern -and [string]::CompareOrdinal($Matches[1], $bestStamp) -gt 0) {
            $best = $candidate
            $bestStamp = $Matches[1]
        }
    }
    return $best
}

function Get-LabDisabledMarker {
    # Pure: return the archive action for the lab's offline-v1 marker, or $null
    # to preserve an explicit marker selected separately. Removing the active
    # offline marker leaves the native loader in pass-through mode; replacing
    # it with host-v3/client-v1 would enable legacy sessions without lab.ini.
    param([Parameter(Mandatory)][ValidateSet('host', 'guest')][string]$Role, [AllowNull()][AllowEmptyString()][string]$Marker)
    if ($null -eq $Marker -or $Marker.Trim() -cne 'offline-v1') { return $null }
    return 'archive'
}

function Get-LabOfflineExpectation {
    # Pure: offline lab mode (docs/offline-partner-spike-plan.md 2.5, 4) values for one
    # role: the marker (both roles), the master URL on a closed 127.0.0.1 port
    # (lab.json offline.masterPort, default 47899), the partner UDP ports
    # (ports.netHost/netGuest, default 47820/47821; the guest's are swapped) and
    # the coop.ini character (offline.characters, default 'default' on both: the
    # fuse lab's top-level characters stay untouched). -Lan (one-PC LAN rehearsal,
    # docs/two-pc-play.md): both instances bind all addresses (net_bind=any) and
    # the guest targets the host's LAN IPv4 (net_peer_addr); the ports are unchanged.
    param([Parameter(Mandatory)][ValidateSet('host', 'guest')][string]$Role, [Parameter(Mandatory)]$Config, [switch]$Lan)
    $offline = Get-ConfigValue $Config 'Offline' $null
    $masterPort = [int](Get-ConfigValue $offline 'masterPort' 47899)
    $netHost = [int](Get-ConfigValue $Config.Ports 'netHost' 47820)
    $netGuest = [int](Get-ConfigValue $Config.Ports 'netGuest' 47821)
    $listen = if ($Role -eq 'host') { $netHost } else { $netGuest }
    $peer = if ($Role -eq 'host') { $netGuest } else { $netHost }
    [pscustomobject]@{
        Role = $Role; Marker = [string](Get-ConfigValue $offline 'marker' 'offline-v1'); MasterPort = $masterPort
        MasterUrl = 'http://127.0.0.1:' + $masterPort + '/tppstm/gate'; NetListenPort = $listen; NetPeerPort = $peer
        Character = [string](Get-ConfigValue (Get-ConfigValue $offline 'characters' $null) $Role 'default')
        Lan = [bool]$Lan
    }
}

function Get-LabInstanceSettings {
    # Lab defaults (docs/lab-protocol.md) for one role. Pure given its inputs.
    # -Offline: offline lab mode (docs/offline-partner-spike-plan.md 2.5, 4): marker
    # offline-v1 on both roles, master URL on a closed local port, partner/net
    # lab.ini keys from lab.json "partner" plus -PartnerOverrides (lab.ini key names).
    param(
        [Parameter(Mandatory)][ValidateSet('host', 'guest')][string]$Role,
        [Parameter(Mandatory)]$Config,
        [Parameter(Mandatory)][string]$GameDirectory,
        [Parameter(Mandatory)][string]$HostSteamId64,
        [switch]$Offline,
        [Collections.IDictionary]$PartnerOverrides = $null,
        # Offline only: replaces lab.json offline.characters.<role> for this preparation.
        [string]$CharacterOverride = $null,
        # Offline only: one-PC LAN rehearsal (net_bind=any; the guest targets $LanAddress).
        [switch]$Lan,
        [string]$LanAddress = '',
        # Offline only: a lab.json wanSim preset (impairment keys, net_seed 1/2, partner_interp=auto).
        [string]$WanSim = 'off'
    )
    if (!(Test-IndividualSteamId64 $HostSteamId64)) { throw 'Host SteamID64 is not a valid individual SteamID64.' }
    if (!$Offline -and $PartnerOverrides -and $PartnerOverrides.Count) { throw 'Partner settings apply only to the offline lab mode (-Offline).' }
    if (!$Offline -and $CharacterOverride) { throw 'A character override applies only to the offline lab mode (-Offline).' }
    if ($CharacterOverride -and $CharacterOverride -cnotin $script:LabCharacters) { throw "Invalid character override: $CharacterOverride" }
    if (!$WanSim) { $WanSim = 'off' }
    if (!$Offline -and ($Lan -or $WanSim -cne 'off')) { throw '-Lan and -WanSim apply only to the offline lab mode (-Offline).' }
    if ($Lan -and !(Test-CoopPlayPeerAddress $LanAddress)) { throw "-Lan needs this PC's LAN IPv4 address (got '$LanAddress')." }
    if (!$Lan -and $LanAddress) { throw '-LanAddress applies only with -Lan.' }
    $saveDir = (Get-InstancePaths -GameDirectory $GameDirectory).SaveDir
    $guestId = [string](Get-ConfigValue $Config.Identity 'guestSteamId' '76561202255233008')
    if (!(Test-IndividualSteamId64 $guestId)) { throw 'lab.json identity.guestSteamId is not a valid individual SteamID64.' }
    if ($guestId -eq $HostSteamId64) { throw 'The guest lab SteamID must differ from the host SteamID.' }
    $fuseUrl = 'http://127.0.0.1:' + [int]$Config.Ports.fuse + '/tppstm/gate'
    if ($Role -eq 'host') {
        $peer = if ([string](Get-ConfigValue $Config.Identity 'hostPeerSteamId' 'guest') -eq 'learn') { 'learn' } else { $guestId }
        $settings = [pscustomobject]@{
            Role = 'host'; SelfSteamId = 'real'; SelfName = ''; PeerSteamId = $peer
            ListenPort = [int]$Config.Ports.host; PeerPort = [int]$Config.Ports.guest; MutexSuffix = ''
            SaveDir = $saveDir; XInput = [string](Get-ConfigValue $Config.XInput 'host' 'passthrough'); Marker = 'host-v3'
            MasterUrl = $fuseUrl; Character = [string](Get-ConfigValue $Config.Characters 'host' 'default'); ClientHost = $null
            Offline = $false; Partner = $null
        }
    } else {
        $settings = [pscustomobject]@{
            Role = 'guest'; SelfSteamId = $guestId; SelfName = [string](Get-ConfigValue $Config.Identity 'guestName' 'Guest'); PeerSteamId = $HostSteamId64
            ListenPort = [int]$Config.Ports.guest; PeerPort = [int]$Config.Ports.host; MutexSuffix = '-guest'
            SaveDir = $saveDir; XInput = [string](Get-ConfigValue $Config.XInput 'guest' 'passthrough'); Marker = 'client-v1'
            MasterUrl = $fuseUrl; Character = [string](Get-ConfigValue $Config.Characters 'guest' 'default'); ClientHost = $HostSteamId64
            Offline = $false; Partner = $null
        }
    }
    if ($Offline) {
        $expect = Get-LabOfflineExpectation -Role $Role -Config $Config -Lan:$Lan
        $merged = [ordered]@{}
        foreach ($key in $script:LabPartnerDefaults.Keys) { $merged[$key] = $script:LabPartnerDefaults[$key] }
        $fromJson = ConvertFrom-LabPartnerJson -Partner (Get-ConfigValue $Config 'Partner' $null)
        foreach ($key in $fromJson.Keys) { $merged[$key] = $fromJson[$key] }
        if ($WanSim -cne 'off') {
            # Each instance impairs its own outbound datagrams (RTT ~ 2x latency).
            $preset = Get-LabWanSimPreset -WanSim (Get-ConfigValue $Config 'WanSim' $null) -Name $WanSim
            foreach ($key in $preset.Keys) { $merged[$key] = $preset[$key] }
            $merged['net_seed'] = if ($Role -eq 'host') { '1' } else { '2' }
            $merged['partner_interp'] = 'auto'
        }
        if ($PartnerOverrides) { foreach ($key in $PartnerOverrides.Keys) { $merged[[string]$key] = $PartnerOverrides[$key] } }
        if ($Lan) {
            $merged['net_bind'] = 'any'
            if ($Role -eq 'guest') { $merged['net_peer_addr'] = $LanAddress }
        }
        $merged['net_listen_port'] = $expect.NetListenPort
        $merged['net_peer_port'] = $expect.NetPeerPort
        $settings.Partner = ConvertTo-LabPartnerIni -Values $merged -ListenPort $settings.ListenPort -PeerPort $settings.PeerPort
        $settings.Marker = $expect.Marker
        $settings.MasterUrl = $expect.MasterUrl
        $settings.Character = if ($CharacterOverride) { $CharacterOverride } else { $expect.Character }
        $settings.Offline = $true
    }
    $settings | Add-Member -NotePropertyName Lan -NotePropertyValue ([bool]$Lan)
    $settings | Add-Member -NotePropertyName WanSim -NotePropertyValue $WanSim
    return $settings
}

function New-LabIniFromSettings {
    param([Parameter(Mandatory)]$Settings)
    if ([bool](Get-ConfigValue $Settings 'Offline' $false)) {
        return New-LabIniText -Role $Settings.Role -SelfSteamId $Settings.SelfSteamId -SelfName $Settings.SelfName `
            -PeerSteamId $Settings.PeerSteamId -ListenPort $Settings.ListenPort -PeerPort $Settings.PeerPort `
            -MutexSuffix $Settings.MutexSuffix -SaveDir $Settings.SaveDir -XInput $Settings.XInput `
            -Offline -Partner $Settings.Partner
    }
    New-LabIniText -Role $Settings.Role -SelfSteamId $Settings.SelfSteamId -SelfName $Settings.SelfName `
        -PeerSteamId $Settings.PeerSteamId -ListenPort $Settings.ListenPort -PeerPort $Settings.PeerPort `
        -MutexSuffix $Settings.MutexSuffix -SaveDir $Settings.SaveDir -XInput $Settings.XInput
}

function Get-LabOfflineIniProblems {
    # Pure: what Start-Lab -Offline requires of one instance's lab.ini (parsed with
    # ConvertFrom-IniText) beyond the shared checks: net=1, partner=1, the role's
    # partner ports and valid values for every partner/net key that is present.
    # With Expectation.Lan: net_bind=any on both and a guest net_peer_addr;
    # without it: no non-loopback bind (a -Lan preparation needs Start-Lab -Lan).
    param([Parameter(Mandatory)][ValidateSet('host', 'guest')][string]$Role, [AllowNull()]$Lab, [Parameter(Mandatory)]$Expectation)
    $problems = [Collections.Generic.List[string]]::new()
    if ($null -eq $Lab) { return }  # a missing lab.ini is reported by the shared checks
    if ([string](Get-ConfigValue $Lab 'net' '') -cne '1') { $problems.Add("[$Role] lab.ini net is not 1 (the offline partner transport).") }
    if ([string](Get-ConfigValue $Lab 'partner' '') -cne '1') { $problems.Add("[$Role] lab.ini partner is not 1.") }
    if ([string](Get-ConfigValue $Lab 'net_listen_port' '') -cne [string]$Expectation.NetListenPort -or
        [string](Get-ConfigValue $Lab 'net_peer_port' '') -cne [string]$Expectation.NetPeerPort) {
        $problems.Add("[$Role] lab.ini net_listen_port/net_peer_port are not $($Expectation.NetListenPort)/$($Expectation.NetPeerPort) (lab.json ports.netHost/netGuest).")
    }
    $bind = [string](Get-ConfigValue $Lab 'net_bind' 'loopback')
    if ([bool](Get-ConfigValue $Expectation 'Lan' $false)) {
        if ($bind -cne 'any') { $problems.Add("[$Role] lab.ini net_bind is not any (run Prepare-LabInstance.ps1 -Offline -Lan).") }
        if ($Role -eq 'guest' -and !(Get-ConfigValue $Lab 'net_peer_addr' $null)) { $problems.Add('[guest] lab.ini has no net_peer_addr (the host''s LAN address; run Prepare-LabInstance.ps1 -Offline -Lan).') }
    } elseif ($bind -cne 'loopback') { $problems.Add("[$Role] lab.ini net_bind=$bind was prepared with -Lan; start with -Lan or prepare again without it.") }
    foreach ($spec in $script:LabPartnerKeys) {
        $value = Get-ConfigValue $Lab $spec.Key $null
        if ($null -eq $value) { continue }
        try { $null = ConvertTo-LabPartnerValue -Key $spec.Key -Value $value } catch { $problems.Add("[$Role] $($_.Exception.Message)") }
    }
    return $problems.ToArray()  # callers wrap in @()
}

# ---------------------------------------------------------------------------
# TPP_GRAPHICS_CONFIG (lab copies only)
# ---------------------------------------------------------------------------
# Static analysis of mgsvtpp.exe 1.0.15.4 (0x52BE40.., tag function 0x52D0E0)
# shows the "as" member is an integrity tag: the game removes "as", serialises
# the rest with jsoncpp's FastWriter (sorted keys, no spaces, trailing "\n"),
# appends "-%x" of that string's length, hashes it with CryptoAPI MD5
# (CALG_MD5) and stores base64 of the first 8 digest bytes. Reproduced exactly
# against a real file before relying on it; the lab refuses to edit a file whose
# existing tag does not verify with this algorithm.

function ConvertTo-JsonCppFastText {
    # jsoncpp FastWriter output for the value types TPP_GRAPHICS_CONFIG uses.
    param([AllowNull()]$Value, [switch]$Document)
    $text = if ($null -eq $Value) { 'null' }
    elseif ($Value -is [bool]) { if ($Value) { 'true' } else { 'false' } }
    elseif ($Value -is [string]) {
        $sb = [Text.StringBuilder]::new('"')
        foreach ($ch in $Value.ToCharArray()) {
            $code = [int]$ch
            if ($code -gt 0x7e) { throw 'Non-ASCII text is not supported in the graphics config.' }
            switch ($ch) {
                '"' { $null = $sb.Append('\"') }
                '\' { $null = $sb.Append('\\') }
                "`b" { $null = $sb.Append('\b') }
                "`f" { $null = $sb.Append('\f') }
                "`n" { $null = $sb.Append('\n') }
                "`r" { $null = $sb.Append('\r') }
                "`t" { $null = $sb.Append('\t') }
                default {
                    if ($code -lt 0x20) { $null = $sb.Append('\u' + $code.ToString('x4')) } else { $null = $sb.Append($ch) }
                }
            }
        }
        $sb.Append('"').ToString()
    }
    elseif ($Value -is [int] -or $Value -is [long] -or $Value -is [int16] -or $Value -is [byte] -or $Value -is [uint32] -or $Value -is [uint64]) {
        ([long]$Value).ToString([Globalization.CultureInfo]::InvariantCulture)
    }
    elseif ($Value -is [double] -or $Value -is [decimal] -or $Value -is [single]) { throw 'Floating-point values are not supported in the graphics config.' }
    elseif ($Value -is [Collections.IDictionary] -or $Value -is [Management.Automation.PSCustomObject]) {
        $names = if ($Value -is [Collections.IDictionary]) { @($Value.Keys | ForEach-Object { [string]$_ }) } else { @($Value.PSObject.Properties.Name) }
        foreach ($n in $names) { if ($n -match '[^\x20-\x7e]') { throw 'Non-ASCII keys are not supported.' } }
        [Array]::Sort($names, [StringComparer]::Ordinal)
        $parts = foreach ($n in $names) {
            $item = if ($Value -is [Collections.IDictionary]) { $Value[$n] } else { $Value.PSObject.Properties[$n].Value }
            (ConvertTo-JsonCppFastText -Value $n) + ':' + (ConvertTo-JsonCppFastText -Value $item)
        }
        '{' + (@($parts) -join ',') + '}'
    }
    elseif ($Value -is [Collections.IEnumerable]) {
        '[' + (@($Value | ForEach-Object { ConvertTo-JsonCppFastText -Value $_ }) -join ',') + ']'
    }
    else { throw "Unsupported JSON value type: $($Value.GetType().FullName)" }
    if ($Document) { return $text + "`n" }
    return $text
}

function Get-GraphicsConfigTag {
    # The tag the game expects for a parsed config object (the "as" member is ignored).
    param([Parameter(Mandatory)]$Object)
    $copy = [ordered]@{}
    foreach ($p in $Object.PSObject.Properties) { if ($p.Name -cne 'as') { $copy[$p.Name] = $p.Value } }
    $serial = ConvertTo-JsonCppFastText -Value $copy -Document
    $bytes = [Text.Encoding]::ASCII.GetBytes($serial + '-' + $serial.Length.ToString('x'))
    $digest = [Security.Cryptography.MD5]::HashData($bytes)
    return [Convert]::ToBase64String($digest, 0, 8)
}

function Get-GraphicsConfigInfo {
    # Pure: parses config text; Valid = the stored tag matches the computed one.
    param([Parameter(Mandatory)][AllowEmptyString()][string]$Text)
    $info = [ordered]@{ Valid = $false; StoredTag = $null; ComputedTag = $null; WindowMode = $null; Width = 0; Height = 0; Error = $null }
    try {
        $object = $Text | ConvertFrom-Json
        $info.StoredTag = [string](Get-ConfigValue $object 'as' '')
        $info.ComputedTag = Get-GraphicsConfigTag -Object $object
        $video = $object.graphics.videoout_setting
        $info.WindowMode = [string]$video.window_mode
        $info.Width = [int]$video.width
        $info.Height = [int]$video.height
        $info.Valid = [bool]$info.StoredTag -and $info.StoredTag -ceq $info.ComputedTag
    } catch { $info.Error = $_.Exception.Message }
    return [pscustomobject]$info
}

function Set-GraphicsConfigWindowedText {
    # Pure: returns the config text with the requested window mode and size and a
    # recomputed tag. Edits values in place (formatting is preserved) and refuses
    # unless the input tag verifies and every edited key occurs exactly once.
    param(
        [Parameter(Mandatory)][string]$Text,
        [int]$Width = 1280,
        [int]$Height = 720,
        [ValidateSet('Windowed', 'FlexibleWindowed', 'FullScreenWindowed', 'FullScreen')][string]$WindowMode = 'Windowed'
    )
    if ($Width -lt 640 -or $Width -gt 7680 -or $Height -lt 480 -or $Height -gt 4320) { throw 'Unsupported window size.' }
    $before = Get-GraphicsConfigInfo -Text $Text
    if (!$before.Valid) { throw ('TPP_GRAPHICS_CONFIG tag does not verify; refusing to edit. ' + $before.Error) }
    $edits = @(
        @{ Pattern = '("window_mode"\s*:\s*")[A-Za-z]+(")'; Value = $WindowMode },
        @{ Pattern = '("width"\s*:\s*)[0-9]+()'; Value = [string]$Width },
        @{ Pattern = '("height"\s*:\s*)[0-9]+()'; Value = [string]$Height }
    )
    $result = $Text
    foreach ($edit in $edits) {
        $count = [regex]::Matches($result, $edit.Pattern).Count
        if ($count -ne 1) { throw "TPP_GRAPHICS_CONFIG has an unexpected layout ($count matches for $($edit.Pattern))." }
        $value = $edit.Value
        $result = [regex]::Replace($result, $edit.Pattern, { param($m) $m.Groups[1].Value + $value + $m.Groups[2].Value })
    }
    $object = $result | ConvertFrom-Json
    $tag = Get-GraphicsConfigTag -Object $object
    $asPattern = '("as"\s*:\s*")[A-Za-z0-9+/=]+(")'
    if ([regex]::Matches($result, $asPattern).Count -ne 1) { throw 'TPP_GRAPHICS_CONFIG has an unexpected "as" layout.' }
    $result = [regex]::Replace($result, $asPattern, { param($m) $m.Groups[1].Value + $tag + $m.Groups[2].Value })
    $after = Get-GraphicsConfigInfo -Text $result
    if (!$after.Valid -or $after.WindowMode -cne $WindowMode -or $after.Width -ne $Width -or $after.Height -ne $Height) {
        throw 'Internal error: edited TPP_GRAPHICS_CONFIG does not verify.'
    }
    return $result
}

