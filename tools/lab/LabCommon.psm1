# Shared helpers for the single-PC co-op lab (tools/lab/*.ps1).
# Pure helpers (no side effects) are unit tested by tests/lab_scripts_tests.ps1.
# Nothing in this module launches the game, Steam or fuse by itself, and no
# helper writes below Steam\userdata (the real saves are only ever read).
Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

$script:SteamId64Base = [UInt64]76561197960265728
$script:Utf8NoBom = [Text.UTF8Encoding]::new($false)
$script:LabIniHeader = '# Generated by tools/lab/Prepare-LabInstance.ps1'

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

function Get-LabRepoRoot {
    (Resolve-Path -LiteralPath (Join-Path $PSScriptRoot '../..')).Path
}

function Resolve-LabPath {
    # Absolute paths are kept; relative paths resolve against the repository root.
    param([Parameter(Mandatory)][string]$Path, [Parameter(Mandatory)][string]$RepoRoot)
    if ([IO.Path]::IsPathRooted($Path)) { return [IO.Path]::GetFullPath($Path).TrimEnd('\', '/') }
    return [IO.Path]::GetFullPath((Join-Path $RepoRoot $Path)).TrimEnd('\', '/')
}

function Get-ConfigValue {
    # StrictMode-safe optional property read with a default.
    param($Object, [Parameter(Mandatory)][string]$Name, $Default = $null)
    if ($null -eq $Object) { return $Default }
    if ($Object -is [Collections.IDictionary]) { if ($Object.Contains($Name)) { return $Object[$Name] } else { return $Default } }
    $property = $Object.PSObject.Properties[$Name]
    if ($property -and $null -ne $property.Value) { return $property.Value }
    return $Default
}

function Get-LabConfig {
    # Loads lab.json and returns it with every path resolved to an absolute path.
    param([string]$ConfigPath = (Join-Path $PSScriptRoot 'lab.json'), [string]$RepoRoot)
    if (!$RepoRoot) { $RepoRoot = Get-LabRepoRoot }
    $raw = Get-Content -LiteralPath $ConfigPath -Raw | ConvertFrom-Json
    if ((Get-ConfigValue $raw 'schema' 0) -ne 1) { throw "Unsupported lab.json schema in $ConfigPath" }
    $paths = [ordered]@{ repo = $RepoRoot }
    foreach ($name in 'hostDir', 'guestDir', 'fuseSource', 'fuseExe', 'runDir', 'loader', 'runtimeArchive') {
        $value = Get-ConfigValue $raw.paths $name
        if (!$value) { throw "lab.json paths.$name is missing" }
        $paths[$name] = Resolve-LabPath -Path $value -RepoRoot $RepoRoot
    }
    # Optional: Steam root (default: HKCU\Software\Valve\Steam SteamPath). Fixture tests set it.
    $steamRoot = Get-ConfigValue $raw.paths 'steamRoot' $null
    $paths['steamRoot'] = if ($steamRoot) { Resolve-LabPath -Path $steamRoot -RepoRoot $RepoRoot } else { $null }
    foreach ($port in 'fuse', 'host', 'guest') {
        $value = [int](Get-ConfigValue $raw.ports $port 0)
        if ($value -lt 1024 -or $value -gt 65535) { throw "lab.json ports.$port must be 1024..65535" }
    }
    [pscustomobject]@{
        Path       = (Resolve-Path -LiteralPath $ConfigPath).Path
        Paths      = [pscustomobject]$paths
        Hashes     = $raw.hashes
        Ports      = $raw.ports
        Identity   = $raw.identity
        Characters = $raw.characters
        XInput     = $raw.xinput
        Saves      = $raw.saves
        Window     = $raw.window
        Smoke      = Get-ConfigValue $raw 'smoke' ([pscustomobject]@{})
        Fuse       = Get-ConfigValue $raw 'fuse' ([pscustomobject]@{})
        Graphics   = Get-ConfigValue $raw 'graphics' ([pscustomobject]@{})
    }
}

function Get-ProjectVersion {
    param([Parameter(Mandatory)][string]$RepoRoot)
    $text = Get-Content -LiteralPath (Join-Path $RepoRoot 'CMakeLists.txt') -Raw
    if ($text -notmatch 'project\(mgs_coop VERSION ([0-9]+\.[0-9]+\.[0-9]+)') { throw 'Project version not found in CMakeLists.txt' }
    return $Matches[1]
}

function Get-InstancePaths {
    # Folder layout of one instance (docs/lab-protocol.md).
    param([Parameter(Mandatory)][string]$GameDirectory)
    $root = [IO.Path]::GetFullPath($GameDirectory).TrimEnd('\', '/')
    $mod = Join-Path $root 'mgs-coop'
    [pscustomobject]@{
        Game      = $root
        Exe       = Join-Path $root 'mgsvtpp.exe'
        SteamApi  = Join-Path $root 'steam_api64.dll'
        Loader    = Join-Path $root 'dinput8.dll'
        Mod       = $mod
        Record    = Join-Path $mod 'probe-install.json'
        Archive   = Join-Path $mod 'mgs-coop-player-runtime.dat'
        Marker    = Join-Path $mod 'script-observe.enabled'
        ClientHost = Join-Path $mod 'client-host.txt'
        LabIni    = Join-Path $mod 'lab.ini'
        CoopIni   = Join-Path $mod 'coop.ini'
        Status    = Join-Path $mod 'lab-status.json'
        HostId    = Join-Path $mod 'host-steamid.txt'
        JoinTrigger  = Join-Path $mod 'join.trigger'
        ResetTrigger = Join-Path $mod 'reset.trigger'
        SaveDir   = Join-Path $mod 'lab\saves'
    }
}

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------

function ConvertTo-SteamId64 {
    # Individual public-universe SteamID64 for a 32-bit account id.
    param([Parameter(Mandatory)][UInt64]$AccountId)
    if ($AccountId -eq 0 -or $AccountId -gt [UInt64]4294967295) { throw "Invalid Steam account id: $AccountId" }
    return [string]($script:SteamId64Base + $AccountId)
}

function Test-IndividualSteamId64 {
    param([AllowNull()][AllowEmptyString()][string]$Value)
    if ($null -eq $Value -or $Value -cnotmatch '^[0-9]{17}$') { return $false }
    [UInt64]$id = 0
    if (![UInt64]::TryParse($Value, [ref]$id)) { return $false }
    return (($id -shr 32) -eq 0x01100001) -and (($id % [UInt64]4294967296) -ne 0)
}

function Resolve-SteamAccount {
    # Chooses the Steam account whose saves seed the lab and whose SteamID the host uses.
    #  - a nonzero registry ActiveUser (Steam running and logged in) wins;
    #  - otherwise exactly one userdata account with MGSV saves; none or several = refuse.
    # Candidates: objects with Account (UInt32) and LastWriteUtc (DateTime).
    param([UInt32]$ActiveUser = 0, [object[]]$Candidates = @())
    if ($ActiveUser -ne 0) { return [UInt32]$ActiveUser }
    $list = @($Candidates | Where-Object { $_ -and $_.Account -ne 0 } | Sort-Object LastWriteUtc -Descending)
    if ($list.Count -eq 1) { return [UInt32]$list[0].Account }
    if ($list.Count -eq 0) { throw 'No Steam account with MGSV saves found (Steam ActiveUser is 0 and userdata has no 287700/local). Start Steam or pass -HostSteamId.' }
    throw ('Ambiguous Steam account (Steam is not running and ' + $list.Count + ' userdata accounts have MGSV saves). Start Steam and log in, or pass -HostSteamId.')
}

function Get-SteamInstallPath {
    $key = Get-ItemProperty -LiteralPath 'HKCU:\Software\Valve\Steam' -ErrorAction SilentlyContinue
    if (!$key -or !($key.PSObject.Properties.Name -contains 'SteamPath') -or !$key.SteamPath) { throw 'Steam path not found in HKCU:\Software\Valve\Steam (SteamPath).' }
    return [IO.Path]::GetFullPath($key.SteamPath).TrimEnd('\', '/')
}

function Get-SteamActiveUser {
    $key = Get-ItemProperty -LiteralPath 'HKCU:\Software\Valve\Steam\ActiveProcess' -ErrorAction SilentlyContinue
    if (!$key -or !($key.PSObject.Properties.Name -contains 'ActiveUser')) { return [UInt32]0 }
    return [UInt32]$key.ActiveUser
}

function Get-SteamSaveCandidates {
    param([Parameter(Mandatory)][string]$SteamPath)
    $userdata = Join-Path $SteamPath 'userdata'
    if (!(Test-Path -LiteralPath $userdata -PathType Container)) { return @() }
    $rows = foreach ($dir in Get-ChildItem -LiteralPath $userdata -Directory) {
        if ($dir.Name -cnotmatch '^[0-9]{1,10}$') { continue }
        $local = Join-Path $dir.FullName '287700/local'
        if (!(Test-Path -LiteralPath $local -PathType Container)) { continue }
        [pscustomobject]@{ Account = [UInt32]$dir.Name; LastWriteUtc = (Get-Item -LiteralPath $local).LastWriteTimeUtc }
    }
    return @($rows)
}

function Get-HostIdentity {
    # Returns the host's real Steam account, SteamID64 and userdata folder.
    # The SteamID64 is written only to local lab files, never to run logs.
    param([string]$OverrideSteamId, [string]$SteamPath)
    $steam = if ($SteamPath) { [IO.Path]::GetFullPath($SteamPath).TrimEnd([char]92, [char]47) } else { Get-SteamInstallPath }
    $source = 'registry_active_user'
    if ($OverrideSteamId -and $OverrideSteamId -ne 'auto') {
        if (!(Test-IndividualSteamId64 $OverrideSteamId)) { throw 'HostSteamId must be a 17-digit individual SteamID64.' }
        $account = [UInt32]([UInt64]$OverrideSteamId - $script:SteamId64Base)
        $source = 'parameter'
    } else {
        $active = if ($SteamPath) { [UInt32]0 } else { Get-SteamActiveUser }
        if ($active -eq 0) { $source = 'single_userdata_account' }
        $account = Resolve-SteamAccount -ActiveUser $active -Candidates (Get-SteamSaveCandidates -SteamPath $steam)
    }
    [pscustomobject]@{
        Account   = $account
        SteamId64 = ConvertTo-SteamId64 -AccountId $account
        SteamPath = $steam
        UserData  = Join-Path $steam ('userdata/' + $account)
        Source    = $source
    }
}

# ---------------------------------------------------------------------------
# lab.ini / coop.ini text (pure)
# ---------------------------------------------------------------------------

function Test-LabUrl {
    # Mirrors mgscoop::master_server::ValidateUrl and the coop.ini parser.
    param([AllowNull()][AllowEmptyString()][string]$Url)
    if (!$Url -or $Url.Length -gt 69) { return $false }
    if ($Url -cnotmatch '^https?://[\x21-\x7e]+$' -or $Url -match '["\\]') { return $false }
    if (!$Url.EndsWith('/tppstm/gate', [StringComparison]::Ordinal)) { return $false }
    $scheme = if ($Url.StartsWith('https://', [StringComparison]::Ordinal)) { 8 } else { 7 }
    return ($Url.Length - 12) -gt $scheme -and $Url[$scheme] -ne '/'
}

function Test-AbsoluteWindowsPath {
    param([string]$Path)
    return $Path -cmatch '^[A-Za-z]:[\\/]' -or $Path.StartsWith('\\')
}

function New-LabIniText {
    param(
        [Parameter(Mandatory)][ValidateSet('host', 'guest')][string]$Role,
        [Parameter(Mandatory)][string]$SelfSteamId,          # 'real' or SteamID64
        [string]$SelfName = '',
        [string]$PeerSteamId = 'learn',                      # 'learn' or SteamID64
        [Parameter(Mandatory)][int]$ListenPort,
        [Parameter(Mandatory)][int]$PeerPort,
        [string]$MutexSuffix = '',
        [Parameter(Mandatory)][string]$SaveDir,
        [string]$XInput = 'passthrough',
        [bool]$Loopback = $true,
        [bool]$JoinTrigger = $true,
        [int]$AutoJoinDelaySec = 0
    )
    if ($SelfSteamId -ne 'real' -and !(Test-IndividualSteamId64 $SelfSteamId)) { throw "Invalid self_steamid: $SelfSteamId" }
    if ($PeerSteamId -ne 'learn' -and !(Test-IndividualSteamId64 $PeerSteamId)) { throw "Invalid peer_steamid: $PeerSteamId" }
    foreach ($port in $ListenPort, $PeerPort) { if ($port -lt 1024 -or $port -gt 65535) { throw "Invalid lab port: $port" } }
    if ($ListenPort -eq $PeerPort) { throw 'listen_port and peer_port must differ.' }
    if ($MutexSuffix -cnotmatch '^[A-Za-z0-9_-]{0,31}$') { throw "Invalid mutex_suffix: $MutexSuffix" }
    if ($SelfName.Length -ge 64 -or $SelfName -match '[\x00-\x1f\x7f]' -or $SelfName -ne $SelfName.Trim()) { throw 'Invalid self_name.' }
    if (!(Test-AbsoluteWindowsPath $SaveDir) -or [Text.Encoding]::UTF8.GetByteCount($SaveDir) -ge 260 -or $SaveDir -match '[\x00-\x1f]' -or $SaveDir -ne $SaveDir.Trim()) {
        throw "save_dir must be an absolute path shorter than 260 bytes: $SaveDir"
    }
    if ($XInput -cnotmatch '^(passthrough|none|[0-3])$') { throw "Invalid xinput: $XInput" }
    if ($AutoJoinDelaySec -lt 0 -or $AutoJoinDelaySec -gt 3600) { throw 'auto_join_delay_s must be 0..3600.' }
    $lines = [Collections.Generic.List[string]]::new()
    $lines.Add($script:LabIniHeader + ' - single-PC lab harness only (docs/lab-protocol.md).')
    $lines.Add('# Delete this file (or run Prepare-LabInstance.ps1 -Disable) to return the loader to its normal behaviour.')
    $lines.Add('enabled=1')
    $lines.Add("role=$Role")
    $lines.Add('loopback=' + ([int]$Loopback))
    $lines.Add("self_steamid=$SelfSteamId")
    if ($SelfName) { $lines.Add("self_name=$SelfName") }
    $lines.Add("peer_steamid=$PeerSteamId")
    $lines.Add("listen_port=$ListenPort")
    $lines.Add("peer_port=$PeerPort")
    if ($MutexSuffix) { $lines.Add("mutex_suffix=$MutexSuffix") }
    $lines.Add("save_dir=$SaveDir")
    $lines.Add("xinput=$XInput")
    $lines.Add('join_trigger=' + ([int]$JoinTrigger))
    if ($AutoJoinDelaySec) { $lines.Add("auto_join_delay_s=$AutoJoinDelaySec") }
    return ($lines -join "`n") + "`n"
}

function New-CoopIniText {
    param(
        [Parameter(Mandatory)][string]$MasterUrl,
        [string]$Character = 'default',
        [string]$CharacterFallback = 'dd_male'
    )
    if (!(Test-LabUrl $MasterUrl)) { throw "Invalid master_url (http(s)://host/tppstm/gate, <= 69 chars): $MasterUrl" }
    if ($Character -cnotin @('default', 'snake', 'dd_male', 'dd_female', 'avatar', 'ocelot', 'quiet')) { throw "Invalid character: $Character" }
    if ($CharacterFallback -cnotin @('dd_male', 'dd_female', 'snake', 'avatar')) { throw "Invalid character_fallback: $CharacterFallback" }
    return (@(
            ($script:LabIniHeader + '. Player options (docs/lab-protocol.md).'),
            "master_url=$MasterUrl",
            "character=$Character",
            "character_fallback=$CharacterFallback"
        ) -join "`n") + "`n"
}

function Test-LabGeneratedText {
    # True when an ini file was written by these scripts (safe to disable/replace).
    param([AllowEmptyString()][string]$Text)
    return [bool]$Text -and $Text.StartsWith($script:LabIniHeader, [StringComparison]::Ordinal)
}

function ConvertFrom-IniText {
    # key=value lines, '#'/';' comments, trimmed; later keys win. Pure.
    param([AllowEmptyString()][string]$Text)
    $result = [ordered]@{}
    if (!$Text) { return $result }
    foreach ($line in ($Text.TrimStart([char]0xFEFF) -split "`n")) {
        $trimmed = $line.Trim()
        if (!$trimmed -or $trimmed.StartsWith('#') -or $trimmed.StartsWith(';')) { continue }
        $equals = $trimmed.IndexOf('=')
        if ($equals -lt 1) { continue }
        $result[$trimmed.Substring(0, $equals).Trim()] = $trimmed.Substring($equals + 1).Trim()
    }
    return $result
}

function Get-LabInstanceSettings {
    # Lab defaults (docs/lab-protocol.md) for one role. Pure given its inputs.
    param(
        [Parameter(Mandatory)][ValidateSet('host', 'guest')][string]$Role,
        [Parameter(Mandatory)]$Config,
        [Parameter(Mandatory)][string]$GameDirectory,
        [Parameter(Mandatory)][string]$HostSteamId64
    )
    if (!(Test-IndividualSteamId64 $HostSteamId64)) { throw 'Host SteamID64 is not a valid individual SteamID64.' }
    $saveDir = (Get-InstancePaths -GameDirectory $GameDirectory).SaveDir
    $guestId = [string](Get-ConfigValue $Config.Identity 'guestSteamId' '76561202255233008')
    if (!(Test-IndividualSteamId64 $guestId)) { throw 'lab.json identity.guestSteamId is not a valid individual SteamID64.' }
    if ($guestId -eq $HostSteamId64) { throw 'The guest lab SteamID must differ from the host SteamID.' }
    $fuseUrl = 'http://127.0.0.1:' + [int]$Config.Ports.fuse + '/tppstm/gate'
    if ($Role -eq 'host') {
        $peer = if ([string](Get-ConfigValue $Config.Identity 'hostPeerSteamId' 'guest') -eq 'learn') { 'learn' } else { $guestId }
        return [pscustomobject]@{
            Role = 'host'; SelfSteamId = 'real'; SelfName = ''; PeerSteamId = $peer
            ListenPort = [int]$Config.Ports.host; PeerPort = [int]$Config.Ports.guest; MutexSuffix = ''
            SaveDir = $saveDir; XInput = [string](Get-ConfigValue $Config.XInput 'host' 'passthrough'); Marker = 'host-v3'
            MasterUrl = $fuseUrl; Character = [string](Get-ConfigValue $Config.Characters 'host' 'default'); ClientHost = $null
        }
    }
    return [pscustomobject]@{
        Role = 'guest'; SelfSteamId = $guestId; SelfName = [string](Get-ConfigValue $Config.Identity 'guestName' 'Guest'); PeerSteamId = $HostSteamId64
        ListenPort = [int]$Config.Ports.guest; PeerPort = [int]$Config.Ports.host; MutexSuffix = '-guest'
        SaveDir = $saveDir; XInput = [string](Get-ConfigValue $Config.XInput 'guest' 'passthrough'); Marker = 'client-v1'
        MasterUrl = $fuseUrl; Character = [string](Get-ConfigValue $Config.Characters 'guest' 'default'); ClientHost = $HostSteamId64
    }
}

function New-LabIniFromSettings {
    param([Parameter(Mandatory)]$Settings)
    New-LabIniText -Role $Settings.Role -SelfSteamId $Settings.SelfSteamId -SelfName $Settings.SelfName `
        -PeerSteamId $Settings.PeerSteamId -ListenPort $Settings.ListenPort -PeerPort $Settings.PeerPort `
        -MutexSuffix $Settings.MutexSuffix -SaveDir $Settings.SaveDir -XInput $Settings.XInput
}

# ---------------------------------------------------------------------------
# TPP_GRAPHICS_CONFIG (lab copies only)
# ---------------------------------------------------------------------------
# Static analysis of mgsvtpp.exe 1.0.15.4 (0x52BE40.., tag function 0x52D0E0)
# shows the "as" member is an integrity tag: the game removes "as", serialises
# the rest with jsoncpp's FastWriter (sorted keys, no spaces, trailing "\n"),
# appends "-%x" of that string's length, hashes it with CryptoAPI MD5
# (CALG_MD5) and stores base64 of the first 8 digest bytes. Reproduced exactly
# against a real file before relying on it; the lab refuses to edit a file whose
# existing tag does not verify with this algorithm.

function ConvertTo-JsonCppFastText {
    # jsoncpp FastWriter output for the value types TPP_GRAPHICS_CONFIG uses.
    param([AllowNull()]$Value, [switch]$Document)
    $text = if ($null -eq $Value) { 'null' }
    elseif ($Value -is [bool]) { if ($Value) { 'true' } else { 'false' } }
    elseif ($Value -is [string]) {
        $sb = [Text.StringBuilder]::new('"')
        foreach ($ch in $Value.ToCharArray()) {
            $code = [int]$ch
            if ($code -gt 0x7e) { throw 'Non-ASCII text is not supported in the graphics config.' }
            switch ($ch) {
                '"' { $null = $sb.Append('\"') }
                '\' { $null = $sb.Append('\\') }
                "`b" { $null = $sb.Append('\b') }
                "`f" { $null = $sb.Append('\f') }
                "`n" { $null = $sb.Append('\n') }
                "`r" { $null = $sb.Append('\r') }
                "`t" { $null = $sb.Append('\t') }
                default {
                    if ($code -lt 0x20) { $null = $sb.Append('\u' + $code.ToString('x4')) } else { $null = $sb.Append($ch) }
                }
            }
        }
        $sb.Append('"').ToString()
    }
    elseif ($Value -is [int] -or $Value -is [long] -or $Value -is [int16] -or $Value -is [byte] -or $Value -is [uint32] -or $Value -is [uint64]) {
        ([long]$Value).ToString([Globalization.CultureInfo]::InvariantCulture)
    }
    elseif ($Value -is [double] -or $Value -is [decimal] -or $Value -is [single]) { throw 'Floating-point values are not supported in the graphics config.' }
    elseif ($Value -is [Collections.IDictionary] -or $Value -is [Management.Automation.PSCustomObject]) {
        $names = if ($Value -is [Collections.IDictionary]) { @($Value.Keys | ForEach-Object { [string]$_ }) } else { @($Value.PSObject.Properties.Name) }
        foreach ($n in $names) { if ($n -match '[^\x20-\x7e]') { throw 'Non-ASCII keys are not supported.' } }
        [Array]::Sort($names, [StringComparer]::Ordinal)
        $parts = foreach ($n in $names) {
            $item = if ($Value -is [Collections.IDictionary]) { $Value[$n] } else { $Value.PSObject.Properties[$n].Value }
            (ConvertTo-JsonCppFastText -Value $n) + ':' + (ConvertTo-JsonCppFastText -Value $item)
        }
        '{' + (@($parts) -join ',') + '}'
    }
    elseif ($Value -is [Collections.IEnumerable]) {
        '[' + (@($Value | ForEach-Object { ConvertTo-JsonCppFastText -Value $_ }) -join ',') + ']'
    }
    else { throw "Unsupported JSON value type: $($Value.GetType().FullName)" }
    if ($Document) { return $text + "`n" }
    return $text
}

function Get-GraphicsConfigTag {
    # The tag the game expects for a parsed config object (the "as" member is ignored).
    param([Parameter(Mandatory)]$Object)
    $copy = [ordered]@{}
    foreach ($p in $Object.PSObject.Properties) { if ($p.Name -cne 'as') { $copy[$p.Name] = $p.Value } }
    $serial = ConvertTo-JsonCppFastText -Value $copy -Document
    $bytes = [Text.Encoding]::ASCII.GetBytes($serial + '-' + $serial.Length.ToString('x'))
    $digest = [Security.Cryptography.MD5]::HashData($bytes)
    return [Convert]::ToBase64String($digest, 0, 8)
}

function Get-GraphicsConfigInfo {
    # Pure: parses config text; Valid = the stored tag matches the computed one.
    param([Parameter(Mandatory)][AllowEmptyString()][string]$Text)
    $info = [ordered]@{ Valid = $false; StoredTag = $null; ComputedTag = $null; WindowMode = $null; Width = 0; Height = 0; Error = $null }
    try {
        $object = $Text | ConvertFrom-Json
        $info.StoredTag = [string](Get-ConfigValue $object 'as' '')
        $info.ComputedTag = Get-GraphicsConfigTag -Object $object
        $video = $object.graphics.videoout_setting
        $info.WindowMode = [string]$video.window_mode
        $info.Width = [int]$video.width
        $info.Height = [int]$video.height
        $info.Valid = [bool]$info.StoredTag -and $info.StoredTag -ceq $info.ComputedTag
    } catch { $info.Error = $_.Exception.Message }
    return [pscustomobject]$info
}

function Set-GraphicsConfigWindowedText {
    # Pure: returns the config text with the requested window mode and size and a
    # recomputed tag. Edits values in place (formatting is preserved) and refuses
    # unless the input tag verifies and every edited key occurs exactly once.
    param(
        [Parameter(Mandatory)][string]$Text,
        [int]$Width = 1280,
        [int]$Height = 720,
        [ValidateSet('Windowed', 'FlexibleWindowed', 'FullScreenWindowed', 'FullScreen')][string]$WindowMode = 'Windowed'
    )
    if ($Width -lt 640 -or $Width -gt 7680 -or $Height -lt 480 -or $Height -gt 4320) { throw 'Unsupported window size.' }
    $before = Get-GraphicsConfigInfo -Text $Text
    if (!$before.Valid) { throw ('TPP_GRAPHICS_CONFIG tag does not verify; refusing to edit. ' + $before.Error) }
    $edits = @(
        @{ Pattern = '("window_mode"\s*:\s*")[A-Za-z]+(")'; Value = $WindowMode },
        @{ Pattern = '("width"\s*:\s*)[0-9]+()'; Value = [string]$Width },
        @{ Pattern = '("height"\s*:\s*)[0-9]+()'; Value = [string]$Height }
    )
    $result = $Text
    foreach ($edit in $edits) {
        $count = [regex]::Matches($result, $edit.Pattern).Count
        if ($count -ne 1) { throw "TPP_GRAPHICS_CONFIG has an unexpected layout ($count matches for $($edit.Pattern))." }
        $value = $edit.Value
        $result = [regex]::Replace($result, $edit.Pattern, { param($m) $m.Groups[1].Value + $value + $m.Groups[2].Value })
    }
    $object = $result | ConvertFrom-Json
    $tag = Get-GraphicsConfigTag -Object $object
    $asPattern = '("as"\s*:\s*")[A-Za-z0-9+/=]+(")'
    if ([regex]::Matches($result, $asPattern).Count -ne 1) { throw 'TPP_GRAPHICS_CONFIG has an unexpected "as" layout.' }
    $result = [regex]::Replace($result, $asPattern, { param($m) $m.Groups[1].Value + $tag + $m.Groups[2].Value })
    $after = Get-GraphicsConfigInfo -Text $result
    if (!$after.Valid -or $after.WindowMode -cne $WindowMode -or $after.Width -ne $Width -or $after.Height -ne $Height) {
        throw 'Internal error: edited TPP_GRAPHICS_CONFIG does not verify.'
    }
    return $result
}

# ---------------------------------------------------------------------------
# Files, hashes, manifests and packages
# ---------------------------------------------------------------------------

function Get-Sha256 {
    param([Parameter(Mandatory)][string]$Path)
    return (Get-FileHash -LiteralPath $Path -Algorithm SHA256).Hash
}

function Test-FileHash {
    param([Parameter(Mandatory)][string]$Path, [Parameter(Mandatory)][string]$Expected)
    return (Test-Path -LiteralPath $Path -PathType Leaf) -and (Get-Sha256 $Path) -eq $Expected.ToUpperInvariant()
}

function Test-PathInside {
    param([Parameter(Mandatory)][string]$Child, [Parameter(Mandatory)][string]$Parent)
    $c = [IO.Path]::GetFullPath($Child).TrimEnd('\', '/')
    $p = [IO.Path]::GetFullPath($Parent).TrimEnd('\', '/')
    return $c.Equals($p, [StringComparison]::OrdinalIgnoreCase) -or
        $c.StartsWith($p + [IO.Path]::DirectorySeparatorChar, [StringComparison]::OrdinalIgnoreCase)
}

function Assert-NoReparsePoint {
    # Refuses a path (or any existing ancestor down to $StopAt) that is a junction/symlink.
    param([Parameter(Mandatory)][string]$Path, [string]$StopAt)
    $cursor = [IO.Path]::GetFullPath($Path).TrimEnd('\', '/')
    $stop = if ($StopAt) { [IO.Path]::GetFullPath($StopAt).TrimEnd('\', '/') } else { $null }
    while ($cursor) {
        if (Test-Path -LiteralPath $cursor) {
            if ((Get-Item -LiteralPath $cursor -Force).Attributes -band [IO.FileAttributes]::ReparsePoint) { throw "Filesystem links are not supported here: $cursor" }
        }
        if ($stop -and $cursor.Equals($stop, [StringComparison]::OrdinalIgnoreCase)) { break }
        $parent = Split-Path -Parent $cursor
        if (!$parent -or $parent -eq $cursor) { break }
        $cursor = $parent
    }
}

function Write-TextFileIfChanged {
    # Writes UTF-8 (no BOM) / LF text atomically; returns $true when the file changed.
    param([Parameter(Mandatory)][string]$Path, [Parameter(Mandatory)][AllowEmptyString()][string]$Text)
    if ((Test-Path -LiteralPath $Path -PathType Leaf) -and [IO.File]::ReadAllText($Path) -ceq $Text) { return $false }
    $parent = Split-Path -Parent $Path
    if (!(Test-Path -LiteralPath $parent)) { $null = New-Item -ItemType Directory -Path $parent -Force }
    $temp = $Path + '.' + [Guid]::NewGuid().ToString('N') + '.tmp'
    [IO.File]::WriteAllText($temp, $Text, $script:Utf8NoBom)
    try { Move-Item -LiteralPath $temp -Destination $Path -Force }
    finally { if (Test-Path -LiteralPath $temp) { Remove-Item -LiteralPath $temp -Force } }
    return $true
}

function New-HashManifest {
    # Hashes every file below each relative source folder of $Root (read-only).
    param([Parameter(Mandatory)][string]$Root, [Parameter(Mandatory)][string[]]$Folders)
    $rows = [Collections.Generic.List[object]]::new()
    foreach ($folder in $Folders) {
        $full = Join-Path $Root $folder
        if (!(Test-Path -LiteralPath $full -PathType Container)) { continue }
        foreach ($file in Get-ChildItem -LiteralPath $full -File -Recurse -Force | Sort-Object FullName) {
            $relative = [IO.Path]::GetRelativePath($Root, $file.FullName).Replace('\', '/')
            $rows.Add([pscustomobject]@{ path = $relative; size = $file.Length; sha256 = (Get-Sha256 $file.FullName) })
        }
    }
    return , $rows.ToArray()
}

function Compare-HashManifest {
    # Pure: compares expected rows with actual rows by path.
    param([object[]]$Expected = @(), [object[]]$Actual = @())
    $want = @{}; foreach ($row in @($Expected)) { if ($row) { $want[[string]$row.path] = $row } }
    $have = @{}; foreach ($row in @($Actual)) { if ($row) { $have[[string]$row.path] = $row } }
    $changed = @($want.Keys | Where-Object { $have.ContainsKey($_) -and $have[$_].sha256 -ne $want[$_].sha256 } | Sort-Object)
    $missing = @($want.Keys | Where-Object { !$have.ContainsKey($_) } | Sort-Object)
    $added = @($have.Keys | Where-Object { !$want.ContainsKey($_) } | Sort-Object)
    [pscustomobject]@{
        Same    = ($changed.Count + $missing.Count + $added.Count) -eq 0
        Changed = $changed
        Missing = $missing
        Added   = $added
    }
}

$script:VerifiedSaveFolders = @('287700/local', '311340/remote')

function Get-RealSaveManifest {
    # Hash-only manifest of the real save folders (read-only).
    param([Parameter(Mandatory)][string]$UserData)
    return New-HashManifest -Root ([IO.Path]::GetFullPath($UserData).TrimEnd('\', '/')) -Folders $script:VerifiedSaveFolders
}

function Backup-RealSaves {
    # Copies the real MGSV save folders (read-only access) to $Destination and
    # writes manifest.json. Folders: 287700/local and 311340/remote (verified),
    # plus the remaining files of 287700 and 311340 (informational backup).
    param([Parameter(Mandatory)][string]$UserData, [Parameter(Mandatory)][string]$Destination)
    $userRoot = [IO.Path]::GetFullPath($UserData).TrimEnd('\', '/')
    if (Test-PathInside -Child $Destination -Parent $userRoot) { throw 'Backup destination must be outside Steam userdata.' }
    if (Test-Path -LiteralPath $Destination) { throw "Backup destination already exists: $Destination" }
    $verified = New-HashManifest -Root $userRoot -Folders $script:VerifiedSaveFolders
    if ($verified.Count -eq 0) { throw "No MGSV save files under $userRoot (287700/local, 311340/remote)." }
    $everything = New-HashManifest -Root $userRoot -Folders @('287700', '311340')
    $null = New-Item -ItemType Directory -Path $Destination -Force
    foreach ($row in $everything) {
        $source = Join-Path $userRoot $row.path
        $target = Join-Path $Destination ('files/' + $row.path)
        $parent = Split-Path -Parent $target
        if (!(Test-Path -LiteralPath $parent)) { $null = New-Item -ItemType Directory -Path $parent -Force }
        # Read-only open of the real file; the copy is written only below $Destination.
        [IO.File]::Copy($source, $target, $false)
        if ((Get-Sha256 $target) -ne $row.sha256) { throw "Backup copy hash mismatch (file changed while copying?): $($row.path)" }
    }
    $manifest = [ordered]@{
        product     = 'mgs-coop-lab-save-backup'
        created_utc = [DateTime]::UtcNow.ToString('o')
        source_root = $userRoot
        verified    = $verified
        all_files   = $everything
        note        = 'Real files were only read. verified = save files whose hashes Stop-Lab re-checks.'
    }
    [IO.File]::WriteAllText((Join-Path $Destination 'manifest.json'), ($manifest | ConvertTo-Json -Depth 5) + "`n", $script:Utf8NoBom)
    return [pscustomobject]$manifest
}

function Test-RealSavesAgainstBackup {
    param([Parameter(Mandatory)][string]$BackupDirectory)
    $manifest = Get-Content -LiteralPath (Join-Path $BackupDirectory 'manifest.json') -Raw | ConvertFrom-Json
    $current = New-HashManifest -Root $manifest.source_root -Folders $script:VerifiedSaveFolders
    $comparison = Compare-HashManifest -Expected @($manifest.verified) -Actual $current
    [pscustomobject]@{ Backup = $BackupDirectory; SourceRoot = $manifest.source_root; Comparison = $comparison }
}

function Copy-SaveSeed {
    # Seeds a lab save_dir from a verified backup copy (never from the real folder).
    #   files/287700/local/*  -> <SaveDir>/<LocalSubdir>/
    #   files/311340/remote/* -> <SaveDir>/<RemoteSubdir>/
    # An already seeded save_dir is left untouched unless -Reseed is set, in
    # which case the existing lab copies are first moved to $ArchiveDirectory.
    param(
        [Parameter(Mandatory)][string]$BackupDirectory,
        [Parameter(Mandatory)][string]$SaveDir,
        [string]$LocalSubdir = '287700/local',
        [string]$RemoteSubdir = 'remote',
        [switch]$Reseed,
        [string]$ArchiveDirectory
    )
    $local = Join-Path $SaveDir $LocalSubdir
    $remote = Join-Path $SaveDir $RemoteSubdir
    $seeded = (Test-Path -LiteralPath $local) -and @(Get-ChildItem -LiteralPath $local -File -Force).Count -gt 0
    if ($seeded -and !$Reseed) { return [pscustomobject]@{ Seeded = $false; Reason = 'already_seeded'; Files = 0; SaveDir = $SaveDir } }
    if ($seeded -or ($Reseed -and (Test-Path -LiteralPath $remote))) {
        if (!$ArchiveDirectory) { throw 'ArchiveDirectory is required with -Reseed.' }
        foreach ($pair in @(@($local, 'local'), @($remote, 'remote'))) {
            if (Test-Path -LiteralPath $pair[0]) {
                $null = New-Item -ItemType Directory -Path $ArchiveDirectory -Force
                Move-Item -LiteralPath $pair[0] -Destination (Join-Path $ArchiveDirectory ($pair[1] + '-' + [Guid]::NewGuid().ToString('N').Substring(0, 8)))
            }
        }
    }
    $copied = 0
    foreach ($pair in @(@('files/287700/local', $local), @('files/311340/remote', $remote))) {
        $source = Join-Path $BackupDirectory $pair[0]
        $null = New-Item -ItemType Directory -Path $pair[1] -Force
        if (!(Test-Path -LiteralPath $source)) { continue }
        foreach ($file in Get-ChildItem -LiteralPath $source -File -Force) {
            [IO.File]::Copy($file.FullName, (Join-Path $pair[1] $file.Name), $true)
            $copied++
        }
    }
    return [pscustomobject]@{ Seeded = $true; Reason = 'copied'; Files = $copied; SaveDir = $SaveDir }
}

function New-LabPackage {
    # Stages a local package (package.json + payload) for tools/package-install.ps1
    # -PackageDirectory. The runtime archive is referenced by hash only.
    param(
        [Parameter(Mandatory)][string]$RepoRoot,
        [Parameter(Mandatory)][string]$Destination,
        [Parameter(Mandatory)][string]$LoaderPath,
        [Parameter(Mandatory)][string]$Version,
        [Parameter(Mandatory)][string]$ExecutableSha256,
        [Parameter(Mandatory)][string]$SteamDllSha256,
        [Parameter(Mandatory)][string]$ArchiveSha256,
        [hashtable]$LicenseOverrides = @{}
    )
    foreach ($hash in $ExecutableSha256, $SteamDllSha256, $ArchiveSha256) {
        if ($hash -cnotmatch '^[A-Fa-f0-9]{64}$') { throw "Invalid SHA-256: $hash" }
    }
    if (Test-Path -LiteralPath $Destination) { throw "Package staging folder already exists: $Destination" }
    $inputs = @(
        @{ key = 'dynamite'; path = (Join-Path $RepoRoot 'third_party/dynamite/LICENSE'); name = 'DYNAMITE-LICENSE'; target = 'mgs-coop/DYNAMITE-LICENSE' },
        @{ key = 'minhook'; path = (Join-Path $RepoRoot 'third_party/minhook/LICENSE.txt'); name = 'MinHook-LICENSE.txt'; target = 'mgs-coop/MinHook-LICENSE.txt' },
        @{ key = 'tppmod'; path = (Join-Path $RepoRoot 'third_party/tpp-mod/LICENSE'); name = 'tpp-mod-LICENSE'; target = 'mgs-coop/tpp-mod-LICENSE' },
        @{ key = 'notices'; path = (Join-Path $RepoRoot 'THIRD_PARTY_NOTICES.md'); name = 'THIRD_PARTY_NOTICES.md'; target = 'mgs-coop/THIRD_PARTY_NOTICES.md' },
        @{ key = 'loader'; path = $LoaderPath; name = 'dinput8.dll'; target = 'dinput8.dll' }
    )
    $payload = Join-Path $Destination 'payload'
    $null = New-Item -ItemType Directory -Path $payload -Force
    $files = @()
    foreach ($item in $inputs) {
        $source = if ($LicenseOverrides.ContainsKey($item.key)) { $LicenseOverrides[$item.key] } else { $item.path }
        if (!(Test-Path -LiteralPath $source -PathType Leaf)) { throw "Package input not found: $source" }
        $relative = 'payload/' + $item.name
        [IO.File]::Copy($source, (Join-Path $Destination $relative), $false)
        $files += @([ordered]@{ source = $relative; target = $item.target; sha256 = (Get-Sha256 (Join-Path $Destination $relative)) })
    }
    $manifest = [ordered]@{
        product = 'mgs-coop-local-package'; version = $Version; prepared_utc = [DateTime]::UtcNow.ToString('o')
        executable_sha256 = $ExecutableSha256.ToUpperInvariant(); steam_dll_sha256 = $SteamDllSha256.ToUpperInvariant()
        files = $files
        runtime_archive = [ordered]@{ target = 'mgs-coop/mgs-coop-player-runtime.dat'; sha256 = $ArchiveSha256.ToUpperInvariant() }
        scope = 'Single-PC lab staging package. Contains no game-derived files.'
    }
    [IO.File]::WriteAllText((Join-Path $Destination 'package.json'), ($manifest | ConvertTo-Json -Depth 5) + "`n", $script:Utf8NoBom)
    return [pscustomobject]@{ Path = $Destination; LoaderSha256 = ($files | Where-Object { $_.target -eq 'dinput8.dll' }).sha256 }
}

# ---------------------------------------------------------------------------
# Logs and status
# ---------------------------------------------------------------------------

function Get-FileLengthOrZero {
    param([Parameter(Mandatory)][string]$Path)
    if (Test-Path -LiteralPath $Path -PathType Leaf) { return [Int64](Get-Item -LiteralPath $Path -Force).Length }
    return [Int64]0
}

function Read-LogFromOffset {
    # Reads complete lines appended since $Offset (FileShare.ReadWrite, so the
    # game keeps writing). A shorter file than $Offset means it was replaced;
    # reading restarts at 0 and Truncated is set.
    param([Parameter(Mandatory)][string]$Path, [Int64]$Offset = 0, [int]$MaxBytes = 8MB)
    $result = [pscustomobject]@{ Text = ''; NewOffset = $Offset; Exists = $false; Truncated = $false }
    if (!(Test-Path -LiteralPath $Path -PathType Leaf)) { return $result }
    $result.Exists = $true
    $stream = [IO.FileStream]::new($Path, [IO.FileMode]::Open, [IO.FileAccess]::Read,
        [IO.FileShare]::ReadWrite -bor [IO.FileShare]::Delete)
    try {
        $length = $stream.Length
        if ($length -lt $Offset) { $Offset = 0; $result.Truncated = $true }
        $count = [int][Math]::Min([Int64]$MaxBytes, $length - $Offset)
        if ($count -le 0) { $result.NewOffset = $Offset; return $result }
        $buffer = [byte[]]::new($count)
        $null = $stream.Seek($Offset, [IO.SeekOrigin]::Begin)
        $read = 0
        while ($read -lt $count) {
            $n = $stream.Read($buffer, $read, $count - $read)
            if ($n -le 0) { break }
            $read += $n
        }
        if ($read -le 0) { $result.NewOffset = $Offset; return $result }
        $last = [Array]::LastIndexOf($buffer, [byte]10, $read - 1)
        if ($last -lt 0) { $result.NewOffset = $Offset; return $result }  # no complete line yet
        $result.Text = [Text.Encoding]::UTF8.GetString($buffer, 0, $last + 1)
        $result.NewOffset = $Offset + $last + 1
    } finally { $stream.Dispose() }
    return $result
}

function Read-LabStatus {
    # Parses lab-status.json; $null when absent, unreadable, mid-write or from another process.
    param([Parameter(Mandatory)][string]$Path, [int]$ExpectedPid = 0)
    if (!(Test-Path -LiteralPath $Path -PathType Leaf)) { return $null }
    try {
        $stream = [IO.FileStream]::new($Path, [IO.FileMode]::Open, [IO.FileAccess]::Read,
            [IO.FileShare]::ReadWrite -bor [IO.FileShare]::Delete)
        try { $text = [IO.StreamReader]::new($stream).ReadToEnd() } finally { $stream.Dispose() }
        return ConvertFrom-LabStatusText -Text $text -ExpectedPid $ExpectedPid
    } catch { return $null }
}

function ConvertFrom-LabStatusText {
    param([AllowEmptyString()][string]$Text, [int]$ExpectedPid = 0)
    if (!$Text) { return $null }
    try { $status = $Text | ConvertFrom-Json } catch { return $null }
    if (!$status -or !($status.PSObject.Properties.Name -contains 'session_status')) { return $null }
    if ($ExpectedPid -and ($status.PSObject.Properties.Name -contains 'pid') -and [int]$status.pid -ne $ExpectedPid) { return $null }
    return $status
}

function Test-LogLine {
    # True when a line of $Text starts with $Prefix followed by end, space or ';'.
    param([AllowEmptyString()][string]$Text, [Parameter(Mandatory)][string]$Prefix)
    if (!$Text) { return $false }
    return [regex]::IsMatch($Text, '(?m)^' + [regex]::Escape($Prefix) + '(?=[ ;\r\n]|$)')
}

function Get-FirstLogLine {
    # First complete line starting with $Prefix (for result evidence), or $null.
    param([AllowEmptyString()][string]$Text, [Parameter(Mandatory)][string]$Prefix)
    if (!$Text) { return $null }
    $m = [regex]::Match($Text, '(?m)^' + [regex]::Escape($Prefix) + '(?=[ ;\r\n]|$)[^\r\n]*')
    if ($m.Success) { return $m.Value } else { return $null }
}

function Get-LastSessionStatus {
    param([AllowEmptyString()][string]$Text)
    if (!$Text) { return $null }
    $found = [regex]::Matches($Text, '(?m)^session_status=([a-z_]+)')
    if ($found.Count -eq 0) { return $null }
    return $found[$found.Count - 1].Groups[1].Value
}

function Get-CurrentSessionStatus {
    # lab-status.json from the expected process wins; otherwise the newest log line.
    param($Status, [AllowEmptyString()][string]$LogText)
    if ($Status) { return [string]$Status.session_status }
    $fromLog = Get-LastSessionStatus $LogText
    if ($fromLog) { return $fromLog }
    return 'none'
}

function Get-LabSmokeVerdict {
    # Pure pass/fail evaluation (synthesis section 3.5) for one poll.
    #  - Before the trigger: wait for host readiness (dynamite_host=returned;
    #    result=1, host_admission=authorized, session_status=host_ready) and the
    #    guest's client_join=armed, bounded by ReadyTimeoutSec.
    #  - After the trigger: PASS when guest client_established and host
    #    host_peer_present hold for 2 consecutive polls, bounded by TimeoutSec
    #    counted from the trigger.
    param(
        [AllowEmptyString()][string]$HostLog = '',
        [AllowEmptyString()][string]$GuestLog = '',
        $HostStatus = $null,
        $GuestStatus = $null,
        [bool]$HostAlive = $true,
        [bool]$GuestAlive = $true,
        [bool]$TriggerCreated = $false,
        [int]$PreviousPassPolls = 0,
        [double]$ReadyElapsedSec = 0,
        [double]$ReadyTimeoutSec = 900,
        [double]$TriggerElapsedSec = 0,
        [double]$TimeoutSec = 180,
        [switch]$HostOnly
    )
    $hostSession = Get-CurrentSessionStatus -Status $HostStatus -LogText $HostLog
    $guestSession = Get-CurrentSessionStatus -Status $GuestStatus -LogText $GuestLog
    $hostReadySeen = (Test-LogLine $HostLog 'session_status=host_ready') -or $hostSession -in @('host_ready', 'host_peer_present')
    $hostReady = (Test-LogLine $HostLog 'dynamite_host=returned; result=1') -and
        (Test-LogLine $HostLog 'host_admission=authorized') -and $hostReadySeen
    $guestArmed = (Test-LogLine $GuestLog 'client_join=armed') -or
        ($GuestStatus -and ($GuestStatus.PSObject.Properties.Name -contains 'join') -and [string]$GuestStatus.join -eq 'armed')
    $requestStarted = Test-LogLine $GuestLog 'dynamite_client=returned; request_started=1'
    $verdict = [ordered]@{
        Verdict = 'pending'; Reason = ''; Phase = ''; HostReady = $hostReady; GuestArmed = $guestArmed
        RequestStarted = $requestStarted; ShouldTrigger = $false; PassPolls = 0
        HostSession = $hostSession; GuestSession = $guestSession
    }
    $fail = {
        param($reason)
        $verdict.Verdict = 'fail'; $verdict.Reason = $reason
        return [pscustomobject]$verdict
    }
    if (!$HostAlive) { return & $fail 'process_exit_host' }
    if (!$HostOnly -and !$GuestAlive) { return & $fail 'process_exit_guest' }
    if ($hostSession -eq 'session_error' -or (Test-LogLine $HostLog 'session_status=session_error')) { return & $fail 'host_session_error' }
    if (Test-LogLine $HostLog 'dynamite_host=returned; result=0') { return & $fail 'host_creation_failed' }
    if (!$HostOnly) {
        if (Test-LogLine $GuestLog 'dynamite_client=refused') { return & $fail 'dynamite_client_refused' }
        if (Test-LogLine $GuestLog 'dynamite_client=returned; request_started=0') { return & $fail 'request_started_0' }
        if ($GuestLog -match '(?m)refused=missing_or_invalid_client_host_txt') { return & $fail 'missing_or_invalid_client_host_txt' }
        if (Test-LogLine $GuestLog 'client_join=refused') { return & $fail 'client_join_refused' }
        if ($guestSession -eq 'session_error' -or (Test-LogLine $GuestLog 'session_status=session_error')) { return & $fail 'guest_session_error' }
    }
    if ($HostOnly) {
        $verdict.Phase = if ($hostReady) { 'host_ready' } else { 'waiting_host_ready' }
        $verdict.PassPolls = if ($hostReady) { $PreviousPassPolls + 1 } else { 0 }
    } else {
        $verdict.Phase = if (!$hostReady) { 'waiting_host_ready' }
        elseif (!$guestArmed) { 'waiting_guest_armed' }
        elseif (!$TriggerCreated) { 'ready_to_trigger' }
        elseif (!$requestStarted) { 'waiting_request_started' }
        elseif ($guestSession -ne 'client_established' -or $hostSession -ne 'host_peer_present') { 'waiting_established' }
        else { 'established' }
        $verdict.ShouldTrigger = $hostReady -and $guestArmed -and !$TriggerCreated
        $established = $guestSession -eq 'client_established' -and $hostSession -eq 'host_peer_present'
        $verdict.PassPolls = if ($established) { $PreviousPassPolls + 1 } else { 0 }
    }
    if ($verdict.PassPolls -ge 2) {
        $verdict.Verdict = 'pass'
        $verdict.Reason = if ($HostOnly) { 'host_ready_stable' } else { 'established_stable' }
        return [pscustomobject]$verdict
    }
    if (!$HostOnly -and $TriggerCreated) {
        if ($TriggerElapsedSec -ge $TimeoutSec) { return & $fail ('timeout_' + $verdict.Phase) }
    } elseif ($ReadyElapsedSec -ge $ReadyTimeoutSec) { return & $fail ('timeout_' + $verdict.Phase) }
    return [pscustomobject]$verdict
}

function Get-LabEvidence {
    # First matching line per interesting prefix (no SteamIDs are logged by native code).
    param([AllowEmptyString()][string]$Text, [string[]]$Prefixes)
    $rows = [ordered]@{}
    foreach ($prefix in $Prefixes) { $rows[$prefix] = Get-FirstLogLine -Text $Text -Prefix $prefix }
    return [pscustomobject]$rows
}

# ---------------------------------------------------------------------------
# Processes, ports and fuse
# ---------------------------------------------------------------------------

function Select-ProcessInDirectory {
    # Pure: rows (Id, Path) whose executable lives directly in $Directory. Rows
    # with an unknown path are returned with Unknown=$true (callers must treat
    # them as possibly matching).
    param([object[]]$Processes = @(), [Parameter(Mandatory)][string]$Directory)
    $root = [IO.Path]::GetFullPath($Directory).TrimEnd('\', '/')
    $rows = foreach ($p in @($Processes)) {
        if (!$p) { continue }
        if (!$p.Path) { [pscustomobject]@{ Id = $p.Id; Path = $null; Unknown = $true }; continue }
        $folder = Split-Path -Parent ([IO.Path]::GetFullPath($p.Path))
        if ($folder.TrimEnd('\', '/').Equals($root, [StringComparison]::OrdinalIgnoreCase)) {
            [pscustomobject]@{ Id = $p.Id; Path = $p.Path; Unknown = $false }
        }
    }
    return @($rows)
}

function Get-ProcessPathSafe {
    param([Parameter(Mandatory)]$Process)
    $path = $null
    try { $path = $Process.Path } catch { $path = $null }
    if (!$path) {
        try { $path = (Get-CimInstance Win32_Process -Filter "ProcessId=$($Process.Id)" -ErrorAction Stop).ExecutablePath } catch { $path = $null }
    }
    return $path
}

function Get-GameProcessInDirectory {
    # mgsvtpp/mgsvmgo processes started from $Directory (by executable path).
    param([Parameter(Mandatory)][string]$Directory)
    $rows = foreach ($p in @(Get-Process -Name mgsvtpp, mgsvmgo -ErrorAction SilentlyContinue)) {
        [pscustomobject]@{ Id = $p.Id; Path = (Get-ProcessPathSafe $p) }
    }
    return Select-ProcessInDirectory -Processes @($rows) -Directory $Directory
}

function Test-LocalPortFree {
    param([Parameter(Mandatory)][int]$Port, [ValidateSet('Tcp', 'Udp')][string]$Protocol = 'Tcp')
    # Any listener on the port (all addresses), then an exclusive loopback bind.
    $properties = [Net.NetworkInformation.IPGlobalProperties]::GetIPGlobalProperties()
    $listeners = if ($Protocol -eq 'Tcp') { $properties.GetActiveTcpListeners() } else { $properties.GetActiveUdpListeners() }
    if (@($listeners | Where-Object { $_.Port -eq $Port }).Count) { return $false }
    $type = if ($Protocol -eq 'Tcp') { [Net.Sockets.SocketType]::Stream } else { [Net.Sockets.SocketType]::Dgram }
    $proto = if ($Protocol -eq 'Tcp') { [Net.Sockets.ProtocolType]::Tcp } else { [Net.Sockets.ProtocolType]::Udp }
    $socket = [Net.Sockets.Socket]::new([Net.Sockets.AddressFamily]::InterNetwork, $type, $proto)
    try {
        $socket.ExclusiveAddressUse = $true
        $socket.Bind([Net.IPEndPoint]::new([Net.IPAddress]::Loopback, $Port))
        return $true
    } catch { return $false }
    finally { $socket.Dispose() }
}

function Test-TcpListening {
    # True when something accepts TCP connections on 127.0.0.1:$Port (local only).
    param([Parameter(Mandatory)][int]$Port, [int]$TimeoutMs = 500)
    $client = [Net.Sockets.TcpClient]::new()
    try {
        $task = $client.ConnectAsync([Net.IPAddress]::Loopback, $Port)
        return $task.Wait($TimeoutMs) -and $client.Connected
    } catch { return $false }
    finally { $client.Dispose() }
}

function New-FuseArguments {
    # fuse must ALWAYS run with -standalone: without it fuse backs up and
    # patches mgsvtpp.exe on disk (for the wrong executable version).
    param([int]$Port = 6667, [bool]$WriteLog = $true)
    if ($Port -lt 1024 -or $Port -gt 65535) { throw "Invalid fuse port: $Port" }
    $arguments = @('-standalone', '-listenAddr', "127.0.0.1:$Port", '-baseURL', "http://127.0.0.1:$Port/")
    if ($WriteLog) { $arguments += '-writeLog' }
    Assert-FuseArgumentsSafe -Arguments $arguments
    return , $arguments
}

function Assert-FuseArgumentsSafe {
    param([Parameter(Mandatory)][string[]]$Arguments)
    if (@($Arguments | Where-Object { $_ -ceq '-standalone' }).Count -ne 1) { throw 'Refusing to start fuse without -standalone (it would patch the executable on disk).' }
    if (@($Arguments | Where-Object { $_ -match '^-+(clientURL|passThrough|standalone=)' }).Count) { throw 'Refusing fuse -clientURL/-passThrough/-standalone=... in the lab.' }
    $listen = [Array]::IndexOf($Arguments, '-listenAddr')
    if ($listen -lt 0 -or $listen + 1 -ge $Arguments.Count -or $Arguments[$listen + 1] -cnotmatch '^127\.0\.0\.1:[0-9]+$') {
        throw 'fuse must listen on 127.0.0.1 only.'
    }
}

function Get-FuseMessageSummary {
    # fuse -writeLog stores each decoded request as log/<startUnix>/<unixMs>_<MSGID>_request
    # in its working directory. Returns counts per message id (names only; the
    # files themselves can contain a Steam auth ticket and are not copied).
    param([Parameter(Mandatory)][string]$FuseDirectory, [Int64]$SinceUnix = 0)
    $root = Join-Path $FuseDirectory 'log'
    $counts = [ordered]@{}
    if (!(Test-Path -LiteralPath $root -PathType Container)) { return [pscustomobject]$counts }
    foreach ($dir in Get-ChildItem -LiteralPath $root -Directory) {
        [Int64]$start = 0
        if (![Int64]::TryParse($dir.Name, [ref]$start) -or $start -lt $SinceUnix) { continue }
        foreach ($file in Get-ChildItem -LiteralPath $dir.FullName -File) {
            if ($file.Name -cmatch '^[0-9]+_(CMD_[A-Z0-9_]+)_(request|response)$') {
                $key = $Matches[1]
                if ($counts.Contains($key)) { $counts[$key]++ } else { $counts[$key] = 1 }
            }
        }
    }
    return [pscustomobject]$counts
}

# ---------------------------------------------------------------------------
# Runs
# ---------------------------------------------------------------------------

function New-RunStamp { return [DateTime]::Now.ToString('yyyyMMdd-HHmmss') }

function Get-CurrentRun {
    # Loads run.json from -RunDir or from <runDir>/current-run.json.
    param($Config, [string]$RunDir)
    if (!$RunDir) {
        $pointer = Join-Path $Config.Paths.runDir 'current-run.json'
        if (!(Test-Path -LiteralPath $pointer -PathType Leaf)) { throw "No current lab run ($pointer). Run Start-Lab.ps1 or pass -RunDir." }
        $RunDir = (Get-Content -LiteralPath $pointer -Raw | ConvertFrom-Json).run_dir
    }
    $runJson = Join-Path $RunDir 'run.json'
    if (!(Test-Path -LiteralPath $runJson -PathType Leaf)) { throw "run.json not found in $RunDir" }
    $run = Get-Content -LiteralPath $runJson -Raw | ConvertFrom-Json
    return [pscustomobject]@{ Dir = (Resolve-Path -LiteralPath $RunDir).Path; Run = $run }
}

function Write-JsonFile {
    param([Parameter(Mandatory)][string]$Path, [Parameter(Mandatory)]$Value)
    $parent = Split-Path -Parent $Path
    if (!(Test-Path -LiteralPath $parent)) { $null = New-Item -ItemType Directory -Path $parent -Force }
    $temp = $Path + '.' + [Guid]::NewGuid().ToString('N') + '.tmp'
    [IO.File]::WriteAllText($temp, ($Value | ConvertTo-Json -Depth 10) + "`n", $script:Utf8NoBom)
    Move-Item -LiteralPath $temp -Destination $Path -Force
}

function Get-LabLogNames {
    # Per-instance logs under <exeDir>/mgs-coop/ (docs/lab-protocol.md plus the existing logs).
    return @('script-observer.log', 'early.log', 'loopback.log', 'steam-observer.log', 'probe.log')
}

function Get-LiveProcess {
    # The process with $Id if it is still running from $ExpectedPath; else $null.
    param([int]$Id, [string]$ExpectedPath)
    if (!$Id) { return $null }
    $p = Get-Process -Id $Id -ErrorAction SilentlyContinue
    if (!$p) { return $null }
    if ($ExpectedPath) {
        $path = Get-ProcessPathSafe $p
        if ($path -and ![IO.Path]::GetFullPath($path).Equals([IO.Path]::GetFullPath($ExpectedPath), [StringComparison]::OrdinalIgnoreCase)) { return $null }
    }
    return $p
}

function New-TriggerFile {
    # Creates a trigger (join.trigger / reset.trigger) atomically; native code deletes it.
    param([Parameter(Mandatory)][string]$Path)
    $temp = $Path + '.' + [Guid]::NewGuid().ToString('N') + '.tmp'
    [IO.File]::WriteAllText($temp, ([DateTime]::UtcNow.ToString('o') + "`n"), [Text.Encoding]::ASCII)
    Move-Item -LiteralPath $temp -Destination $Path -Force
}

# ---------------------------------------------------------------------------
# Win32 windows, input and capture (loaded on demand)
# ---------------------------------------------------------------------------

function Initialize-LabWin32 {
    if ('MgsCoopLab.User32' -as [type]) { return }
    Add-Type -TypeDefinition @'
using System;
using System.Runtime.InteropServices;
namespace MgsCoopLab {
public static class User32 {
    [StructLayout(LayoutKind.Sequential)] public struct RECT { public int Left, Top, Right, Bottom; }
    [StructLayout(LayoutKind.Sequential)] public struct MOUSEINPUT { public int dx, dy; public uint mouseData, dwFlags, time; public IntPtr dwExtraInfo; }
    [StructLayout(LayoutKind.Sequential)] public struct KEYBDINPUT { public ushort wVk, wScan; public uint dwFlags, time; public IntPtr dwExtraInfo; }
    [StructLayout(LayoutKind.Explicit)] public struct InputUnion { [FieldOffset(0)] public MOUSEINPUT mi; [FieldOffset(0)] public KEYBDINPUT ki; }
    [StructLayout(LayoutKind.Sequential)] public struct INPUT { public uint type; public InputUnion u; }
    [DllImport("user32.dll", SetLastError = true)] public static extern bool SetWindowPos(IntPtr hWnd, IntPtr after, int x, int y, int cx, int cy, uint flags);
    [DllImport("user32.dll", SetLastError = true)] public static extern bool GetWindowRect(IntPtr hWnd, out RECT rect);
    [DllImport("user32.dll", SetLastError = true)] public static extern bool PrintWindow(IntPtr hWnd, IntPtr hdc, uint flags);
    [DllImport("user32.dll")] public static extern bool SetForegroundWindow(IntPtr hWnd);
    [DllImport("user32.dll")] public static extern IntPtr GetForegroundWindow();
    [DllImport("user32.dll")] public static extern bool ShowWindow(IntPtr hWnd, int cmd);
    [DllImport("user32.dll")] public static extern bool IsIconic(IntPtr hWnd);
    [DllImport("user32.dll")] public static extern bool IsWindow(IntPtr hWnd);
    [DllImport("user32.dll", SetLastError = true)] public static extern bool PostMessage(IntPtr hWnd, uint msg, IntPtr w, IntPtr l);
    [DllImport("user32.dll", SetLastError = true)] public static extern uint SendInput(uint count, INPUT[] inputs, int size);
    public static uint Key(ushort scan, bool extended, bool up) {
        INPUT[] input = new INPUT[1];
        input[0].type = 1; // INPUT_KEYBOARD
        input[0].u.ki.wScan = scan;
        input[0].u.ki.dwFlags = 0x0008u | (extended ? 0x0001u : 0u) | (up ? 0x0002u : 0u); // SCANCODE | EXTENDED | KEYUP
        return SendInput(1, input, Marshal.SizeOf(typeof(INPUT)));
    }
}
public static class Kernel32 {
    [DllImport("kernel32.dll", SetLastError = true)] public static extern IntPtr GetStdHandle(int which);
    [DllImport("kernel32.dll", SetLastError = true)] public static extern bool GetHandleInformation(IntPtr handle, out uint flags);
    [DllImport("kernel32.dll", SetLastError = true)] public static extern bool SetHandleInformation(IntPtr handle, uint mask, uint flags);
}
}
'@
}

function Invoke-WithoutStdHandleInheritance {
    # Runs $Script with this process's stdout/stderr handles marked non-inheritable,
    # so processes it starts (fuse with redirected output) do not keep a caller's
    # output pipe open. Otherwise `pwsh -File Start-Lab.ps1 | ...` would not finish
    # until fuse and the games exit.
    param([Parameter(Mandatory)][scriptblock]$Script)
    Initialize-LabWin32
    $saved = @()
    foreach ($which in -11, -12) {  # STD_OUTPUT_HANDLE, STD_ERROR_HANDLE
        $handle = [MgsCoopLab.Kernel32]::GetStdHandle($which)
        [uint32]$flags = 0
        if ($handle -ne [IntPtr]::Zero -and $handle -ne [IntPtr]::new(-1) -and [MgsCoopLab.Kernel32]::GetHandleInformation($handle, [ref]$flags) -and ($flags -band 1)) {
            if ([MgsCoopLab.Kernel32]::SetHandleInformation($handle, 1, 0)) { $saved += $handle }
        }
    }
    try { & $Script }
    finally { foreach ($handle in $saved) { $null = [MgsCoopLab.Kernel32]::SetHandleInformation($handle, 1, 1) } }
}

function Get-WindowRectangle {
    param([Parameter(Mandatory)][IntPtr]$Handle)
    Initialize-LabWin32
    $rect = [MgsCoopLab.User32+RECT]::new()
    if (![MgsCoopLab.User32]::GetWindowRect($Handle, [ref]$rect)) { return $null }
    return [pscustomobject]@{ X = $rect.Left; Y = $rect.Top; Width = $rect.Right - $rect.Left; Height = $rect.Bottom - $rect.Top }
}

function Get-ProcessMainWindow {
    # Main window handle of a live process (IntPtr.Zero when none yet).
    param([Parameter(Mandatory)][int]$Id)
    $p = Get-Process -Id $Id -ErrorAction SilentlyContinue
    if (!$p) { return [IntPtr]::Zero }
    $p.Refresh()
    return $p.MainWindowHandle
}

function Move-GameWindow {
    # Moves (and optionally resizes) a top-level window without activating it.
    param([Parameter(Mandatory)][IntPtr]$Handle, [int]$X, [int]$Y, [int]$Width = 0, [int]$Height = 0)
    Initialize-LabWin32
    $flags = 0x0004 -bor 0x0010  # SWP_NOZORDER | SWP_NOACTIVATE
    if ($Width -le 0 -or $Height -le 0) { $flags = $flags -bor 0x0001 }  # SWP_NOSIZE
    return [MgsCoopLab.User32]::SetWindowPos($Handle, [IntPtr]::Zero, $X, $Y, $Width, $Height, [uint32]$flags)
}

function Close-GameWindow {
    # Posts WM_CLOSE (the same message as the window's close button).
    param([Parameter(Mandatory)][IntPtr]$Handle)
    Initialize-LabWin32
    if ($Handle -eq [IntPtr]::Zero -or ![MgsCoopLab.User32]::IsWindow($Handle)) { return $false }
    return [MgsCoopLab.User32]::PostMessage($Handle, 0x0010, [IntPtr]::Zero, [IntPtr]::Zero)
}

function Send-ScanCodeKey {
    # Best effort: focuses the window, then holds one scan-code key ~150 ms.
    # Returns $false when the window could not be brought to the foreground.
    param([Parameter(Mandatory)][IntPtr]$Handle, [Parameter(Mandatory)][uint16]$ScanCode, [switch]$Extended, [int]$HoldMs = 150)
    Initialize-LabWin32
    if ([MgsCoopLab.User32]::IsIconic($Handle)) { $null = [MgsCoopLab.User32]::ShowWindow($Handle, 9) }  # SW_RESTORE
    $null = [MgsCoopLab.User32]::SetForegroundWindow($Handle)
    Start-Sleep -Milliseconds 250
    if ([MgsCoopLab.User32]::GetForegroundWindow() -ne $Handle) { return $false }
    $down = [MgsCoopLab.User32]::Key($ScanCode, $Extended.IsPresent, $false)
    Start-Sleep -Milliseconds $HoldMs
    $up = [MgsCoopLab.User32]::Key($ScanCode, $Extended.IsPresent, $true)
    return ($down -eq 1 -and $up -eq 1)
}

function Test-BitmapMostlyBlack {
    # Samples a grid; true when every sample is (near) black - PrintWindow on a
    # D3D swap chain can return an empty image.
    param([Parameter(Mandatory)]$Bitmap)
    $steps = 12
    for ($i = 1; $i -lt $steps; $i++) {
        for ($j = 1; $j -lt $steps; $j++) {
            $c = $Bitmap.GetPixel([int]($Bitmap.Width * $i / $steps), [int]($Bitmap.Height * $j / $steps))
            if (($c.R + $c.G + $c.B) -gt 24) { return $false }
        }
    }
    return $true
}

function Save-WindowCapture {
    # PrintWindow(PW_RENDERFULLCONTENT) into a PNG; falls back to a screen copy of
    # the window rectangle when PrintWindow fails or yields a black image.
    param([Parameter(Mandatory)][IntPtr]$Handle, [Parameter(Mandatory)][string]$Path)
    Initialize-LabWin32
    Add-Type -AssemblyName System.Drawing
    $rect = Get-WindowRectangle -Handle $Handle
    if (!$rect -or $rect.Width -le 0 -or $rect.Height -le 0) { return [pscustomobject]@{ Path = $null; Method = 'none'; Reason = 'no_window_rect' } }
    $method = 'printwindow'
    $bitmap = [Drawing.Bitmap]::new($rect.Width, $rect.Height)
    try {
        $graphics = [Drawing.Graphics]::FromImage($bitmap)
        $hdc = $graphics.GetHdc()
        $ok = $false
        try { $ok = [MgsCoopLab.User32]::PrintWindow($Handle, $hdc, 2) } finally { $graphics.ReleaseHdc($hdc); $graphics.Dispose() }
        if (!$ok -or (Test-BitmapMostlyBlack $bitmap)) {
            $method = 'copyfromscreen'
            $graphics = [Drawing.Graphics]::FromImage($bitmap)
            try { $graphics.CopyFromScreen($rect.X, $rect.Y, 0, 0, [Drawing.Size]::new($rect.Width, $rect.Height)) } finally { $graphics.Dispose() }
        }
        $parent = Split-Path -Parent $Path
        if (!(Test-Path -LiteralPath $parent)) { $null = New-Item -ItemType Directory -Path $parent -Force }
        $bitmap.Save($Path, [Drawing.Imaging.ImageFormat]::Png)
    } finally { $bitmap.Dispose() }
    return [pscustomobject]@{ Path = $Path; Method = $method; Reason = '' }
}

Export-ModuleMember -Function *-*
