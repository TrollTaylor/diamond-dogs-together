# Shared helpers for the single-PC co-op lab (tools/lab/*.ps1).
# Pure helpers (no side effects) are unit tested by tests/lab_scripts_tests.ps1.
# The friend-test package (tools/friend) also ships this module and runs it
# under Windows PowerShell 5.1: keep the identity, save backup/seed, manifest,
# ini and process helpers 5.1-compatible (tests/friend_package_tests.ps1 runs
# them under powershell.exe) and keep this file ASCII-only.
# Nothing in this module launches the game, Steam or fuse by itself, and no
# helper writes below Steam\userdata (the real saves are only ever read).
Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

$script:SteamId64Base = [UInt64]76561197960265728
$script:Utf8NoBom = [Text.UTF8Encoding]::new($false)
$script:LabIniHeader = '# Generated by tools/lab/Prepare-LabInstance.ps1'
$script:LabCharacters = @('default', 'snake', 'dd_male', 'dd_female', 'avatar', 'ocelot', 'quiet')

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

function Get-LabRepoRoot {
    (Resolve-Path -LiteralPath (Join-Path $PSScriptRoot '../..')).Path
}

function Resolve-LabPath {
    # Absolute paths are kept; relative paths resolve against the repository root.
    param([Parameter(Mandatory)][string]$Path, [Parameter(Mandatory)][string]$RepoRoot)
    if ([IO.Path]::IsPathRooted($Path)) { return [IO.Path]::GetFullPath($Path).TrimEnd('\', '/') }
    return [IO.Path]::GetFullPath((Join-Path $RepoRoot $Path)).TrimEnd('\', '/')
}

function Get-ConfigValue {
    # StrictMode-safe optional property read with a default.
    param($Object, [Parameter(Mandatory)][string]$Name, $Default = $null)
    if ($null -eq $Object) { return $Default }
    if ($Object -is [Collections.IDictionary]) { if ($Object.Contains($Name)) { return $Object[$Name] } else { return $Default } }
    $property = $Object.PSObject.Properties[$Name]
    if ($property -and $null -ne $property.Value) { return $property.Value }
    return $Default
}

function Get-LabConfig {
    # Loads lab.json and returns it with every path resolved to an absolute path.
    param([string]$ConfigPath = (Join-Path $PSScriptRoot 'lab.json'), [string]$RepoRoot)
    if (!$RepoRoot) { $RepoRoot = Get-LabRepoRoot }
    $raw = Get-Content -LiteralPath $ConfigPath -Raw -Encoding UTF8 | ConvertFrom-Json
    if ((Get-ConfigValue $raw 'schema' 0) -ne 1) { throw "Unsupported lab.json schema in $ConfigPath" }
    $paths = [ordered]@{ repo = $RepoRoot }
    foreach ($name in 'hostDir', 'guestDir', 'fuseSource', 'fuseExe', 'runDir', 'loader', 'runtimeArchive') {
        $value = Get-ConfigValue $raw.paths $name
        if (!$value) { throw "lab.json paths.$name is missing" }
        $paths[$name] = Resolve-LabPath -Path $value -RepoRoot $RepoRoot
    }
    # Optional: Steam root (default: HKCU\Software\Valve\Steam SteamPath). Fixture tests set it.
    $steamRoot = Get-ConfigValue $raw.paths 'steamRoot' $null
    $paths['steamRoot'] = if ($steamRoot) { Resolve-LabPath -Path $steamRoot -RepoRoot $RepoRoot } else { $null }
    foreach ($port in 'fuse', 'host', 'guest') {
        $value = [int](Get-ConfigValue $raw.ports $port 0)
        if ($value -lt 1024 -or $value -gt 65535) { throw "lab.json ports.$port must be 1024..65535" }
    }
    # Optional offline lab mode settings (docs/offline-partner-spike-plan.md 2.5, 4).
    $udp = @([int]$raw.ports.host, [int]$raw.ports.guest)
    foreach ($port in 'netHost', 'netGuest') {
        $value = Get-ConfigValue $raw.ports $port $null
        if ($null -eq $value) { continue }
        if ([int]$value -lt 1024 -or [int]$value -gt 65535) { throw "lab.json ports.$port must be 1024..65535" }
        if ($udp -contains [int]$value) { throw "lab.json ports.$port collides with another lab UDP port" }
        $udp += [int]$value
    }
    $offline = Get-ConfigValue $raw 'offline' $null
    if ($offline) {
        $masterPort = [int](Get-ConfigValue $offline 'masterPort' 47899)
        if ($masterPort -lt 1024 -or $masterPort -gt 65535) { throw 'lab.json offline.masterPort must be 1024..65535' }
        if ($masterPort -eq [int]$raw.ports.fuse) { throw 'lab.json offline.masterPort must differ from ports.fuse (it must stay a closed port)' }
        if ([string](Get-ConfigValue $offline 'marker' 'offline-v1') -cnotin @('offline-v1', 'host-v1')) { throw 'lab.json offline.marker must be offline-v1 (or the host-v1 fallback)' }
        $offlineCharacters = Get-ConfigValue $offline 'characters' $null
        foreach ($role in 'host', 'guest') {
            $character = [string](Get-ConfigValue $offlineCharacters $role 'default')
            if ($character -cnotin $script:LabCharacters) { throw "lab.json offline.characters.$role must be one of: $($script:LabCharacters -join ', ')" }
        }
    }
    $partner = Get-ConfigValue $raw 'partner' $null
    if ($partner) {
        $values = ConvertFrom-LabPartnerJson -Partner $partner
        foreach ($key in $values.Keys) { $null = ConvertTo-LabPartnerValue -Key $key -Value $values[$key] }
    }
    [pscustomobject]@{
        Path       = (Resolve-Path -LiteralPath $ConfigPath).Path
        Paths      = [pscustomobject]$paths
        Hashes     = $raw.hashes
        Ports      = $raw.ports
        Identity   = $raw.identity
        Characters = $raw.characters
        XInput     = $raw.xinput
        Saves      = $raw.saves
        Window     = $raw.window
        Smoke      = Get-ConfigValue $raw 'smoke' ([pscustomobject]@{})
        Fuse       = Get-ConfigValue $raw 'fuse' ([pscustomobject]@{})
        Graphics   = Get-ConfigValue $raw 'graphics' ([pscustomobject]@{})
        Offline    = $offline
        Partner    = $partner
    }
}

function Get-ProjectVersion {
    param([Parameter(Mandatory)][string]$RepoRoot)
    $text = Get-Content -LiteralPath (Join-Path $RepoRoot 'CMakeLists.txt') -Raw
    if ($text -notmatch 'project\(mgs_coop VERSION ([0-9]+\.[0-9]+\.[0-9]+)') { throw 'Project version not found in CMakeLists.txt' }
    return $Matches[1]
}

function Get-InstancePaths {
    # Folder layout of one instance (docs/lab-protocol.md).
    param([Parameter(Mandatory)][string]$GameDirectory)
    $root = [IO.Path]::GetFullPath($GameDirectory).TrimEnd('\', '/')
    $mod = Join-Path $root 'mgs-coop'
    [pscustomobject]@{
        Game      = $root
        Exe       = Join-Path $root 'mgsvtpp.exe'
        SteamApi  = Join-Path $root 'steam_api64.dll'
        Loader    = Join-Path $root 'dinput8.dll'
        Mod       = $mod
        Record    = Join-Path $mod 'probe-install.json'
        Archive   = Join-Path $mod 'mgs-coop-player-runtime.dat'
        Marker    = Join-Path $mod 'script-observe.enabled'
        ClientHost = Join-Path $mod 'client-host.txt'
        LabIni    = Join-Path $mod 'lab.ini'
        CoopIni   = Join-Path $mod 'coop.ini'
        Status    = Join-Path $mod 'lab-status.json'
        HostId    = Join-Path $mod 'host-steamid.txt'
        JoinTrigger  = Join-Path $mod 'join.trigger'
        ResetTrigger = Join-Path $mod 'reset.trigger'
        PartnerTrigger = Join-Path $mod 'partner.trigger'
        SaveDir   = Join-Path $mod 'lab\saves'
    }
}

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------

function ConvertTo-SteamId64 {
    # Individual public-universe SteamID64 for a 32-bit account id.
    param([Parameter(Mandatory)][UInt64]$AccountId)
    if ($AccountId -eq 0 -or $AccountId -gt [UInt64]4294967295) { throw "Invalid Steam account id: $AccountId" }
    return [string]($script:SteamId64Base + $AccountId)
}

function Test-IndividualSteamId64 {
    param([AllowNull()][AllowEmptyString()][string]$Value)
    if ($null -eq $Value -or $Value -cnotmatch '^[0-9]{17}$') { return $false }
    [UInt64]$id = 0
    if (![UInt64]::TryParse($Value, [ref]$id)) { return $false }
    return (($id -shr 32) -eq 0x01100001) -and (($id % [UInt64]4294967296) -ne 0)
}

function Resolve-SteamAccount {
    # Chooses the Steam account whose saves seed the lab and whose SteamID the host uses.
    #  - a nonzero registry ActiveUser (Steam running and logged in) wins;
    #  - otherwise exactly one userdata account with MGSV saves; none or several = refuse.
    # Candidates: objects with Account (UInt32) and LastWriteUtc (DateTime).
    param([UInt32]$ActiveUser = 0, [object[]]$Candidates = @())
    if ($ActiveUser -ne 0) { return [UInt32]$ActiveUser }
    $list = @($Candidates | Where-Object { $_ -and $_.Account -ne 0 } | Sort-Object LastWriteUtc -Descending)
    if ($list.Count -eq 1) { return [UInt32]$list[0].Account }
    if ($list.Count -eq 0) { throw 'No Steam account with MGSV saves found (Steam ActiveUser is 0 and userdata has no 287700/local). Start Steam or pass -HostSteamId.' }
    throw ('Ambiguous Steam account (Steam is not running and ' + $list.Count + ' userdata accounts have MGSV saves). Start Steam and log in, or pass -HostSteamId.')
}

function Get-SteamInstallPath {
    $key = Get-ItemProperty -LiteralPath 'HKCU:\Software\Valve\Steam' -ErrorAction SilentlyContinue
    if (!$key -or !($key.PSObject.Properties.Name -contains 'SteamPath') -or !$key.SteamPath) { throw 'Steam path not found in HKCU:\Software\Valve\Steam (SteamPath).' }
    return [IO.Path]::GetFullPath($key.SteamPath).TrimEnd('\', '/')
}

function ConvertFrom-RegistryDword {
    # Pure: Get-ItemProperty returns REG_DWORD as Int32, negative from 2^31 up
    # ([UInt32] of a negative Int32 throws). Returns the unsigned 32-bit value.
    param([Parameter(Mandatory)][AllowNull()]$Value)
    if ($null -eq $Value) { return [UInt32]0 }
    if ($Value -is [int]) { return [BitConverter]::ToUInt32([BitConverter]::GetBytes([int]$Value), 0) }
    $wide = [Int64]$Value
    if ($wide -lt 0 -or $wide -gt [Int64][UInt32]::MaxValue) { throw "Not a 32-bit registry value: $Value" }
    return [UInt32]$wide
}

function Get-SteamActiveUser {
    $key = Get-ItemProperty -LiteralPath 'HKCU:\Software\Valve\Steam\ActiveProcess' -ErrorAction SilentlyContinue
    if (!$key -or !($key.PSObject.Properties.Name -contains 'ActiveUser')) { return [UInt32]0 }
    return ConvertFrom-RegistryDword $key.ActiveUser
}

function Get-SteamSaveCandidates {
    param([Parameter(Mandatory)][string]$SteamPath)
    $userdata = Join-Path $SteamPath 'userdata'
    if (!(Test-Path -LiteralPath $userdata -PathType Container)) { return @() }
    $rows = foreach ($dir in Get-ChildItem -LiteralPath $userdata -Directory) {
        if ($dir.Name -cnotmatch '^[0-9]{1,10}$') { continue }
        $local = Join-Path $dir.FullName '287700/local'
        if (!(Test-Path -LiteralPath $local -PathType Container)) { continue }
        [pscustomobject]@{ Account = [UInt32]$dir.Name; LastWriteUtc = (Get-Item -LiteralPath $local).LastWriteTimeUtc }
    }
    return @($rows)
}

function Get-HostIdentity {
    # Returns the host's real Steam account, SteamID64 and userdata folder.
    # The SteamID64 is written only to local lab files, never to run logs.
    param([string]$OverrideSteamId, [string]$SteamPath)
    $steam = if ($SteamPath) { [IO.Path]::GetFullPath($SteamPath).TrimEnd([char]92, [char]47) } else { Get-SteamInstallPath }
    $source = 'registry_active_user'
    if ($OverrideSteamId -and $OverrideSteamId -ne 'auto') {
        if (!(Test-IndividualSteamId64 $OverrideSteamId)) { throw 'HostSteamId must be a 17-digit individual SteamID64.' }
        $account = [UInt32]([UInt64]$OverrideSteamId - $script:SteamId64Base)
        $source = 'parameter'
    } else {
        $active = if ($SteamPath) { [UInt32]0 } else { Get-SteamActiveUser }
        if ($active -eq 0) { $source = 'single_userdata_account' }
        $account = Resolve-SteamAccount -ActiveUser $active -Candidates (Get-SteamSaveCandidates -SteamPath $steam)
    }
    [pscustomobject]@{
        Account   = $account
        SteamId64 = ConvertTo-SteamId64 -AccountId $account
        SteamPath = $steam
        UserData  = Join-Path $steam ('userdata/' + $account)
        Source    = $source
    }
}

