function Get-PlayPartnerDefaults {
    # The partner keys of Play-OfflineCoop.ps1's default dm=map lab.ini (the
    # lab defaults + lab.json "partner" + its dm=map settings), frozen here as
    # a literal, without net / the net ports, partner_interp or impairment keys.
    # tests/lab_scripts_tests.ps1 compares it with Play-OfflineCoop's effective keys.
    return [ordered]@{
        partner = '1'; partner_stage = '3'; partner_source = 'net'; partner_apply = 'xform'; partner_anim = 'off'
        partner_aset = 'qs'; partner_reset = 'n'; partner_look = 'net'; partner_rate_hz = '30'; partner_interp_ms = '100'
        partner_offset_cm = '300'; partner_teardown = 'clear'; partner_force_exists = '0'; partner_policy_relax = '0'
        partner_anim_probe = '0'; partner_dm = 'map'; crash_probe = '1'
    }
}

function Test-CoopPlayGeneratedText {
    # True when an ini file starts with the Play-Coop header.
    param([AllowNull()][AllowEmptyString()][string]$Text)
    return [bool]$Text -and $Text.StartsWith($script:CoopPlayHeader, [StringComparison]::Ordinal)
}

function Get-CoopPlayHeader { return $script:CoopPlayHeader }

function New-CoopPlayLabIniText {
    # lab.ini of the two-PC play mode (spec 9.2 step 4). UTF-8 text with LF;
    # never the lab identity keys or an impairment key.
    param(
        [Parameter(Mandatory)][ValidateSet('host', 'guest')][string]$Role,
        [Parameter(Mandatory)][string]$SaveDir,
        [int]$Port = 47830,
        # Guest only: the host's dotted IPv4 (the launcher resolves names).
        [string]$PeerAddress = '',
        # World sync level (docs/world-sync-protocol.md; experimental): 0 writes
        # nothing (today's behaviour), 1..3 add world=N after the partner keys.
        [ValidateRange(0, 3)][int]$World = 0
    )
    if ($SaveDir -cnotmatch '^[A-Za-z]:\\' -and !$SaveDir.StartsWith('\\')) { throw "save_dir must be an absolute path: $SaveDir" }
    if ($SaveDir -match '[\x00-\x1f\x7f]' -or $SaveDir -ne $SaveDir.Trim() -or $script:CoopUtf8NoBom.GetByteCount($SaveDir) -gt 259) { throw "Invalid save_dir: $SaveDir" }
    if ($Port -lt 1024 -or $Port -gt 65535) { throw "Invalid port: $Port" }
    if ($Role -eq 'host' -and $PeerAddress) { throw 'The host has no peer address.' }
    if ($Role -eq 'guest' -and !(Test-CoopPlayPeerAddress $PeerAddress)) { throw "Invalid host address: $PeerAddress" }
    $lines = New-Object Collections.Generic.List[string]
    $lines.Add($script:CoopPlayHeader)
    $lines.Add('enabled=1')
    $lines.Add('mode=play')
    $lines.Add('role=' + $Role)
    $lines.Add('save_dir=' + $SaveDir)
    $lines.Add('net=1')
    $lines.Add('net_bind=any')
    if ($Role -eq 'host') {
        $lines.Add('net_listen_port=' + $Port)
    } else {
        $lines.Add('net_listen_port=0')
        $lines.Add('net_peer_addr=' + $PeerAddress)
        $lines.Add('net_peer_port=' + $Port)
    }
    $lines.Add('partner_interp=auto')
    $defaults = Get-PlayPartnerDefaults
    foreach ($key in $defaults.Keys) { $lines.Add($key + '=' + $defaults[$key]) }
    # Never world_probe: the probes are lab-only (native refuses them in play).
    if ($World -gt 0) { $lines.Add('world=' + $World) }
    return ($lines.ToArray() -join "`n") + "`n"
}

function New-CoopPlayCoopIniText {
    # coop.ini of the play mode: the closed-port master URL (offline, no server)
    # and the player's character.
    param([Parameter(Mandatory)][string]$Character, [string]$CharacterFallback = 'dd_male')
    if ($script:CoopCharacters -cnotcontains $Character) { throw "Invalid character: $Character" }
    if ($script:CoopFallbacks -cnotcontains $CharacterFallback) { throw "Invalid character_fallback: $CharacterFallback" }
    return (@($script:CoopPlayHeader, ('master_url=' + $script:CoopMasterUrl), ('character=' + $Character),
            ('character_fallback=' + $CharacterFallback)) -join "`n") + "`n"
}

function Get-CoopTextSha256 {
    # Pure: SHA-256 (upper-case hex, like Get-FileHash) of $Bytes.
    param([Parameter(Mandatory)][byte[]]$Bytes)
    $sha = [Security.Cryptography.SHA256]::Create()
    try { $d = $sha.ComputeHash($Bytes) } finally { $sha.Dispose() }
    return ([BitConverter]::ToString($d)).Replace('-', '')
}

# ---------------------------------------------------------------------------
# link-status.json, logs and launch evidence
# ---------------------------------------------------------------------------

function ConvertFrom-CoopStatusText {
    # Pure: link-status.json text (spec 7.2) -> object, or $null when it is not
    # a v1 status or (with $ExpectedPid) was written by another process.
    param([AllowNull()][AllowEmptyString()][string]$Text, [int]$ExpectedPid = 0)
    if (!$Text) { return $null }
    try { $status = $Text | ConvertFrom-Json } catch { return $null }
    if (!$status) { return $null }
    $names = @($status.PSObject.Properties.Name)
    if ($names -notcontains 'v' -or [int]$status.v -ne 1 -or $names -notcontains 'state') { return $null }
    if ($ExpectedPid -and ($names -notcontains 'pid' -or [int]$status.pid -ne $ExpectedPid)) { return $null }
    return $status
}

function Read-CoopStatusFile {
    # link-status.json opened with FileShare ReadWrite|Delete, so the game's
    # atomic replace (MoveFileExW) never fails because of this reader.
    param([Parameter(Mandatory)][string]$Path, [int]$ExpectedPid = 0)
    return ConvertFrom-CoopStatusText -Text (Read-SharedText -Path $Path) -ExpectedPid $ExpectedPid
}

function Read-CoopLogDelta {
    # Complete lines appended to $Path since $Offset (a length recorded before
    # the launch), so an append-only log from an earlier session never counts.
    param([Parameter(Mandatory)][string]$Path, [Int64]$Offset = 0)
    $r = Read-LogFromOffset -Path $Path -Offset $Offset
    return [pscustomobject]@{ Text = [string]$r.Text; NewOffset = [Int64]$r.NewOffset }
}

function Get-CoopLaunchEvidence {
    # Pure: what the new bytes of the three logs prove about a Play-Coop launch
    # (spec 9.2 step 5). State:
    #   ok          all four pieces of evidence are present;
    #   pending     something is missing and the deadline has not passed;
    #   unsafe      the saves are NOT redirected (play=refused, saves=unchanged,
    #               a different dir, or no saves= line at the deadline);
    #   old_loader  saves redirected but no play= line at the deadline;
    #   incomplete  anything else missing at the deadline.
    param(
        [AllowNull()][AllowEmptyString()][string]$EarlyLog = '',
        [AllowNull()][AllowEmptyString()][string]$SteamLog = '',
        [AllowNull()][AllowEmptyString()][string]$ObserverLog = '',
        [Parameter(Mandatory)][string]$SaveDir,
        [string]$MasterUrl = $script:CoopMasterUrl,
        # The 90 s deadline has passed.
        [switch]$Final
    )
    if (!$EarlyLog) { $EarlyLog = '' }
    if (!$SteamLog) { $SteamLog = '' }
    if (!$ObserverLog) { $ObserverLog = '' }
    $missing = New-Object Collections.Generic.List[string]
    $problems = New-Object Collections.Generic.List[string]
    $unsafe = $false
    $wantDir = ConvertTo-LabComparablePath $SaveDir
    $saves = 'missing'
    foreach ($m in [regex]::Matches($EarlyLog, '(?m)^saves=(redirected|unchanged)(?=[ ;\r\n]|$)[^\r\n]*')) {
        if ($m.Groups[1].Value -eq 'unchanged') { $saves = 'unchanged'; break }
        $dir = [regex]::Match($m.Value, '; dir=(.*)$')
        if ($dir.Success -and (ConvertTo-LabComparablePath $dir.Groups[1].Value.TrimEnd("`r")) -ceq $wantDir) { $saves = 'ok' } else { $saves = 'wrong_dir'; break }
    }
    if ($saves -eq 'unchanged') { $unsafe = $true; $problems.Add('early.log shows saves=unchanged: the save copy is NOT in use.') }
    elseif ($saves -eq 'wrong_dir') { $unsafe = $true; $problems.Add('early.log shows the saves redirected to a different folder.') }
    elseif ($saves -eq 'missing') { $missing.Add('early.log saves=redirected; dir=<coop-saves>') }
    $play = 'missing'
    $playLine = [regex]::Match($EarlyLog, '(?m)^play=1;[^\r\n]*')
    if ($playLine.Success) {
        $refused = [regex]::Match($playLine.Value, '; refused=(0x[0-9A-Fa-f]+)')
        $redirected = [regex]::IsMatch($playLine.Value, '; saves=redirected(?=[ ;\r]|$)')
        if ($refused.Success -and $refused.Groups[1].Value -ieq '0x0' -and $redirected) { $play = 'ok' }
        else {
            $play = 'bad'
            if (!$redirected) { $unsafe = $true; $problems.Add('early.log play line: saves=unchanged.') }
            if ($refused.Success -and $refused.Groups[1].Value -ine '0x0') { $problems.Add('early.log play line: the loader refused settings (refused=' + $refused.Groups[1].Value + ').') }
        }
    } else { $missing.Add('early.log play=1 (refused=0x0, saves=redirected)') }
    $master = 'missing'
    foreach ($m in [regex]::Matches($SteamLog, '(?m)^master_server=(redirected|refused|failed)(?=[ ;\r\n]|$)[^\r\n]*')) {
        if ($m.Groups[1].Value -ne 'redirected') {
            if ($m.Value -cmatch '; reason=already_redirected(?=[ ;]|$)') { continue }
            $master = 'bad'; $problems.Add('steam-observer.log: master_server=' + $m.Groups[1].Value + '.'); break
        }
        $url = [regex]::Match($m.Value, '[ ;]url=(\S+)')
        if ($url.Success -and $url.Groups[1].Value -ceq $MasterUrl) { $master = 'ok' } else { $master = 'bad'; $problems.Add('steam-observer.log: master_server redirected to another URL.'); break }
    }
    if ($master -eq 'missing') { $missing.Add('steam-observer.log master_server=redirected (closed local port)') }
    $refusedPlay = [regex]::IsMatch($ObserverLog, '(?m)^play=refused; reason=saves_not_redirected')
    if ($refusedPlay) { $unsafe = $true; $problems.Add('script-observer.log: play=refused; reason=saves_not_redirected.') }
    $active = [regex]::IsMatch($ObserverLog, '(?m)^play=active(?=[ ;\r\n]|$)')
    if (!$active -and !$refusedPlay) { $missing.Add('script-observer.log play=active') }
    $state = 'pending'
    if ($unsafe) { $state = 'unsafe' }
    elseif ($saves -eq 'ok' -and $play -eq 'ok' -and $master -eq 'ok' -and $active) { $state = 'ok' }
    elseif ($Final) {
        if ($saves -ne 'ok') { $state = 'unsafe' }
        elseif ($play -eq 'missing') { $state = 'old_loader' }
        else { $state = 'incomplete' }
    } elseif ($play -eq 'bad' -or $master -eq 'bad') { $state = 'incomplete' }
    return [pscustomobject]@{ State = $state; Missing = $missing.ToArray(); Problems = $problems.ToArray(); Saves = $saves; Play = $play; Master = $master; Active = $active }
}

function Get-CoopLinkReasonText {
    # Pure: a sentence for a link-status.json reason (spec 3.6, 7.1).
    param([AllowNull()][AllowEmptyString()][string]$Reason, [string]$RemoteBuild = '', [string]$OwnBuild = '', [int]$Verified = 1)
    $remote = $RemoteBuild
    if (!$remote) { $remote = 'another version' }
    switch -Regex ([string]$Reason) {
        '^$' { return '' }
        '^build_mismatch$' { return "Your friend runs mgs-coop $remote; you run $OwnBuild. Both must install the same package." }
        '^proto_mismatch$' { return "Your friend's mgs-coop ($remote) speaks another link version. Both must install the same package." }
        '^mode_mismatch$' { return 'One side is in the single-PC lab mode. Both players must start the game with Play-Coop.bat.' }
        '^role_mismatch$' { return 'Both players chose the same role: one must Host, the other Join.' }
        '^busy$' { return 'The host is already connected to someone.' }
        '^bad_code$' { return 'The host did not accept the connection. Possibly a wrong code: copy it again (or the host restarted Play-Coop: ask for the new code).' }
        '^secret_' { return 'The link secret file is missing or damaged. Quit MGSV and start Play-Coop again.' }
        '^crypto$' { return 'Windows could not provide random numbers for the link. Restart the PC and try again.' }
        '^no_peer_addr$' { return 'The host address is missing. Quit MGSV and run Join again.' }
        '^transport_bind$' { return 'The UDP port is already in use by another program on this PC (or a second MGSV). Close it, or use another port.' }
        '^transport_' { return "The network link could not start ($Reason). Restart the PC and try again; if it repeats, run Collect-Logs.bat." }
        default {
            if ($Verified -eq 0) { return "The connection was refused ($Reason). Possibly a wrong code." }
            return "The connection was refused ($Reason)."
        }
    }
}

function Get-CoopValue {
    # StrictMode-safe optional property read.
    param($Object, [Parameter(Mandatory)][string]$Name, $Default = $null)
    if ($null -eq $Object) { return $Default }
    $p = $Object.PSObject.Properties[$Name]
    if ($p -and $null -ne $p.Value) { return $p.Value }
    return $Default
}

function Format-CoopStatusLine {
    # Pure: the launcher's one-line status from link-status.json (spec 9.2 step 5),
    # for example "[HOST] link=connected rtt=42ms jitter=3ms loss=0.4% interp=80ms | partner=live shown look | mission 30050".
    param([AllowNull()]$Status, [Parameter(Mandatory)][ValidateSet('host', 'guest')][string]$Role, [DateTime]$NowUtc = [DateTime]::UtcNow, [string]$OwnBuild = '')
    $tag = '[JOIN]'
    if ($Role -eq 'host') { $tag = '[HOST]' }
    if ($null -eq $Status) { return "$tag waiting for the game's link status..." }
    $state = [string](Get-CoopValue $Status 'state' 'off')
    $time = [DateTime]::MinValue
    $timeText = [string](Get-CoopValue $Status 'time_utc' '')
    $styles = [Globalization.DateTimeStyles]::AdjustToUniversal -bor [Globalization.DateTimeStyles]::AssumeUniversal
    # A disabled link is written once (no receive thread runs): its age means nothing.
    if ($state -ne 'disabled' -and $timeText -and [DateTime]::TryParse($timeText, [Globalization.CultureInfo]::InvariantCulture, $styles, [ref]$time)) {
        $age = ($NowUtc - $time).TotalSeconds
        if ($age -gt 15) { return "$tag game not responding (no status for $([int]$age) s)" }
    }
    $text = "$tag link=$state"
    if ($state -in @('connected', 'reconnecting', 'lost')) {
        $lp = [int](Get-CoopValue $Status 'loss_permille' 0)
        $text += (' rtt={0}ms jitter={1}ms loss={2}.{3}% interp={4}ms' -f [int](Get-CoopValue $Status 'rtt_ms' 0), [int](Get-CoopValue $Status 'jitter_ms' 0),
            [int][Math]::Floor($lp / 10), ($lp % 10), [int](Get-CoopValue $Status 'interp_ms' 0))
    }
    $reason = [string](Get-CoopValue $Status 'reason' '')
    if ($reason) {
        $text += ' (' + $reason + ': ' + (Get-CoopLinkReasonText -Reason $reason -RemoteBuild ([string](Get-CoopValue $Status 'remote_build' '')) -OwnBuild $OwnBuild -Verified ([int](Get-CoopValue $Status 'verified' 1))) + ')'
    }
    $partner = 'partner=' + [string](Get-CoopValue $Status 'partner' 'none')
    if ([int](Get-CoopValue $Status 'partner_shown' 0)) { $partner += ' shown' }
    if ([int](Get-CoopValue $Status 'look' 0)) { $partner += ' look' }
    $mission = [UInt32](Get-CoopValue $Status 'mission' 0)
    $missionText = 'mission ' + $mission
    if ($mission -notin $script:CoopPartnerMissions) { $missionText += ' - Partner body unavailable in this mission; use Mother Base or free roam.' }
    return "$text | $partner | $missionText"
}

# ---------------------------------------------------------------------------
# Partner details from script-observer.log (shared with Play-OfflineCoop.ps1)
# ---------------------------------------------------------------------------

function New-CoopPartnerDetails {
    return [pscustomobject]@{
        Mission = $false; Ready = $false; Refused = ''; Shown = $false; Loaded = $false
        Link = 'none'; Rx = 0; Age = 0; Crash = 0; Exited = $false
        Look = ''; Move = ''; Stance = ''; Character = ''; Fault = $false; Mode = ''
        Input = 'off'; InputArmed = $false; InputPerS = 0; InputStale = $false; InputFault = ''
        Recon = ''; ReconErr = 0; Snaps = 0; Places = 0; Runaway = $false; Frozen = ''; Body = ''; InputPin = $false; Fixes = 0
        Dm = ''
    }
}

function Get-CoopLookName([string]$Type) {
    switch ($Type) { '0' { 'Snake' } '1' { 'DD male' } '2' { 'DD female' } '3' { 'Avatar' } '5' { 'Ocelot' } '6' { 'Quiet' } default { "type $Type" } }
}

function Update-CoopPartnerDetails {
    # Applies one script-observer.log line to a New-CoopPartnerDetails object.
    param([Parameter(Mandatory)]$Details, [AllowEmptyString()][string]$Line)
    $s = $Details
    $line = $Line.TrimEnd("`r")
    if ($line -match 'allocation_enter.*mission=(30010|30020|30050)(\D|$)') { $s.Mission = $true }
    elseif ($line -match '^partner_cfg=ready') { $s.Ready = $true; $s.Refused = '' }
    elseif ($line -match '^partner_cfg=refused; reason=([^;\s]+)') { $s.Refused = $Matches[1] }
    elseif ($line -match '^partner_realized=1') { $s.Shown = $true }
    elseif ($line -match '^partner_realized=0') { $s.Shown = $false; $s.Loaded = $false }
    elseif ($line -match '^partner_parts=loaded') { $s.Loaded = $true }
    elseif ($line -match '^partner_net=stats;.*rx=(\d+);.*status=([a-z]+); last_age_ms=(\d+)') {
        $s.Rx = [int64]$Matches[1]; $s.Link = $Matches[2]; $s.Age = [int]$Matches[3]
    }
    elseif ($line -match '^crash_probe=av') { $s.Crash++ }
    elseif ($line -match '^partner_look=loaded; R=1; q40=(\d+)') { $s.Look = Get-CoopLookName $Matches[1] }
    elseif ($line -match '^partner_look=(timeout|refused)') { $s.Look = "look $($Matches[1])" }
    elseif ($line -match '^partner_xform=applied') { $s.Move = 'smooth' }
    elseif ($line -match '^partner_xform=refused; reason=([^;\s]+)') { $s.Move = "warp ($($Matches[1]))" }
    elseif ($line -match '^partner_stance=set; .*to=(\d)') { $s.Stance = @('', 'stand', 'crouch', 'prone')[[int]$Matches[1]] }
    elseif ($line -match '^partner_stance=summary; last=([0-3]);') { if ([int]$Matches[1]) { $s.Stance = @('', 'stand', 'crouch', 'prone')[[int]$Matches[1]] } }
    elseif ($line -match '^partner_stage=changed; .*apply=([a-z]+); anim=([a-z]+);') {
        $s.Mode = "$($Matches[1])/$($Matches[2])"
        if ($Matches[1] -notin @('xform', 'hybrid')) { $s.Move = '' }
        if ($Matches[2] -eq 'off') { $s.Stance = '' }
        # [O] stop logs stage=0 with dm=map still set: no clip then either.
        if ($line -notmatch '; dm=map;' -or $line -match '^partner_stage=changed; stage=[0-2];') { $s.Dm = '' }
        # (also the input mode: a second branch for the same line would never be reached)
        if ($line -match '; input=([a-z]+);') { $s.Input = $Matches[1]; if ($Matches[1] -eq 'off') { $s.InputArmed = $false } }
    }
    elseif ($line -match '^partner_dmmap; phase=([a-z_]+); cur=(\d+|none);') {
        # failed stays FAILED until [R]; idle (the release finished) has no clip.
        $s.Dm = if ($Matches[1] -eq 'failed') { 'FAILED' } elseif ($Matches[1] -eq 'idle') { '' } else { "$($Matches[2])/$($Matches[1])" }
    }
    elseif ($line -match '^partner_dmmap=failed') { $s.Dm = 'FAILED' }
    elseif ($line -match '^partner_dmmap=(released|abandoned);' -or $line -match '^partner_stop;') { $s.Dm = '' }
    elseif ($line -match '^partner_input=armed; mode=([a-z]+)') { $s.Input = $Matches[1]; $s.InputArmed = $true }
    elseif ($line -match '^partner_input=disarmed') { $s.InputArmed = $false }
    elseif ($line -match '^partner_input; mode=([a-z]+); windows=\d+; per_s=(\d+)') { $s.Input = $Matches[1]; $s.InputPerS = [int]$Matches[2] }
    elseif ($line -match '^partner_input=stale') { $s.InputStale = $true }
    elseif ($line -match '^partner_input=live') { $s.InputStale = $false }
    elseif ($line -match '^partner_input=fault; phase=([a-z]+)') { $s.InputFault = $Matches[1] }
    elseif ($line -match '^partner_recon; mode=([a-z]+); recon=([a-z]+); err_mm=(-?\d+);.* snaps=(\d+); places=(\d+);.* act=(\d+); s=(\d+);.* frozen=([a-z_]+);.* runaway=(\d); input_pin=(\d); fixes=(\d+)') {
        # recon= is the effective setting (correct=0 turns it off whatever recon= says).
        $s.Recon = if ($Matches[2] -eq 'off') { 'OFF' } else { $Matches[1] }
        $s.ReconErr = [int]$Matches[3]; $s.Snaps = [int]$Matches[4]; $s.Places = [int]$Matches[5]
        $s.Body = @('', 'stand', 'crouch', 'prone')[[Math]::Min(3, [int]$Matches[7])]
        $s.Frozen = if ($Matches[8] -ne 'none') { $Matches[8] } else { '' }
        $s.Runaway = $Matches[9] -eq '1'
        $s.InputPin = $Matches[10] -eq '1'
        $s.Fixes = [int]$Matches[11]
    }
    elseif ($line -match '^partner_recon=runaway;.*action=(pin|disarm)') { $s.Runaway = $true }
    elseif ($line -match '^partner_recon=runaway_end') { $s.Runaway = $false }
    elseif ($line -match '^partner_call=fault') { $s.Fault = $true }
    elseif ($line -match '^character=allocated; .*vars=(\d+)') { $s.Character = Get-CoopLookName $Matches[1] }
    elseif ($line -match 'mission_termination=entered') { $s.Mission = $false; $s.Ready = $false; $s.Shown = $false; $s.Loaded = $false }
}

function Get-CoopClipName {
    # The dm=map clip of the status line: "<gani>/<phase>" from the 5 s summary.
    param([AllowEmptyString()][string]$Dm)
    if ($Dm -eq 'FAILED') { return 'FAILED (dm=map gave up; [R] re-sends)' }
    $names = @('stand idle', 'crouch idle', 'crawl idle', 'crouch walk', 'crouch run', 'stand dash', 'crawl', 'prone idle',
        'state crouch idle', 'state stand idle', 'stand walk', 'stand run', 'stand jog')
    $parts = $Dm.Split('/')
    $name = if ($parts[0] -match '^\d+$' -and [int]$parts[0] -lt $names.Count) { $names[[int]$parts[0]] } else { $parts[0] }
    if ($parts.Count -gt 1 -and $parts[1] -ne 'playing') { return "$name ($($parts[1]))" }
    return $name
}

function Format-CoopPartnerDetails {
    # One role's part of Play-OfflineCoop's status line.
    param([Parameter(Mandatory)]$Details, [Parameter(Mandatory)][string]$Role)
    $s = $Details
    $partner = if ($s.Loaded) { 'partner visible' } elseif ($s.Shown) { 'partner loading' } elseif ($s.Ready) { 'waiting for partner' } elseif ($s.Refused) { "partner refused ($($s.Refused))" } elseif ($s.Mission) { 'loading mission' } else { 'starting' }
    $link = if ($s.Link -eq 'live') { "link live ($($s.Age) ms)" } else { "link $($s.Link)" }
    $crash = if ($s.Crash) { "  CRASH-LOG x$($s.Crash)" } else { '' }
    $exit = if ($s.Exited) { '  [game closed]' } else { '' }
    $extra = @()
    if ($s.Character) { $extra += "plays $($s.Character)" }
    if ($s.Look) { $extra += "partner looks like $($s.Look)" }
    if ($s.Mode) { $extra += "settings $($s.Mode)" }
    if ($s.Move) { $extra += "movement $($s.Move)" }
    if ($s.Stance) { $extra += "partner $($s.Stance)" }
    if ($s.Dm) { $extra += "clip $(Get-CoopClipName $s.Dm)" }
    if ($s.Input -ne 'off') {
        $armed = if ($s.InputArmed) { 'armed' } else { 'off' }
        $perS = if ($s.InputPerS) { " $($s.InputPerS)/s" } else { '' }
        $stale = if ($s.InputStale) { ' STALE' } else { '' }
        $extra += "input $($s.Input)/$armed$perS$stale"
        if ($s.Recon) {
            $recon = "recon $($s.Recon) err $([Math]::Round($s.ReconErr / 10.0)) cm"
            if ($s.Snaps) { $recon += " snaps $($s.Snaps)" }
            if ($s.Places -gt 0) { $recon += " places $($s.Places)" }
            if ($s.Runaway) { $recon += ' RUNAWAY(pinned)' }
            if ($s.InputPin) { $recon += ' INPUT-LOST(pinned)' }
            if ($s.Fixes) { $recon += " stance-fixes $($s.Fixes)" }
            if ($s.Frozen) { $recon += " frozen $($s.Frozen)" }
            if ($s.Body) { $recon += " body $($s.Body)" }
            $extra += $recon
        }
    }
    if ($s.InputFault) { $extra += "INPUT FAULT ($($s.InputFault))" }
    if ($s.Fault) { $extra += 'NATIVE CALL FAULT (Warp only)' }
    $details = if ($extra.Count) { ' [' + ($extra -join ', ') + ']' } else { '' }
    return "${Role}: $partner, $link$details$crash$exit"
}

Export-ModuleMember -Function *-*
