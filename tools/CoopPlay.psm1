# Shared helpers of the two-PC "play" mode (docs/two-pc-play.md) and of the
# tools that read an installed game folder.
#
# Imported by tools/lab/LabCommon.psm1 (PowerShell 7 lab scripts, which
# re-export these functions) and by the friend package (tools/friend/*.ps1,
# Windows PowerShell 5.1 on a friend's PC). The friend ZIP ships this module
# instead of LabCommon.psm1. Keep this file ASCII-only and 5.1-compatible: no
# ternary/null-coalescing operators, no [IO.Path]::GetRelativePath, no
# three-argument Join-Path.
#
# Contents:
#  - folder layout, Steam account, hashes, save backup/seed and process helpers
#    (moved here from LabCommon.psm1 unchanged; the friend scripts need them);
#  - the join code and link secret of the play mode (spec section 3.1);
#  - play lab.ini / coop.ini text and the frozen partner defaults;
#  - readers of link-status.json and the logs, launch evidence, status line;
#  - the partner-details reader shared with Play-OfflineCoop.ps1.
# Nothing here launches the game or Steam, contacts the network, or writes
# below Steam\userdata (the real saves are only ever read).
Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

$script:CoopUtf8NoBom = New-Object Text.UTF8Encoding $false
# Crockford base32 (spec 3.1).
$script:CoopAlphabet = '0123456789ABCDEFGHJKMNPQRSTVWXYZ'
$script:CoopPlayPort = 47830
$script:CoopMasterUrl = 'http://127.0.0.1:47899/tppstm/gate'
$script:CoopPartnerMission = 30050
$script:CoopPartnerMissions = @(30010, 30020, 30050)
# The lab secret (loopback only, spec 3.1); never valid off 127.0.0.1.
$script:CoopLabSecret = 'C00PC00PC00PC00PC00P'
$script:CoopPlayHeader = '# Generated by mgs-coop Play-Coop.ps1 (two-PC play); removed when the game exits.'
$script:CoopCharacters = @('default', 'quiet', 'dd_male', 'dd_female', 'snake', 'avatar', 'ocelot')
$script:CoopFallbacks = @('dd_male', 'dd_female', 'snake', 'avatar')

