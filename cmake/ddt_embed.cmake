# Writes a C++ header holding the bytes of one file as an array.
#   cmake -DINPUT=<file> -DOUTPUT=<header> -DSYMBOL=<name> [-DTEXT_LF=1] -P ddt_embed.cmake
# TEXT_LF=1 turns CRLF into LF first (git may check text files out with CRLF;
# the archive probe Lua is pinned with LF endings).
if(NOT INPUT OR NOT OUTPUT OR NOT SYMBOL)
  message(FATAL_ERROR "ddt_embed.cmake needs INPUT, OUTPUT and SYMBOL")
endif()
file(READ "${INPUT}" _ddt_hex HEX)
if(_ddt_hex STREQUAL "")
  message(FATAL_ERROR "ddt_embed.cmake: ${INPUT} is empty")
endif()
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _ddt_bytes "${_ddt_hex}")
if(TEXT_LF)
  # Every item starts with "0x", so this only matches whole CR LF byte pairs.
  string(REPLACE "0x0d,0x0a," "0x0a," _ddt_bytes "${_ddt_bytes}")
endif()
string(REPEAT "0x[0-9a-f][0-9a-f]," 16 _ddt_row)
string(REGEX REPLACE "(${_ddt_row})" "\\1\n    " _ddt_bytes "${_ddt_bytes}")
get_filename_component(_ddt_name "${INPUT}" NAME)
file(WRITE "${OUTPUT}.tmp"
  "// Generated by cmake/ddt_embed.cmake from ${_ddt_name}. Do not edit.\n"
  "#pragma once\n"
  "namespace ddt::assets {\n"
  "inline constexpr unsigned char ${SYMBOL}[] = {\n"
  "    ${_ddt_bytes}\n"
  "};\n"
  "}  // namespace ddt::assets\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUTPUT}.tmp" "${OUTPUT}")
file(REMOVE "${OUTPUT}.tmp")
