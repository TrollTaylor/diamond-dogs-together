  "meaning": {
    "service": "Common NewChara PassengerInfo service independently present in TPP and MGO; primary/interface layouts and code independently fingerprinted per executable.",
    "keys": "DX vehicle/group GameObjectId, R8W rider/actor GameObjectId, R9 byte in/out reservation slot. Confirmed TPP caller EAF4A0 gets vehicle word from incoming argument and reconstructs actor word from its own module kind168 and actor index; matching EB0360 removes the same tuple.",
    "capacity_correction": "TPP FB38E0 saves R8W at entry rsp18 and DX at entry rsp10; after push rdi, load rsp18 at FB3A44 reads saved DX. Capacity is selected by vehicle/group kind DX>>9, not actor kind.",
    "capacity": "Group kind0x32 gets five reservation entries; kind0x2D gets one; every other kind defaults one, max five. TPP type0x32 road vehicle independently matches existing vehicle reader accepted ID mask6400. Do not label kind0x2D horse solely from this classifier.",
    "records": "Group stride22 hex, group key word0, capacity byte20; five possible inner records begin2 stride6: actor word0, state byte2, slot byte3, flags byte4. State1 is reservation bookkeeping; do not equate it with physical occupancy or body attachment.",
    "add": "Search existing vehicle group, return existing actor slot OR flag bits1/2/4; otherwise reserve requested slot or request4(any free). New group reserves slot0. Refuses absent/free-group or absent/free-slot.",
    "remove": "Match vehicle group and actor key; reset matched actorFFFF/state0, clear flags low five bits, slot=capacity; if no actors remain reset group keyFFFF/capacity0.",
    "separate_physical_system": "TPP VehicleSystem A29530 independently checks physical vehicle riderword30+2*seat==FFFF under its own critical section and writes actual actor. PassengerInfo reservation is separate and does not authorize calling that setter."
  },
  "limits": [
    "No MGO process or multiplayer game was launched or observed; mechanics are static candidates only.",
    "No runtime calls, record writes, offline occupancy insertion, online bit override, or shared Player2 attachment is authorized by this proof.",
    "TPP NPC module caller owns an NPC index; its producer cannot be reused as an arbitrary Player2 mount call.",
    "Stock offline Player2 generic seat producer still restricts entry sides0/1 then normalizes physical driver seat0 and rejects occupied driver.",
    "Physical road passenger/controller mode2 and matching lifetime/exit remain a separate admission problem.",
    "Prologue PlayerHorse2forVr is a dedicated authored controller and sequence; this service does not make it portable."
  ],
  "next_candidate": {
    "kind": "typed_read_only_reservation_observer",
    "fields": "Current exact service identity, configured count/array, matching vehicle group and actual bodies0/1 actor keys, state/slot/flags only; reservation may not be presented as attached.",
    "scope": "Current offline supported paired scene generation and existing natural owner thread/deferred job window; no arbitrary GO scanning or guessed IDs.",
    "activation_gate": "Need native ordinary Player2 passenger request producer selecting a real free seat>=2, actual body ownership, normal controller attachment/animation/camera obligations and matching natural exit before any activation.",
    "failure_conditions": [
      "Different binary hash/site/slot",
      "Unknown or changing provider/service owner",
      "Unconfigured/null arrays or count outside exact bounded config",
      "Wrong vehicle type or stale authored vehicle owner",
      "Duplicate or out-of-bounds actor/reservation slot",
      "No fresh coherent same-generation sample",
      "Player2 natural producer still supplies driver-only range",
      "Unqualified native UI/camera exit or window-loss retirement"
    ]
  }
}
